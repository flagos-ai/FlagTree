        "orchestrator",
        "graph expert",
        "graph optimizer",
        "kernel expert",
        "kernel optimizer",
        "graph profiler",
        "kernel profiler",
        "reviewer"
      ],
      "generator": "workspace.py prepare",
      "body": {
        "schema": "flagmega.task/v1",
        "objective": null,
        "reference": null,
        "workload": null,
        "primary_metric": null,
        "direction": null,
        "acceptance": {},
        "gain_rule": null
      }
    },
