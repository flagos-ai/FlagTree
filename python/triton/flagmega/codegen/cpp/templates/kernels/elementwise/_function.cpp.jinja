#include <cmath>
{% import "entrypoints/_common.cpp.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "elementwise" and call.variant == elementwise_variant %}
static FTT_DEVICE void {{ call.symbol }}({{ entry.device_signature(call) }}) {
{{ entry.mesh_coordinates() }}
{{ entry.thread_identity() }}
{{ entry.strided_loop("local_offsets", call.local_capacity) }} {
        if (!({{ call.active | cppexpr }})) {
            continue;
        }
        const float lhs_value = ({{ call.lhs_read_active | default('True') | cppexpr }})
            ? ftt::to_float(({{ call.lhs | cppexpr }})[{{ call.lhs_offset | cppexpr }}])
            : ftt::to_float(ftt::store_as({{ call.lhs | cppexpr }}, {{ call.lhs_other | default(0.0) }}));
{% if call.variant in ("add", "mul", "div") %}
        const float rhs_value = ({{ call.rhs_read_active | default('True') | cppexpr }})
            ? ftt::to_float(({{ call.rhs | cppexpr }})[{{ call.rhs_offset | cppexpr }}])
            : ftt::to_float(ftt::store_as({{ call.rhs | cppexpr }}, {{ call.rhs_other | default(0.0) }}));
{% endif %}
{% if call.fusion_lines | default(()) %}
{% set program = call | cppfusion %}
{% for line in program.lines %}
        {{ line }}
{% endfor %}
        const float ftt_value = {{ program.value }};
{% else %}
{% if call.variant == "add" %}
        const float ftt_value = lhs_value + rhs_value;
{% elif call.variant == "mul" %}
        const float ftt_value = lhs_value * rhs_value;
{% elif call.variant == "div" %}
        const float ftt_value = lhs_value / rhs_value;
{% elif call.variant == "sigmoid" %}
        const float ftt_value = ftt::sigmoid(lhs_value);
{% elif call.variant == "silu" %}
{% if call.math_mode | default('fast') == 'accurate' %}
        const float ftt_value = lhs_value / (1.0f + expf(-lhs_value));
{% else %}
        const float ftt_value = lhs_value * ftt::sigmoid(lhs_value);
{% endif %}
{% elif call.variant == "cast" %}
        const float ftt_value = lhs_value;
{% endif %}
{% endif %}
        auto *const ftt_result = {{ call.result | cppexpr }};
        ftt_result[{{ call.result_offset | cppexpr }}] =
            ftt::store_as(ftt_result, ftt_value);
    }
}


{% endif %}
{% endfor %}
