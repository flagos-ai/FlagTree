// flagmega-kernel: dense_matmul/packed_k_major_gemv_norm_stats platform=generic
{# Packed GEMV fused with the residual add and the next layer's RMS statistic.

   Two things carry over from the Triton form and must not be simplified:

   * The projection is rounded to its own dtype before the residual add. The
     reference implementation publishes bf16 there, and the fusion preserves
     that boundary including cancellation at ties.
   * The statistic is the sum of squares of the *stored* (rounded) value, not
     of the fp32 sum.

   The statistic is a reduction over the whole N axis, which the threads split,
   so it finishes through shared memory the way norm_stats/local does. #}
{% import "entrypoints/_common.cpp.jinja" as entry with context %}
{% if render_calls is defined %}
{% for call in render_calls %}
{% if call.family == "dense_matmul" and call.variant == "packed_k_major_gemv_norm_stats" %}
{% set sme_slots = call.sme_slots | default(sme_slots) %}
static FTT_DEVICE void {{ call.symbol }}({{ entry.device_signature(call) }}) {
{{ entry.mesh_coordinates() }}
{{ entry.thread_identity() }}
{# The warp fold publishes one FP32 statistic per warp. With shared reuse,
   these slots occupy the arena's final words, disjoint from all cross-warp
   projection partials still being read below. #}
{% if shared_arena_reuse | default(false) %}
    auto *const ftt_dense_stats_partial =
        reinterpret_cast<float *>(_ftt_sme_arena) + {{ sme_arena_elems // 2 - warps }};
{% else %}
    __shared__ float ftt_dense_stats_partial[{{ warps }}];
{% endif %}
    auto *const ftt_source = {{ call.source | cppexpr }};
    auto *const ftt_weight = {{ call.weight | cppexpr }};
    auto *const ftt_residual = {{ call.residual | cppexpr }};
    auto *const ftt_result = {{ call.result | cppexpr }};
    float dense_stats_square_sum = 0.0f;
{% set streams = call.k_streams | default(1) %}
{% set lane = call.weight_k_lane | default(0) %}
{% set chunk = 8 %}
{# Same vectorized payload walk and residency guard as
   dense_matmul/_function.cpp.jinja; see that file for the measurements. This
   variant has its own payload loop, so the chunking has to be repeated here
   rather than inherited -- it was the single largest non-GEMV cost before
   (3.42 ms/token at 128 N over 1024 threads). #}
{# Chunking the *payload* (the N x lane walk) is a measured loss here: 24.47 vs
   20.04 ms/token. This variant's N extent is only 128, so `N * lane / chunk`
   is 256 work items over 1024 threads -- 25% residency -- and the wide load
   cannot pay for the three quarters of the block it idles. The K-split below
   is the shape that keeps the wide load *and* the residency. #}
{# Splitting K instead of N is what makes the wide load affordable: the K axis
   is the long one here (6144 = 384 groups), so handing each N a group of
   cooperating threads that each own a *slice of K* keeps the whole block busy
   AND gives every thread a 16-byte run.

     halves  = lane / chunk            positions inside one lane run
     coop    = block_threads / N       threads per output element
     kslice  = coop / halves           K slices per output element

   For Qwen3's 128 x 6144 shard that is 2 x 4 = 8 threads per N, 128 x 8 =
   1024 = the whole block, and 384 / 4 = 96 groups per slice.

   `coop_id` is the *fastest* thread dimension so the cooperating threads are
   adjacent lanes and fold with one shuffle instead of through shared memory.
   It also keeps the reads wide: for a fixed K slice the `(n, half)` pairs of
   16 consecutive threads cover `chunk * 16` consecutive elements, i.e. one
   256-byte segment, against 128 bytes per warp on the scalar walk.

   The K slices are interleaved rather than blocked so the concurrently active
   K range stays narrow and the shared activation vector is read out of L2. #}
{% set halves = (lane // chunk) if chunk and lane % chunk == 0 else 0 %}
{% set coop_width = (block_threads // call.local_n_capacity)
       if call.local_n_capacity else 0 %}
{% set kslice = (coop_width // halves)
       if halves and coop_width % halves == 0 else 0 %}
{% set kgroups = (call.local_k_capacity // lane) if lane else 0 %}
{% set ksplit = lane >= chunk and lane % chunk == 0
       and call.weight_block_n and call.weight_block_k == lane
       and kslice > 0 and coop_width >= halves
       and call.local_n_capacity * coop_width == block_threads
       and kgroups % kslice == 0
       and ((kgroups // kslice) % streams == 0) %}
{% set step = 1 %}
{% set coop = lane %}
{# SME weight staging, in the per-warp software-pipelined form GLU uses: a warp
   stages the tile it will itself consume, so there is no `cta_sync` to publish
   it (warp specialization needs one per stage, measured at 0.193 us x groups x
   layers -- more than the bandwidth it buys).

   The geometry differs from GLU and that is the whole point. One k-group here
   is `local_n_capacity * lane` = 2048 elements = 4 tiles, fewer than the 16
   warps, so a one-tile-per-warp mapping would leave 12 warps idle at 25%
   staging residency -- the reason this site was left on the vector path. Give
   each warp a tile from a *different* k-group instead: `warps // tiles` groups
   are staged concurrently, every warp owns exactly one 512-element tile, and a
   warp of 64 lanes at `chunk` 8 consumes exactly 512 elements, a 1:1 match.
   The partial sums over the concurrent groups are different K at the same N,
   so folding them is a plain add.

   An off-device oracle checked the mapping covers all 786432 (n, k) pairs
   exactly once with no duplicates at 100% residency. #}
{% set sme_gsize = call.local_n_capacity * lane %}
{% set sme_tiles = (sme_gsize // 512) if sme_gsize % 512 == 0 else 0 %}
{% set sme_gconc = (warps // sme_tiles) if sme_tiles else 0 %}
{% set sme_batch = sme_slots // 2 %}
{% set sme_stage = sme and sme_slots >= 2 and chunk == 8 and lane and sme_tiles
       and call.weight_group_stride
       and sme_gconc > 1
       and sme_tiles * sme_gconc == warps
       and kgroups >= 2 * sme_gconc * sme_batch
       and kgroups % (sme_gconc * sme_batch) == 0
       and call.weight_block_n and call.weight_block_k == lane
       and (warps * (512 + sme_pad) * 2 * sme_slots) <= 114688 %}
{% if sme_stage %}
{# Views into the module-scope arena: every device function is inlined into one
   megakernel, so each `__shared__` declaration is co-resident and the budget
   is global. The arena is sized for the largest staging site. #}
    auto *const dense_sme_buf =
        reinterpret_cast<ftt::bfloat16_t (*)[{{ sme_slots }}][512 + {{ sme_pad }}]>(
            _ftt_sme_arena);
    const ftt::dim_t dense_sme_warp = ftt_thread / {{ warp_size }}LL;
    const ftt::dim_t dense_sme_lane = ftt_thread % {{ warp_size }}LL;
{# This warp's tile: which of the `sme_gconc` concurrent groups, and which of
   the `sme_tiles` tiles inside it. #}
    const ftt::dim_t dense_sme_goff = dense_sme_warp / {{ sme_tiles }}LL;
    const ftt::dim_t dense_sme_tile = dense_sme_warp % {{ sme_tiles }}LL;
    const ftt::dim_t dense_sme_group_stride = {{ call.weight_group_stride }}LL;
{# Shard base from the call's own offset formula, evaluated at the origin: the
   packed weights are canonical-global, so a hand-written walk that used the
   owner-local offsets would read shard 0 for every CTA. #}
    ftt::dim_t dense_sme_shard_base = 0;
    {
        const ftt::dim_t dense_local_n_offsets = 0LL;
        const ftt::dim_t dense_local_k_offsets = 0LL;
        const ftt::dim_t dense_global_n = {{ call.global_n | cppexpr }};
        const ftt::dim_t dense_global_k = {{ call.global_k | cppexpr }};
        (void)dense_global_n;
        (void)dense_global_k;
        dense_sme_shard_base = {{ call.weight_offset | cppexpr }};
    }
{% if call.cpp_shard_major_weight | default(false) %}
    dense_sme_shard_base =
        (dense_sme_shard_base / {{ call.canonical_weight_group_stride }}LL)
            * {{ call.weight_group_stride }}LL
        + (dense_sme_shard_base % {{ call.canonical_weight_group_stride }}LL)
            * {{ call.weight_layout_k_groups }}LL;
{% endif %}
    const auto dense_sme_source = ftt::arch::sme_source_for(
        &ftt_weight[dense_sme_shard_base + dense_sme_tile * 512LL], 64);
{# This lane's run inside the staged tile, and the (n, k) it therefore owns. #}
    const ftt::dim_t dense_sme_run = dense_sme_lane * {{ chunk }}LL;
    const ftt::dim_t dense_sme_elem = dense_sme_tile * 512LL + dense_sme_run;
    const ftt::dim_t dense_sme_n = dense_sme_elem / {{ lane }}LL;
    const ftt::dim_t dense_sme_k_in_lane = dense_sme_elem % {{ lane }}LL;
    float dense_sme_acc = 0.0f;
{# Activation pointer as an induction variable: the offset is
   `(group + u) * lane + k_in_lane` and `k_in_lane` is fixed per lane, so the
   compiler's re-multiplication each step is pure overhead. #}
    const ftt::bfloat16_t *dense_sme_act;
    {
        const ftt::dim_t dense_local_k_offsets =
            dense_sme_goff * {{ lane }}LL + dense_sme_k_in_lane;
        const ftt::dim_t dense_local_n_offsets = dense_sme_n;
        const ftt::dim_t dense_global_n = {{ call.global_n | cppexpr }};
        const ftt::dim_t dense_global_k = {{ call.global_k | cppexpr }};
        (void)dense_global_n;
        (void)dense_global_k;
        dense_sme_act = &ftt_source[{{ call.source_offset | cppexpr }}];
    }
{% with sme_issuer_lane="dense_sme_lane", sme_buffer="dense_sme_buf", sme_warp="dense_sme_warp",
        sme_goff="dense_sme_goff", sme_groups=kgroups, sme_concurrency=sme_gconc, sme_lane=lane,
        sme_stride="dense_sme_group_stride", sme_act="dense_sme_act",
        sme_run="dense_sme_run", sme_projections=1,
        sme_sources=["dense_sme_source"], sme_accumulators=["dense_sme_acc"] %}
{% include "kernels/_sme_batches.cpp.jinja" %}
{% endwith %}
{# Fold the `lane / chunk` lanes sharing an N, then the `sme_gconc` warps that
   covered the other concurrent groups of the same N. The warp fold is a
   shuffle; the cross-warp fold goes through shared memory because those lanes
   are in different warps. #}
    dense_sme_acc =
        ftt::arch::lane_group_reduce_sum<{{ lane // chunk }}>(dense_sme_acc);
{# Staged weights are dead after the completed pipeline; reuse each warp's
   first slot for its FP32 partials rather than adding another shared array. #}
    if (dense_sme_k_in_lane == 0) {
        reinterpret_cast<float *>(&dense_sme_buf[dense_sme_warp][0][0])[dense_sme_run / {{ lane }}LL] =
            dense_sme_acc;
    }
    ftt::arch::cta_sync();
{# One thread per output N sums the `sme_gconc` groups and publishes. #}
    for (ftt::dim_t dense_out = ftt_thread;
         dense_out < {{ call.local_n_capacity }}LL; dense_out += ftt_threads) {
        const ftt::dim_t dense_local_n_offsets = dense_out;
        const ftt::dim_t dense_global_n = {{ call.global_n | cppexpr }};
        (void)dense_global_n;
        if (!({{ call.result_active | cppexpr }})) {
            continue;
        }
        float dense_accumulator = 0.0f;
        FTT_UNROLL
        for (int dense_gi = 0; dense_gi < {{ sme_gconc }}; ++dense_gi) {
            const ftt::dim_t w = dense_gi * {{ sme_tiles }}LL
                               + (dense_out * {{ lane }}LL) / 512LL;
            dense_accumulator +=
                reinterpret_cast<float *>(&dense_sme_buf[w][0][0])[(dense_out * {{ lane }}LL % 512LL) / {{ lane }}LL];
        }
{# Falls through to the shared epilogue below, which owns the rounding
   boundaries and the statistic, with `dense_accumulator` and
   `dense_local_n_offsets` in scope -- the same handoff ksplit makes. #}
{% elif ksplit %}
{# K-split walk: `coop_width` adjacent threads share one N, each owning an
   interleaved slice of the K groups and reading its run as one 16-byte load.
   Only `coop_id == 0` stores and contributes to the statistic, so each output
   element is still counted exactly once. #}
    for (ftt::dim_t dense_element_base = 0;
         dense_element_base < {{ call.local_n_capacity }}LL;
         dense_element_base += {{ block_threads // coop_width }}LL) {
        const ftt::dim_t dense_coop_id = ftt_thread % {{ coop_width }}LL;
        const ftt::dim_t dense_local_n_offsets =
            dense_element_base + ftt_thread / {{ coop_width }}LL;
        const ftt::dim_t dense_k_half = dense_coop_id % {{ halves }}LL;
        const ftt::dim_t dense_k_slice = dense_coop_id / {{ halves }}LL;
        const ftt::dim_t dense_k_in_lane = dense_k_half * {{ chunk }}LL;
        const ftt::dim_t dense_global_n = {{ call.global_n | cppexpr }};
        (void)dense_global_n;
        if (!({{ call.result_active | cppexpr }})) {
            continue;
        }
        float dense_partial[{{ streams }}] = {};
        for (ftt::dim_t dense_group_base = 0;
             dense_group_base < {{ kgroups // kslice }}LL;
             dense_group_base += {{ streams }}LL) {
            FTT_UNROLL
            for (ftt::dim_t dense_stream = 0;
                 dense_stream < {{ streams }}LL; ++dense_stream) {
                const ftt::dim_t dense_local_k_offsets =
                    (((dense_group_base + dense_stream) * {{ kslice }}LL
                      + dense_k_slice) * {{ lane }}LL) + dense_k_in_lane;
                const ftt::dim_t dense_global_k = {{ call.global_k | cppexpr }};
                (void)dense_global_k;
{% if not call.k_predicate_redundant %}
                if (!({{ call.source_active | cppexpr }})) {
                    continue;
                }
{% endif %}
                const auto dense_weight_run = ftt::{{ run_load }}<{{ chunk }}>(
                    &ftt_weight[{{ call.weight_offset | cppexpr }}]);
                const auto dense_source_run = ftt::{{ run_load }}<{{ chunk }}>(
                    &ftt_source[{{ call.source_offset | cppexpr }}]);
                float dense_step = 0.0f;
{# Two elements per instruction; see `dot2_step` in ftt/primitive_ops.h. #}
                FTT_UNROLL
                for (int dense_pair = 0; dense_pair < {{ chunk // 2 }};
                     ++dense_pair) {
                    dense_step = ftt::dot2_step(
                        dense_weight_run, dense_source_run,
                        dense_pair, dense_step);
                }
                dense_partial[(int)dense_stream] += dense_step;
            }
        }
        float dense_accumulator = 0.0f;
        FTT_UNROLL
        for (int dense_stream = 0; dense_stream < {{ streams }};
             ++dense_stream)
            dense_accumulator += dense_partial[dense_stream];
        dense_accumulator =
            ftt::arch::lane_group_reduce_sum<{{ coop_width }}>(
                dense_accumulator);
        if (dense_coop_id != 0) {
            continue;
        }
{% elif lane > 1 %}
{# Physical-order payload walk; see the note in
   dense_matmul/_function.cpp.jinja. This is the heaviest per-layer GEMV in the
   Qwen3 decode path (K=6144), so the access pattern matters most here.

   Only the lane holding `k_in_lane == 0` stores and contributes to the
   statistic, so the sum of squares still counts each output element once. #}
    for (ftt::dim_t dense_payload = ftt_thread * {{ step }}LL;
         dense_payload < {{ call.local_n_capacity }}LL * {{ lane }}LL;
         dense_payload += ftt_threads * {{ step }}LL) {
        const ftt::dim_t dense_local_n_offsets = dense_payload / {{ lane }}LL;
        const ftt::dim_t dense_k_in_lane = dense_payload % {{ lane }}LL;
        const ftt::dim_t dense_global_n = {{ call.global_n | cppexpr }};
        (void)dense_global_n;
        if (!({{ call.result_active | cppexpr }})) {
            continue;
        }
{% set groups = (call.local_k_capacity // lane) %}
{% set kg_streams = streams if groups % streams == 0 else 1 %}
        float dense_partial[{{ kg_streams }}] = {};
        for (ftt::dim_t dense_group_base = 0;
             dense_group_base < {{ groups }}LL;
             dense_group_base += {{ kg_streams }}LL) {
            FTT_UNROLL
            for (ftt::dim_t dense_stream = 0;
                 dense_stream < {{ kg_streams }}LL; ++dense_stream) {
                const ftt::dim_t dense_local_k_offsets =
                    (dense_group_base + dense_stream) * {{ lane }}LL
                    + dense_k_in_lane;
                const ftt::dim_t dense_global_k = {{ call.global_k | cppexpr }};
                (void)dense_global_k;
{% if not call.k_predicate_redundant %}
                if (!({{ call.source_active | cppexpr }})) {
                    continue;
                }
{% endif %}
                dense_partial[(int)dense_stream] +=
                    ftt::to_float(ftt_weight[{{ call.weight_offset | cppexpr }}])
                    * ftt::to_float(ftt_source[{{ call.source_offset | cppexpr }}]);
            }
        }
        float dense_accumulator = 0.0f;
        FTT_UNROLL
        for (int dense_stream = 0; dense_stream < {{ kg_streams }};
             ++dense_stream)
            dense_accumulator += dense_partial[dense_stream];
        dense_accumulator =
            ftt::arch::lane_group_reduce_sum<{{ coop }}>(dense_accumulator);
        if (dense_k_in_lane != 0) {
            continue;
        }
{% else %}
{{ entry.strided_loop("dense_local_n_offsets", call.local_n_capacity) }} {
        const ftt::dim_t dense_global_n = {{ call.global_n | cppexpr }};
        (void)dense_global_n;
        if (!({{ call.result_active | cppexpr }})) {
            continue;
        }
{% if streams > 1 %}
        float dense_partial[{{ streams }}] = {};
        for (ftt::dim_t dense_pipeline_base = 0;
             dense_pipeline_base < {{ call.local_k_capacity }}LL;
             dense_pipeline_base += {{ streams }}LL) {
            FTT_UNROLL
            for (ftt::dim_t dense_stream = 0; dense_stream < {{ streams }}LL;
                 ++dense_stream) {
                const ftt::dim_t dense_local_k_offsets =
                    dense_pipeline_base + dense_stream;
                const ftt::dim_t dense_global_k = {{ call.global_k | cppexpr }};
                (void)dense_global_k;
{% if not call.k_predicate_redundant %}
                if (!({{ call.source_active | cppexpr }})) {
                    continue;
                }
{% endif %}
                dense_partial[(int)dense_stream] +=
                    ftt::to_float(ftt_weight[{{ call.weight_offset | cppexpr }}])
                    * ftt::to_float(ftt_source[{{ call.source_offset | cppexpr }}]);
            }
        }
        float dense_accumulator = 0.0f;
        FTT_UNROLL
        for (int dense_stream = 0; dense_stream < {{ streams }}; ++dense_stream)
            dense_accumulator += dense_partial[dense_stream];
{% else %}
        float dense_accumulator = 0.0f;
        for (ftt::dim_t dense_local_k_offsets = 0;
             dense_local_k_offsets < {{ call.local_k_capacity }}LL;
             ++dense_local_k_offsets) {
            const ftt::dim_t dense_global_k = {{ call.global_k | cppexpr }};
            (void)dense_global_k;
            if (!({{ call.source_active | cppexpr }})) {
                continue;
            }
            dense_accumulator +=
                ftt::to_float(ftt_weight[{{ call.weight_offset | cppexpr }}])
                * ftt::to_float(ftt_source[{{ call.source_offset | cppexpr }}]);
        }
{% endif %}
{% endif %}
        const float dense_residual =
            ftt::to_float(ftt_residual[{{ call.residual_offset | cppexpr }}]);
{# `addend_cast_types` records intermediate rounding of the residual before the
   add. Each entry is one round-trip through that dtype; the C++ side cannot
   name an arbitrary Triton dtype, so a non-empty list is rejected in
   `_reject_unsupported_constructs` rather than silently skipped. #}
        const float dense_projection =
            ftt::to_float(ftt::store_as(ftt_result, dense_accumulator));
        const auto dense_value =
            ftt::store_as(ftt_result, dense_projection + dense_residual);
        if ({{ call.result_writer_active | cppexpr }}) {
            ftt_result[{{ call.result_offset | cppexpr }}] = dense_value;
        }
        const float dense_value_fp32 = ftt::to_float(dense_value);
        dense_stats_square_sum += dense_value_fp32 * dense_value_fp32;
    }
{# Two-stage tree reduction; see kernels/norm_stats/_function.cpp.jinja for the
   measurement. Thread 0 walking all `ftt_threads` shared slots serially is
   1023 dependent shared reads per statistic; folding inside each warp first
   leaves only `ftt_threads / warp_size` slots to merge. #}
    dense_stats_square_sum =
        ftt::arch::warp_reduce_sum(dense_stats_square_sum);
    if ((ftt_thread % {{ warp_size }}LL) == 0) {
        ftt_dense_stats_partial[ftt_thread / {{ warp_size }}LL] = dense_stats_square_sum;
    }
    ftt::arch::cta_sync();
    if (ftt_thread == 0) {
        for (ftt::dim_t warp_index = 1;
             warp_index < (ftt_threads / {{ warp_size }}LL); ++warp_index) {
            dense_stats_square_sum += ftt_dense_stats_partial[warp_index];
        }
        if ({{ call.stats_writer_active | cppexpr }}) {
            auto *const ftt_stats = {{ call.stats | cppexpr }};
            ftt_stats[{{ call.stats_offset | cppexpr }}] =
                ftt::store_as(ftt_stats, dense_stats_square_sum);
        }
    }
{% if not call.cpp_shared_exit_barrier_in_schedule | default(false) %}
    ftt::arch::cta_sync();
{% endif %}
}


{% endif %}
{% endfor %}
{% endif %}
