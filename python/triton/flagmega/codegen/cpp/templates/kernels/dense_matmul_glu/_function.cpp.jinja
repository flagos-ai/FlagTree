{% import "entrypoints/_common.cpp.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "dense_matmul_glu" and call.variant == dense_matmul_glu_variant %}
{# Fused gate/up GEMV with the SwiGLU activation. One thread per N element,
   reducing its own K axis -- see the note in dense_matmul/_function.cpp.jinja
   on why the Triton form's deferred K reduce does not apply here.

   The rounding boundaries are load-bearing and match the Triton form exactly:
   both projections are rounded to the output dtype before the activation,
   and (when `round_activation` is set) the activation is rounded again before
   multiplying by `up`. Those are the points where this kernel agrees with the
   reference implementation; collapsing them to one final round changes
   results. #}
static FTT_DEVICE void {{ call.symbol }}({{ entry.device_signature(call) }}) {
{{ entry.mesh_coordinates() }}
{{ entry.thread_identity() }}
{% set streams = call.k_streams | default(1) %}
{% set lane = call.weight_k_lane | default(0) %}
{# One 16-byte transaction. Not a free parameter: `chunk` must leave
   `lane / chunk` threads sharing an N, and at `chunk == lane` that collapses
   to one thread per N -- measured 30.5 ms/token against 20.6 at 8, the same
   residency cliff the whole-run attempt fell off. #}
{% set chunk = 8 %}
{# `tiled`'s last term is the residency guard described in
   dense_matmul/_function.cpp.jinja: tiling only pays when one payload slot per
   thread would leave the block underfilled. #}
{% set tiled = lane >= chunk and lane % chunk == 0
       and call.weight_block_n and call.weight_block_k == lane
       and (call.local_n_capacity * lane) % chunk == 0
       and ((call.local_k_capacity // lane) % streams == 0)
       and call.local_n_capacity * lane <= block_threads * chunk %}
    auto *const ftt_source = {{ call.source | cppexpr }};
    auto *const ftt_gate_weight = {{ call.gate_weight | cppexpr }};
    auto *const ftt_up_weight = {{ call.up_weight | cppexpr }};
    auto *const ftt_result = {{ call.result | cppexpr }};
{% if tiled %}
{% set chunks = (call.local_n_capacity * lane) // chunk %}
{% set groups = (call.local_k_capacity // lane) %}
{% set coop = lane // chunk %}
{# Depth of the tiled K walk, independent of `k_streams`.

   `k_streams` is tuned for the scalar walk, where one stream is one 2-byte
   load; here one stream is three 16-byte loads, so the two knobs want
   different values and sweeping `k_streams` globally conflates them (it also
   moves the non-tiled kernels). This machine is latency-bound rather than
   bandwidth-bound -- the whole model runs at 183 GB/s against a ~670 GB/s
   scalar ceiling -- so the figure of merit is independent loads in flight per
   thread, and that is exactly what this controls. #}
{% set depth = tiled_depth | default(4) %}
{% set tdepth = depth if groups % depth == 0 else streams %}
{# Split K across cooperating threads when the payload walk alone cannot fill
   the block. `chunks` is the number of 16-byte work items in the N x lane
   payload; when that is less than `block_threads` the strided loop leaves the
   tail of the block idle on every pass (384 N x 16 lane / 8 = 768 of 1024
   threads, i.e. 75%). Giving each output element `kslice` threads that own
   interleaved slices of the K groups multiplies the work items back up.

   `kslice` is the smallest factor that makes the item count a whole multiple
   of the block -- so every thread gets the same number of items, no tail pass
   -- while keeping the cooperating group inside one warp so the fold is a
   shuffle rather than shared memory. `block_threads` divides the item count,
   so `coop_id` is the same for a thread on every pass and the shuffle
   partners stay fixed. #}
{% set ns = namespace(kslice=1) %}
{% for candidate in [2, 4, 8, 16] %}
{% if ns.kslice == 1
      and chunks * candidate >= block_threads
      and (chunks * candidate) % block_threads == 0
      and groups % candidate == 0
      and (groups // candidate) % tdepth == 0
      and coop * candidate <= warp_size %}
{% set ns.kslice = candidate %}
{% endif %}
{% endfor %}
{% set kslice = ns.kslice if chunks < block_threads else 1 %}
{% set coop_width = coop * kslice %}
{# Vectorized payload walk. The packed layout stores a whole contiguous tile
   (`weight_block_n` N by `lane` K, N-major), so `chunk` consecutive payload
   slots are `chunk` consecutive addresses: one 16-byte transaction instead of
   eight 2-byte loads.

   Both halves of the BI-V150 story are kept at once, which is what the
   earlier attempts got wrong:
     * width -- each thread's weight read is a single `load_run<8>`;
     * depth -- `streams` K groups stay in flight, because this device is
       limited by loads in flight, not load width. One wide run per iteration
       (a single dependent chain) measured 30.1 ms/token against the scalar
       8-stream loop's 21.8; width alone is a regression.
   Per-thread work also stays balanced: `chunks` is the N extent times `lane`
   over `chunk`, so the strided loop covers every thread rather than leaving
   most of the block idle on one N each (measured 29.4 that way).
   `coop` threads share an N and fold through the lane group at the end. #}
{# Reuse the activation run across the items one thread owns.

   The strided item loop gives every thread `chunks * kslice / block_threads`
   items, and all of them land on the *same* `(k_slice, k_in_lane)` pair --
   the stride is a whole multiple of `kslice` and of `lane / chunk`. So they
   read byte-identical activation runs and differ only in N.

   That matters because this kernel is issue-bound, not latency-bound: with
   the K-split in place GLU runs at 394 GB/s against the ~373 GB/s ceiling for
   128-bit loads on this device, i.e. it is already at the one-load-per-cycle
   -per-MP limit. The lever left is *fewer load instructions for the same
   work*, and the activation is a third of them.

   Hoisting it is what the earlier attempts could not do:
     * Staging the activation in shared memory replaced a global load with a
       shared load, which still costs an issue slot, and added `cta_sync` plus
       bank conflicts -- measured 30.69 vs 19.91 ms/token.
     * An N-direction register tile was rejected when the payload walk gave
       only 0.75 chunks per thread; there was nothing to tile. The K-split
       changed that geometry to 3 items per thread, which is what makes this
       possible now.
   Keeping the N axis in registers and the activation loaded once removes
   2 of every 3 activation loads with no shared memory and no barrier. #}
{% set items = (chunks * kslice) // block_threads %}
{% if items > 1 and (chunks * kslice) % block_threads == 0 %}
{% set ntile = items %}
{% else %}
{% set ntile = 1 %}
{% endif %}
    for (ftt::dim_t dense_glu_item = ftt_thread;
         dense_glu_item < {{ chunks * kslice }}LL;
         dense_glu_item += ftt_threads * {{ ntile }}LL) {
{% if kslice > 1 %}
{# The K slice is the fastest axis so the `kslice` partners of one payload
   chunk are adjacent lanes. All `ntile` items of this thread share it. #}
        const ftt::dim_t dense_glu_k_slice = dense_glu_item % {{ kslice }}LL;
{% endif %}
        const ftt::dim_t dense_glu_k_in_lane =
            ((dense_glu_item / {{ kslice }}LL) * {{ chunk }}LL) % {{ lane }}LL;
{# One N position per tile slot. The stride is a whole multiple of `kslice`
   and of `lane / chunk`, so these differ only in N. #}
        ftt::dim_t dense_glu_tile_n[{{ ntile }}];
        bool dense_glu_tile_live[{{ ntile }}];
        FTT_UNROLL
        for (int dense_glu_slot = 0; dense_glu_slot < {{ ntile }};
             ++dense_glu_slot) {
            const ftt::dim_t dense_glu_chunk =
                (dense_glu_item + dense_glu_slot * ftt_threads)
                / {{ kslice }}LL;
            dense_glu_tile_n[dense_glu_slot] =
                (dense_glu_chunk * {{ chunk }}LL) / {{ lane }}LL;
            const ftt::dim_t dense_glu_local_n_offsets =
                dense_glu_tile_n[dense_glu_slot];
            const ftt::dim_t dense_glu_global_n = {{ call.global_n | cppexpr }};
            (void)dense_glu_global_n;
            dense_glu_tile_live[dense_glu_slot] =
                (dense_glu_item + dense_glu_slot * ftt_threads
                     < {{ chunks * kslice }}LL)
                && ({{ call.result_active | cppexpr }});
        }
        float dense_glu_gate_partial[{{ ntile }}] = {};
        float dense_glu_up_partial[{{ ntile }}] = {};
{# Issue-then-consume over the K groups, with the activation run loaded ONCE
   per group and reused across the N tile.

   This kernel is issue-bound rather than latency-bound: with the K-split in
   place GLU reaches 394 GB/s against the ~373 GB/s ceiling for 128-bit loads
   on this device, i.e. it already sits at the one-load-per-cycle-per-MP
   limit. So the lever is fewer load instructions for the same work, not more
   loads in flight -- two forms of deeper pipelining measured neutral
   (12.247 -> 12.226 for phase-split, 10.374 -> 10.352 for full double
   buffering) precisely because there is no idle latency left to hide.

   The activation was a third of the loads and was being re-read once per N
   item. Two earlier attempts at that redundancy failed for reasons this form
   avoids: staging it in shared memory swapped a global load for a shared one
   (still an issue slot) and added `cta_sync` plus bank conflicts (30.69 vs
   19.91 ms/token), and an N register tile had nothing to tile when the
   payload walk gave 0.75 chunks per thread. The K-split changed that
   geometry to `ntile` items per thread, which is what makes the reuse
   available without shared memory or a barrier. #}
        for (ftt::dim_t dense_glu_group_base = 0;
             dense_glu_group_base < {{ groups // kslice }}LL;
             dense_glu_group_base += {{ tdepth }}LL) {
            ftt::bf16_run_t<{{ chunk }}> dense_glu_source_run[{{ tdepth }}];
            ftt::bf16_run_t<{{ chunk }}>
                dense_glu_weight_run[{{ ntile * tdepth * 2 }}];
            FTT_UNROLL
            for (int dense_glu_stream = 0;
                 dense_glu_stream < {{ tdepth }}; ++dense_glu_stream) {
                const ftt::dim_t dense_glu_local_k_offsets =
{% if kslice > 1 %}
{# Interleave the slices so the concurrently active K window stays narrow and
   the activation vector is served from L2. #}
                    (((dense_glu_group_base + dense_glu_stream)
                      * {{ kslice }}LL + dense_glu_k_slice) * {{ lane }}LL)
                    + dense_glu_k_in_lane;
{% else %}
                    (dense_glu_group_base + dense_glu_stream) * {{ lane }}LL
                    + dense_glu_k_in_lane;
{% endif %}
                dense_glu_source_run[dense_glu_stream] =
                    ftt::{{ run_load }}<{{ chunk }}>(
                        &ftt_source[{{ call.source_offset | cppexpr }}]);
            }
            FTT_UNROLL
            for (int dense_glu_slot = 0; dense_glu_slot < {{ ntile }};
                 ++dense_glu_slot) {
                const ftt::dim_t dense_glu_local_n_offsets =
                    dense_glu_tile_n[dense_glu_slot];
                const ftt::dim_t dense_glu_global_n = {{ call.global_n | cppexpr }};
                (void)dense_glu_global_n;
                FTT_UNROLL
                for (int dense_glu_stream = 0;
                     dense_glu_stream < {{ tdepth }}; ++dense_glu_stream) {
                    const ftt::dim_t dense_glu_local_k_offsets =
{% if kslice > 1 %}
                        (((dense_glu_group_base + dense_glu_stream)
                          * {{ kslice }}LL + dense_glu_k_slice) * {{ lane }}LL)
                        + dense_glu_k_in_lane;
{% else %}
                        (dense_glu_group_base + dense_glu_stream)
                            * {{ lane }}LL + dense_glu_k_in_lane;
{% endif %}
                    const ftt::dim_t dense_glu_global_k = {{ call.global_k | cppexpr }};
                    (void)dense_glu_global_k;
                    dense_glu_weight_run[dense_glu_slot * {{ tdepth * 2 }}
                                         + dense_glu_stream * 2] =
                        ftt::{{ run_load }}<{{ chunk }}>(
                            &ftt_gate_weight[{{ call.gate_weight_offset | cppexpr }}]);
                    dense_glu_weight_run[dense_glu_slot * {{ tdepth * 2 }}
                                         + dense_glu_stream * 2 + 1] =
                        ftt::{{ run_load }}<{{ chunk }}>(
                            &ftt_up_weight[{{ call.up_weight_offset | cppexpr }}]);
                }
            }
            FTT_UNROLL
            for (int dense_glu_slot = 0; dense_glu_slot < {{ ntile }};
                 ++dense_glu_slot) {
                float dense_glu_gate_step = 0.0f;
                float dense_glu_up_step = 0.0f;
                FTT_UNROLL
                for (int dense_glu_stream = 0;
                     dense_glu_stream < {{ tdepth }}; ++dense_glu_stream) {
                    FTT_UNROLL
                    for (int dense_glu_element = 0;
                         dense_glu_element < {{ chunk }}; ++dense_glu_element) {
                        const float dense_glu_source_value =
                            dense_glu_source_run[dense_glu_stream]
                                .at(dense_glu_element);
                        dense_glu_gate_step +=
                            dense_glu_weight_run[dense_glu_slot
                                                     * {{ tdepth * 2 }}
                                                 + dense_glu_stream * 2]
                                .at(dense_glu_element)
                            * dense_glu_source_value;
                        dense_glu_up_step +=
                            dense_glu_weight_run[dense_glu_slot
                                                     * {{ tdepth * 2 }}
                                                 + dense_glu_stream * 2 + 1]
                                .at(dense_glu_element)
                            * dense_glu_source_value;
                    }
                }
                dense_glu_gate_partial[dense_glu_slot] += dense_glu_gate_step;
                dense_glu_up_partial[dense_glu_slot] += dense_glu_up_step;
            }
        }
{# One epilogue per tile slot. The fold spans the cooperating lane group, so
   every slot folds before any of them stores. #}
        FTT_UNROLL
        for (int dense_glu_slot = 0; dense_glu_slot < {{ ntile }};
             ++dense_glu_slot) {
            float dense_glu_gate_sum = dense_glu_gate_partial[dense_glu_slot];
            float dense_glu_up_sum = dense_glu_up_partial[dense_glu_slot];
{% if coop_width > 1 %}
{# Fold the cooperating threads before the activation: the rounding boundary
   below applies to the complete projection, not a partial one.
   The group spans both the payload halves and the K slices, and the loop
   indexing puts all of them in one contiguous run of lanes, so a single lane
   group fold covers the whole set. #}
            dense_glu_gate_sum =
                ftt::arch::lane_group_reduce_sum<{{ coop_width }}>(
                    dense_glu_gate_sum);
            dense_glu_up_sum =
                ftt::arch::lane_group_reduce_sum<{{ coop_width }}>(
                    dense_glu_up_sum);
{% endif %}
            if (!dense_glu_tile_live[dense_glu_slot]) {
                continue;
            }
{% if coop_width > 1 %}
            if (dense_glu_k_in_lane != 0{% if kslice > 1 %} || dense_glu_k_slice != 0{% endif %}) {
                continue;
            }
{% endif %}
            const ftt::dim_t dense_glu_local_n_offsets =
                dense_glu_tile_n[dense_glu_slot];
{% elif lane > 1 %}
{# Physical-order payload walk over both projections; see the note in
   dense_matmul/_function.cpp.jinja. Gate and up share the payload slot, so
   each iteration issues two contiguous loads. #}
    for (ftt::dim_t dense_glu_payload = ftt_thread;
         dense_glu_payload < {{ call.local_n_capacity }}LL * {{ lane }}LL;
         dense_glu_payload += ftt_threads) {
        const ftt::dim_t dense_glu_local_n_offsets =
            dense_glu_payload / {{ lane }}LL;
        const ftt::dim_t dense_glu_k_in_lane =
            dense_glu_payload % {{ lane }}LL;
        const ftt::dim_t dense_glu_global_n = {{ call.global_n | cppexpr }};
        (void)dense_glu_global_n;
        if (!({{ call.result_active | cppexpr }})) {
            continue;
        }
{% set groups = (call.local_k_capacity // lane) %}
{% set kg = streams if groups % streams == 0 else 1 %}
        float dense_glu_gate_partial[{{ kg }}] = {};
        float dense_glu_up_partial[{{ kg }}] = {};
        for (ftt::dim_t dense_glu_group_base = 0;
             dense_glu_group_base < {{ groups }}LL;
             dense_glu_group_base += {{ kg }}LL) {
            FTT_UNROLL
            for (ftt::dim_t dense_glu_stream = 0;
                 dense_glu_stream < {{ kg }}LL; ++dense_glu_stream) {
                const ftt::dim_t dense_glu_local_k_offsets =
                    (dense_glu_group_base + dense_glu_stream) * {{ lane }}LL
                    + dense_glu_k_in_lane;
                const ftt::dim_t dense_glu_global_k = {{ call.global_k | cppexpr }};
                (void)dense_glu_global_k;
{% if not call.k_predicate_redundant %}
                if (!({{ call.source_active | cppexpr }})) {
                    continue;
                }
{% endif %}
                const float dense_glu_source_value =
                    ftt::to_float(ftt_source[{{ call.source_offset | cppexpr }}]);
                dense_glu_gate_partial[(int)dense_glu_stream] +=
                    ftt::to_float(ftt_gate_weight[{{ call.gate_weight_offset | cppexpr }}])
                    * dense_glu_source_value;
                dense_glu_up_partial[(int)dense_glu_stream] +=
                    ftt::to_float(ftt_up_weight[{{ call.up_weight_offset | cppexpr }}])
                    * dense_glu_source_value;
            }
        }
        float dense_glu_gate_sum = 0.0f;
        float dense_glu_up_sum = 0.0f;
        FTT_UNROLL
        for (int dense_glu_stream = 0; dense_glu_stream < {{ kg }};
             ++dense_glu_stream) {
            dense_glu_gate_sum += dense_glu_gate_partial[dense_glu_stream];
            dense_glu_up_sum += dense_glu_up_partial[dense_glu_stream];
        }
{# Fold the lane group before the activation: the rounding boundary below
   applies to the complete projection, not a partial one. #}
        dense_glu_gate_sum =
            ftt::arch::lane_group_reduce_sum<{{ lane }}>(dense_glu_gate_sum);
        dense_glu_up_sum =
            ftt::arch::lane_group_reduce_sum<{{ lane }}>(dense_glu_up_sum);
        if (dense_glu_k_in_lane != 0) {
            continue;
        }
{% else %}
{{ entry.strided_loop("dense_glu_local_n_offsets", call.local_n_capacity) }} {
        const ftt::dim_t dense_glu_global_n = {{ call.global_n | cppexpr }};
        (void)dense_glu_global_n;
        if (!({{ call.result_active | cppexpr }})) {
            continue;
        }
{% if streams > 1 %}
{# Software-pipelined K reduction over both projections; see the note in
   dense_matmul/_function.cpp.jinja for the measurement that motivates it.
   Gate and up share the K loop, so this keeps 2 x `streams` loads in flight. #}
        float dense_glu_gate_partial[{{ streams }}] = {};
        float dense_glu_up_partial[{{ streams }}] = {};
        for (ftt::dim_t dense_glu_pipeline_base = 0;
             dense_glu_pipeline_base < {{ call.local_k_capacity }}LL;
             dense_glu_pipeline_base += {{ streams }}LL) {
            FTT_UNROLL
            for (ftt::dim_t dense_glu_stream = 0;
                 dense_glu_stream < {{ streams }}LL; ++dense_glu_stream) {
                const ftt::dim_t dense_glu_local_k_offsets =
                    dense_glu_pipeline_base + dense_glu_stream;
                const ftt::dim_t dense_glu_global_k = {{ call.global_k | cppexpr }};
                (void)dense_glu_global_k;
{% if not call.k_predicate_redundant %}
                if (!({{ call.source_active | cppexpr }})) {
                    continue;
                }
{% endif %}
                const float dense_glu_source_value =
                    ftt::to_float(ftt_source[{{ call.source_offset | cppexpr }}]);
                dense_glu_gate_partial[(int)dense_glu_stream] +=
                    ftt::to_float(ftt_gate_weight[{{ call.gate_weight_offset | cppexpr }}])
                    * dense_glu_source_value;
                dense_glu_up_partial[(int)dense_glu_stream] +=
                    ftt::to_float(ftt_up_weight[{{ call.up_weight_offset | cppexpr }}])
                    * dense_glu_source_value;
            }
        }
        float dense_glu_gate_sum = 0.0f;
        float dense_glu_up_sum = 0.0f;
        FTT_UNROLL
        for (int dense_glu_stream = 0; dense_glu_stream < {{ streams }};
             ++dense_glu_stream) {
            dense_glu_gate_sum += dense_glu_gate_partial[dense_glu_stream];
            dense_glu_up_sum += dense_glu_up_partial[dense_glu_stream];
        }
{% else %}
        float dense_glu_gate_sum = 0.0f;
        float dense_glu_up_sum = 0.0f;
        for (ftt::dim_t dense_glu_local_k_offsets = 0;
             dense_glu_local_k_offsets < {{ call.local_k_capacity }}LL;
             ++dense_glu_local_k_offsets) {
            const ftt::dim_t dense_glu_global_k = {{ call.global_k | cppexpr }};
            (void)dense_glu_global_k;
            if (!({{ call.source_active | cppexpr }})) {
                continue;
            }
            const float dense_glu_source_value =
                ftt::to_float(ftt_source[{{ call.source_offset | cppexpr }}]);
            dense_glu_gate_sum +=
                ftt::to_float(ftt_gate_weight[{{ call.gate_weight_offset | cppexpr }}])
                * dense_glu_source_value;
            dense_glu_up_sum +=
                ftt::to_float(ftt_up_weight[{{ call.up_weight_offset | cppexpr }}])
                * dense_glu_source_value;
        }
{% endif %}
{% endif %}
        const float dense_glu_gate =
            ftt::to_float(ftt::store_as(ftt_result, dense_glu_gate_sum));
        const float dense_glu_up =
            ftt::to_float(ftt::store_as(ftt_result, dense_glu_up_sum));
        float dense_glu_activated =
            dense_glu_gate * ftt::sigmoid(dense_glu_gate);
{% if call.round_activation | default(true) %}
        dense_glu_activated =
            ftt::to_float(ftt::store_as(ftt_result, dense_glu_activated));
{% endif %}
        ftt_result[{{ call.result_offset | cppexpr }}] =
            ftt::store_as(ftt_result, dense_glu_activated * dense_glu_up);
{% if tiled and ntile > 1 %}
{# Close the per-slot epilogue loop as well as the item loop. #}
        }
{% endif %}
    }
}


