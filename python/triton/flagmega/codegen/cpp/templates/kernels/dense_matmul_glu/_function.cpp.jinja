{% for slot in range(sme_slots - 1) %}
{{ sme_issue("%dLL" % slot, "%dLL" % slot) }}
{% endfor %}
            ftt::arch::sme_drain();
        }
{# A warp is synchronous with itself, so lane 0's drain orders the tile for
