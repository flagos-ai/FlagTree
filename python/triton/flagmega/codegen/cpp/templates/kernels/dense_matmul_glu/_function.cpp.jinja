        &ftt_gate_weight[dense_glu_shard_base + dense_glu_tile_off], 64);
    const auto dense_glu_up_source = ftt::arch::sme_source_for(
        &ftt_up_weight[dense_glu_shard_base + dense_glu_tile_off], 64);
    const ftt::dim_t dense_glu_run_off = dense_glu_lane * {{ chunk }}LL;
    const ftt::dim_t dense_glu_elem =
        dense_glu_tile_off + dense_glu_run_off;
    const ftt::dim_t dense_glu_run_n = dense_glu_elem / {{ lane }}LL;
    const ftt::dim_t dense_glu_k_in_lane = dense_glu_elem % {{ lane }}LL;
    float dense_glu_gate_acc = 0.0f;
    float dense_glu_up_acc = 0.0f;
{# One stage issue from the hoisted descriptors: only the byte offset varies,
   which keeps the per-group cost to one add instead of rebuilding a 4-lane
   descriptor and moving it to scalar registers. #}
{% macro sme_issue(group_expr, slot) -%}
            ftt::arch::sme_copy_block_from(
                &dense_glu_sme_buf[dense_glu_warp][{{ slot }}][0][0],
                dense_glu_gate_source,
                ({{ group_expr }}) * dense_glu_group_stride * 2LL);
