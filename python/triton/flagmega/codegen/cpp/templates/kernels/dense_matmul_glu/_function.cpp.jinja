        reinterpret_cast<ftt::bfloat16_t (*)[{{ sme_slots }}][2][512]>(
            _ftt_sme_arena);
    const ftt::dim_t dense_glu_warp = ftt_thread / {{ warp_size }}LL;
    const ftt::dim_t dense_glu_lane = ftt_thread % {{ warp_size }}LL;
    const bool dense_glu_active = dense_glu_warp < {{ sme_tiles }}LL;
{# Group base and stride from the call's own address formula, not the layout
   name: a differently interleaved layout fails the `weight_group_stride`
   check above and never reaches here. #}
    const ftt::dim_t dense_glu_group_stride =
        {{ call.weight_group_stride }}LL;
    ftt::dim_t dense_glu_shard_base = 0;
    {
        const ftt::dim_t dense_glu_local_n_offsets = 0LL;
        const ftt::dim_t dense_glu_local_k_offsets = 0LL;
        const ftt::dim_t dense_glu_global_n = {{ call.global_n | cppexpr }};
        const ftt::dim_t dense_glu_global_k = {{ call.global_k | cppexpr }};
        (void)dense_glu_global_k;
        (void)dense_glu_global_n;
        dense_glu_shard_base = {{ call.gate_weight_offset | cppexpr }};
    }
{# This warp's tile offset inside a group, and this lane's run inside it. #}
    const ftt::dim_t dense_glu_tile_off = dense_glu_warp * 512LL;
{# Descriptors built once per kernel call. The base folds in the shard offset
   and this warp's tile, so the loop varies only the K-group byte offset. #}
