// flagmega-kernel: interleaved_projection/simt platform=generic
#include <ftt/quantized_ops.h>
{% import "entrypoints/_common.cpp.jinja" as entry with context %}
{% if render_calls is defined %}
{% for call in render_calls %}
{% if call.family == "interleaved_projection" and call.variant == "simt" %}
static FTT_DEVICE void {{ call.symbol }}({{ entry.device_signature(call) }}) {
{{ entry.mesh_coordinates() }}
{{ entry.thread_identity() }}
    auto *const ftt_source = {{ call.value | cppexpr }};
    auto *const ftt_weight = {{ call.weight | cppexpr }};
    auto *const ftt_result_0 = {{ call.result_0 | cppexpr }};
    auto *const ftt_result_1 = {{ call.result_1 | cppexpr }};
    for (ftt::dim_t interleaved_m = 0; interleaved_m < {{ call.local_m }}LL; ++interleaved_m) {
{{ entry.strided_loop("interleaved_offsets", call.local_n_capacity) }} {
        if (!({{ call.n_mask | cppexpr }})) continue;
        const float accumulator = ftt::quantized::dot<ftt::quantized::encoding::{{ "iq4_xs" if call.weight_encoding == "IQ4_XS" else "q4_k" }}>(
            ftt_source + ({{ call.source_row_offset | cppexpr }}),
            reinterpret_cast<const unsigned char *>(ftt_weight) + ({{ call.weight_row_offset | cppexpr }}), {{ call.k }}LL);
        if (({{ call.field | cppexpr }}) == 0)
            ftt_result_0[{{ call.destination_0_offset | cppexpr }}] = ftt::store_as(ftt_result_0, accumulator);
        else
            ftt_result_1[{{ call.destination_1_offset | cppexpr }}] = ftt::store_as(ftt_result_1, accumulator);
    }
    }
}
{% endif %}
{% endfor %}
{% endif %}
