// flagmega-kernel: gather_reduce_norm_apply/sum platform=generic
{# Normalize using a statistic gathered from every owner's partial.

   Each owner wrote a partial sum-of-squares (and, with `use_mean`, a partial
   sum) for this row; this kernel adds them up, derives the inverse standard
   deviation, and applies scale/bias over the local inner axis.

   The partial reduction is serial on every thread rather than split: it is
   `partial_member_count` elements long (owner count, not a tensor axis), and
   every thread needs the same total, so splitting it would only add a shared
   memory round trip. The Triton form's `reduction_width` tiling exists to
   fill a vector lane, which has no analogue here. #}
{% import "entrypoints/_common.cpp.jinja" as entry with context %}
{% if render_calls is defined %}
{% for call in render_calls %}
{% if call.family == "gather_reduce_norm_apply" and call.variant == "sum" %}
static FTT_DEVICE void {{ call.symbol }}({{ entry.device_signature(call) }}) {
{{ entry.mesh_coordinates() }}
{{ entry.thread_identity() }}
{# `tl.num_programs(0)` is the launch's block count, a compile-time constant
   for a C++ package since the grid is fixed in the generated source. #}
    const ftt::dim_t norm_partial_member_count =
        {{ grid_total_blocks }}LL * {{ call.partial_owner_count }}LL
        / {{ call.placement_owner_count }}LL;
    auto *const ftt_partial_stats = {{ call.partial_stats | cppexpr }};
    auto *const ftt_source = {{ call.source | cppexpr }};
    auto *const ftt_scale = {{ call.scale | cppexpr }};
    auto *const ftt_result = {{ call.result | cppexpr }};
{% if call.has_bias %}
    auto *const ftt_bias = {{ call.bias | cppexpr }};
{% endif %}
    const float norm_apply_inner_count = {{ call.normalization_size }}.0f;
    for (ftt::dim_t norm_outer_index = 0;
         norm_outer_index < {{ call.local_outer_capacity }}LL;
         ++norm_outer_index) {
{% if call.use_mean %}
        float norm_apply_mean_sum = 0.0f;
{% endif %}
        float norm_apply_square_sum = 0.0f;
        for (ftt::dim_t norm_partial_lane = 0;
             norm_partial_lane < norm_partial_member_count;
             ++norm_partial_lane) {
            if (!({{ call.outer_active | cppexpr }})) {
                continue;
            }
            const ftt::dim_t norm_partial_owner = {{ call.partial_owner | cppexpr }};
            const ftt::dim_t norm_partial_base =
                norm_partial_owner * {{ call.owner_stride }}LL;
{% if call.use_mean %}
            norm_apply_mean_sum += ftt::to_float(ftt_partial_stats[
                norm_partial_base + ({{ call.partial_stats_sum_offset | cppexpr }})]);
{% endif %}
            norm_apply_square_sum += ftt::to_float(ftt_partial_stats[
                norm_partial_base
                + ({{ call.partial_stats_square_sum_offset | cppexpr }})]);
        }
{% if call.use_mean %}
        const float norm_apply_mean =
            norm_apply_mean_sum / norm_apply_inner_count;
{% else %}
        const float norm_apply_mean = 0.0f;
{% endif %}
        float norm_apply_variance =
            norm_apply_square_sum / norm_apply_inner_count;
{% if call.use_mean %}
        norm_apply_variance -= norm_apply_mean * norm_apply_mean;
{% endif %}
        const float norm_apply_inverse_std = ftt::rsqrt(
            ftt::max(norm_apply_variance, 0.0f) + {{ call.epsilon }}f);
{{ entry.strided_loop("norm_apply_inner_offsets", call.local_inner_capacity) }} {
            if (!(({{ call.outer_active | cppexpr }})
                  && ({{ call.active | cppexpr }}))) {
                continue;
            }
            const float norm_apply_value =
                ftt::to_float(ftt_source[{{ call.source_offset | cppexpr }}]);
            const float norm_apply_scale =
                ftt::to_float(ftt_scale[{{ call.scale_offset | cppexpr }}]);
{% if call.has_bias %}
            const float norm_apply_bias =
                ftt::to_float(ftt_bias[{{ call.bias_offset | cppexpr }}]);
{% else %}
            const float norm_apply_bias = 0.0f;
{% endif %}
            float norm_apply_normalized =
                (norm_apply_value - norm_apply_mean) * norm_apply_inverse_std;
{% if call.round_before_scale %}
            norm_apply_normalized = ftt::to_float(
                ftt::store_as(ftt_source, norm_apply_normalized));
{% endif %}
            const float norm_apply_output =
                norm_apply_normalized * norm_apply_scale + norm_apply_bias;
            if ({{ call.writer_active | cppexpr }}) {
{# Two rounding steps, as in the Triton form: through the input dtype, then
   into the output dtype. #}
                ftt_result[{{ call.result_offset | cppexpr }}] = ftt::store_as(
                    ftt_result,
                    ftt::to_float(
                        ftt::store_as(ftt_source, norm_apply_output)));
            }
        }
    }
}


{% endif %}
{% endfor %}
{% endif %}
