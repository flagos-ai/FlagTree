            if (!address || address % {{ arg.alignment | default(1) }} || address > UINT64_MAX - span) return -2;
            if (frame_bytes && address < reinterpret_cast<uintptr_t>(frame) + frame_bytes &&
                reinterpret_cast<uintptr_t>(frame) < address + span) return -3;
        }
        {{ arg.c_type }} *arg_{{ loop.index0 }} = reinterpret_cast<{{ arg.c_type }} *>(args[{{ loop.index0 }}].payload);
{% else %}
        {{ arg.c_type }} arg_{{ loop.index0 }};
        std::memcpy(&arg_{{ loop.index0 }}, &args[{{ loop.index0 }}].payload, sizeof(arg_{{ loop.index0 }}));
{% endif %}
{% endfor %}
{% if p.launch_kind == 'cooperative' %}
        if (!scratch || scratch_bytes != {{ p.launch_scratch.nbytes }} || reinterpret_cast<uintptr_t>(scratch) % 4) return -3;
{% else %}
