struct _FlagmegaEpochRow { uint32_t entry; uint64_t scratch_bytes, reset_bytes; };
static constexpr _FlagmegaEpochRow _flagmega_epoch_rows[] = {
{% for row in cpp_counter_epoch_plan.rows %}
{% set reset = cpp_counter_epoch_plan.resets | selectattr('ordinal', 'equalto', row.ordinal) | list %}
    { {{ row.entry_id }}, {{ cpp_programs.entries[row.entry_id].scratch_nbytes }}, {{ reset[0].nbytes if reset else 0 }} },
