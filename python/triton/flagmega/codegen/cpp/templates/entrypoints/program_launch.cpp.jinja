extern "C" int flagmega_launch_counter_epoch_plan_v1(const char *plan_sha256,
    const FlagmegaProgramRow *rows, uint32_t row_count, void *stream,
    void *scratch, uint64_t scratch_bytes, FlagmegaPlanResult *out) {
    if (!out || reinterpret_cast<uintptr_t>(out) % alignof(FlagmegaPlanResult) ||
        out->version != 1 || out->record_bytes != sizeof(*out)) return -1;
    *out = {1, sizeof(*out), 0, 1, -1, 0, 0, 0};
    if (!plan_sha256 || std::strcmp(plan_sha256, "{{ cpp_counter_epoch_plan.plan_sha256 }}") ||
        row_count != {{ cpp_counter_epoch_plan.rows | length }} || !rows ||
        reinterpret_cast<uintptr_t>(rows) % alignof(FlagmegaProgramRow) ||
        !scratch || reinterpret_cast<uintptr_t>(scratch) % 4 ||
        scratch_bytes != {{ cpp_counter_epoch_plan.frame_nbytes }} ||
        reinterpret_cast<uintptr_t>(scratch) > UINT64_MAX - scratch_bytes) return -1;
    // Every late row is checked before the first reset/launch. No CUDA here.
    for (uint32_t i = 0; i < row_count; ++i) {
        out->ordinal = i;
        if (rows[i].reserved) return -1;
        const auto &p = _flagmega_epoch_rows[i];
        int status = _flagmega_launch_program_impl(p.entry, rows[i].args, rows[i].arg_count,
            stream, p.scratch_bytes ? scratch : nullptr, p.scratch_bytes, nullptr,
            true, false, scratch, scratch_bytes);
        if (status) { out->status = status; return status; }
    }
    for (uint32_t i = 0; i < row_count; ++i) {
        out->ordinal = i;
        const auto &p = _flagmega_epoch_rows[i];
        if (p.reset_bytes) {
            out->stage = 2;
            int status = (int)cudaMemsetAsync(scratch, 0, p.reset_bytes, (cudaStream_t)stream);
            if (status) { out->status = status; return status; }
        }
        out->stage = 3;
        int status = _flagmega_launch_program_impl(p.entry, rows[i].args, rows[i].arg_count,
            stream, p.scratch_bytes ? scratch : nullptr, p.scratch_bytes, nullptr, false, false);
        if (status) { out->status = status; return status; }
        ++out->submitted;
    }
    out->ordinal = row_count;
    out->stage = 4;
    out->status = 0;
    return 0;
}
