        _fm_loop_mask = (_fm_loop_offsets < {{ event.capacity }}) & ({{ event.active }})
{% if event.source is not none %}
        _fm_loop_value = tl.load({{ event.source }} + ({{ event.source_offset }}), mask=_fm_loop_mask, other=0)
{% else %}
        _fm_loop_value = {{ event.value }}
{% endif %}
        tl.store({{ event.result }} + ({{ event.result_offset }}), _fm_loop_value, mask=_fm_loop_mask & ({{ event.writer_active }}))
{% else %}
{% if event.barrier_before %}
{{ scoped_barrier(event.barrier_scope | default("grid"), event.barrier_axis_group_key | default(none)) }}
{% endif %}
    # tir.call {{ event.call }} -> {{ event.family }}/{{ event.variant }} ({{ event.execution_kind }})
{% if event.trace_site is defined and event.participation_active | default("True") != "True" %}
{% if event.trace_execution_domain is not defined %}
{{ require_codegen(false, "Nonuniform caller markers require a checked execution domain.") }}
{% endif %}
    if {{ event.participation_active }}:
        tle.gpu.trace_event(272, {{ event.trace_site }}, {{ event.trace_layer }})
        {{ event.symbol }}{% if producer_bank is not none %}_{{ producer_bank }}{% endif %}({{ event.arguments }}{% if bounded_prefetch %}, _prefetch_progress{% endif %})
        tle.gpu.trace_event(273, {{ event.trace_site }}, {{ event.trace_layer }})
{% else %}
{% if event.trace_site is defined %}
    tle.gpu.trace_event(272, {{ event.trace_site }}, {{ event.trace_layer }})
{% endif %}
{% if event.participation_active | default("True") != "True" %}    if {{ event.participation_active }}:
        {{ event.symbol }}{% if producer_bank is not none %}_{{ producer_bank }}{% endif %}({{ event.arguments }}{% if bounded_prefetch %}, _prefetch_progress{% endif %})
{% else %}    {{ event.symbol }}{% if producer_bank is not none %}_{{ producer_bank }}{% endif %}({{ event.arguments }}{% if bounded_prefetch %}, _prefetch_progress{% endif %})
{% endif %}
{% if event.trace_site is defined %}
    tle.gpu.trace_event(273, {{ event.trace_site }}, {{ event.trace_layer }})
{% endif %}
{% endif %}
{% endif %}
