            dtype={{ workspace.dtype }},
            layout=None,
            scope=tle.gpu.smem,
            alias=_flagmega_shared_arena,
            alias_offset_bytes={{ workspace.offset_bytes + phase * 32 }},
            nv_mma_shared_layout={{ "True" if workspace.matrix_compatible else "False" }},
        )
{% endfor %}
{% else %}
    {{ workspace.variable }} = tle.gpu.alloc(
        [{{ workspace.shape | join(", ") }}],
        dtype={{ workspace.dtype }},
        layout=None,
        scope=tle.gpu.smem,
        alias=_flagmega_shared_arena,
        alias_offset_bytes={{ workspace.offset_bytes }},
        nv_mma_shared_layout={{ "True" if workspace.matrix_compatible else "False" }},
    )
{% endif %}
{% endfor %}
{% if single_epoch %}
    _paired_pipe_{{ stage.id | replace("-", "_") }} = tle.pipe(
        capacity={{ stage.channels[0].capacity }}, scope="cta", name="{{ stage.id }}/gate_up",
{% for channel in stage.channels %}{% for field in channel.fields %}
        {{ field.name }}={{ field.workspace.variable }},
{% endfor %}{% endfor %}
    )
{% for channel in stage.channels %}
    {{ channel.reader_name }} = tle.gpu.types.paired_bank_endpoint(_paired_pipe_{{ stage.id | replace("-", "_") }}, "{{ channel.name }}")
    {{ channel.writer_name }} = (tle.gpu.types.paired_bank_endpoint(_paired_pipe_{{ stage.id | replace("-", "_") }}, "{{ channel.name }}", writer=True), {{ channel.fields[0].workspace.variable }}__raw)
{% endfor %}
{% else %}
{% for channel in stage.channels %}
{% if named_transport %}
{% if loop.first %}
    _transport_ready = tle.gpu.alloc_barrier(arrive_count=160)
    _transport_free = tle.gpu.alloc_barrier(arrive_count=160)
{% endif %}
    {{ channel.reader_name }} = ({{ channel.fields[0].workspace.variable }}, _transport_ready, _transport_free)
    {{ channel.writer_name }} = {{ channel.reader_name }}
{% else %}
