{# The entrypoint owns only call/event scheduling and shared pipeline resource
   construction.  Selected TIR templates own every algorithm wrapper. #}
{% import "entrypoints/_common.py.jinja" as entry with context %}

{% macro stage_barrier(axis_group_key=none) -%}{{ entry.stage_barrier(axis_group_key) }}{%- endmacro %}

{% macro runtime_device_context() -%}
{% if device_context_abi | default(none) in ("runtime-handles/v1", "runtime-handles/v2") %}
    device_dptr = (device_mem_ptr, device_comm_ptr)
{% endif %}
{%- endmacro %}

{% macro scoped_barrier(scope, axis_group_key=none) -%}
{% if scope == "device" %}{{ entry.device_barrier() }}
{% elif scope == "grid" %}{{ stage_barrier(axis_group_key) }}
{% else %}    tl.debug_barrier()
{% endif %}{%- endmacro %}

{% macro pipeline_role_events(events) -%}
{% if not events %}
    pass
{% else %}
{% for event in events %}
{% if event.kind == "barrier" %}
{{ scoped_barrier(event.scope, event.barrier_axis_group_key | default(none)) }}
{% elif event.kind == "handoff" %}
{% if event.acquire | default(false) %}
    {# A reusable slot must be acquired before it is committed: with capacity
       1 the next trip's commit has to wait for the previous trip's release,
       and only `acquire` performs that wait. #}
    {{ event.endpoint }}.acquire({{ event.index | default("0") }})
{% endif %}
    {{ event.endpoint }}.{{ event.action }}({{ event.index | default("0") }})
{% if event.release | default(false) %}
    {{ event.endpoint }}.release({{ event.index | default("0") }})
{% endif %}
{% elif event.kind == "pipe_close" %}
    {{ event.endpoint }}.close({{ event.iteration }})
{% elif event.kind == "drain" %}
{% for endpoint in event.endpoints %}
    {{ endpoint }}.pipe.wait_drained()
{% endfor %}
{% elif event.kind == "function_call" %}
    # tir.call {{ event.call }} -> @{{ event.callee }}
{% if event.participation_active | default("True") != "True" %}    if {{ event.participation_active }}:
        {{ event.symbol }}({{ event.arguments }})
{% else %}    {{ event.symbol }}({{ event.arguments }})
{% endif %}
{% elif event.kind == "loop" %}
    # control.for @{{ event.body_function }} over [{{ event.start }}, {{ event.stop }}) step {{ event.step }}
    for {{ event.loop_var }} in tl.range({{ event.start }}, {{ event.stop }}, {{ event.step }}):
{{ pipeline_role_events(event.events) | indent(4, true) }}
{% else %}
{% if event.barrier_before %}
{{ scoped_barrier(event.barrier_scope | default("grid"), event.barrier_axis_group_key | default(none)) }}
{% endif %}
    # tir.call {{ event.call }} -> {{ event.family }}/{{ event.variant }} ({{ event.execution_kind }})
{% if event.participation_active | default("True") != "True" %}    if {{ event.participation_active }}:
        {{ event.symbol }}({{ event.arguments }})
{% else %}    {{ event.symbol }}({{ event.arguments }})
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{%- endmacro %}

{% for definition in device_functions | default(()) %}
@triton.jit(noinline=True)
def {{ definition.symbol }}__consumer(
    {{ (definition.schedule.consumer_endpoints + (definition.typed_signature_arguments | default(definition.signature_arguments))) | join(",\n    ") }}
):
{{ entry.mesh_coordinates() }}
{{ pipeline_role_events(definition.schedule.consumer_events) }}


{% if definition.schedule.producer_events %}
@triton.jit(noinline=True)
def {{ definition.symbol }}__producer(
    {{ (definition.schedule.producer_endpoints + (definition.typed_signature_arguments | default(definition.signature_arguments))) | join(",\n    ") }}
):
{{ entry.mesh_coordinates() }}
{{ pipeline_role_events(definition.schedule.producer_events) }}


{% endif %}
{% if definition.schedule.auxiliary_events %}
@triton.jit(noinline=True)
def {{ definition.symbol }}__auxiliary_consumer(
    {{ (definition.schedule.auxiliary_endpoints + (definition.typed_signature_arguments | default(definition.signature_arguments))) | join(",\n    ") }}
):
{{ entry.mesh_coordinates() }}
{{ pipeline_role_events(definition.schedule.auxiliary_events) }}


{% endif %}
{% endfor %}
{% if pipeline_schedule | default(none) %}
@triton.jit
def {{ symbol }}__consumer(
    {{ (pipeline_schedule.consumer_endpoints + (typed_signature_arguments | default(signature_arguments))) | join(",\n    ") }}
):
{{ runtime_device_context() }}
{{ entry.mesh_coordinates() }}
{{ pipeline_role_events(pipeline_schedule.consumer_events) }}


@triton.jit
def {{ symbol }}__producer(
    {{ (pipeline_schedule.producer_endpoints + (typed_signature_arguments | default(signature_arguments))) | join(",\n    ") }}
):
{{ runtime_device_context() }}
{{ entry.mesh_coordinates() }}
{{ pipeline_role_events(pipeline_schedule.producer_events) }}


{% if pipeline_schedule.auxiliary_events %}
@triton.jit
def {{ symbol }}__auxiliary_consumer(
    {{ (pipeline_schedule.auxiliary_endpoints + (typed_signature_arguments | default(signature_arguments))) | join(",\n    ") }}
):
{{ runtime_device_context() }}
{{ entry.mesh_coordinates() }}
{{ pipeline_role_events(pipeline_schedule.auxiliary_events) }}


{% endif %}
{% if scalar_arguments | default(()) %}
@triton.jit(do_not_specialize={{ scalar_arguments }})
{% else %}
@triton.jit
{% endif %}
def {{ symbol }}(
    {{ signature }}
):
    _flagmega_shared_arena = tle.gpu.alloc(
        [{{ pipeline_schedule.shared_arena_nbytes }}],
        dtype=tl.uint8,
        layout=None,
        scope=tle.gpu.smem,
        nv_mma_shared_layout=False,
        alignment_bytes={{ pipeline_schedule.shared_arena_alignment_bytes }},
    )
{% for stage in pipeline_schedule.stages %}
{% for workspace in stage.workspaces %}
    {{ workspace.variable }} = tle.gpu.alloc(
        [{{ workspace.shape | join(", ") }}],
        dtype={{ workspace.dtype }},
        layout=None,
        scope=tle.gpu.smem,
        alias=_flagmega_shared_arena,
        alias_offset_bytes={{ workspace.offset_bytes }},
        nv_mma_shared_layout={{ "True" if workspace.matrix_compatible else "False" }},
    )
{% endfor %}
{% for channel in stage.channels %}
    {{ channel.pipe_name }} = tle.pipe(
        capacity={{ channel.capacity }},
        scope="cta",
        name="{{ stage.id }}/{{ channel.name }}",
{% for field in channel.fields %}
        {{ field.name }}={{ field.workspace.variable }},
{% endfor %}
    )
    {{ channel.reader_name }} = {{ channel.pipe_name }}.reader()
    {{ channel.writer_name }} = {{ channel.pipe_name }}.writer()
{% endfor %}
{% endfor %}
{% for handoff in pipeline_schedule.handoffs %}
{# A wrap-around handoff's wait and commit are one index apart: the trip's
   producer waits on index i while its consumer commits index i+1 for the
   next trip.  With capacity 1 both indices map to slot 0, so the commit
   overwrites the slot being waited on; two slots keep them apart. #}
    {{ handoff.pipe_name }} = tle.pipe(
        capacity={{ 2 if handoff.wrap_around | default(false) else 1 }},
        scope="cta",
        name="{{ handoff.id }}",
{% if handoff.repeated | default(false) %}
    )
{% else %}
        one_shot=True,
    )
{% endif %}
    {{ handoff.reader_name }} = {{ handoff.pipe_name }}.reader()
    {{ handoff.writer_name }} = {{ handoff.pipe_name }}.writer()
{% endfor %}
    tle.gpu.warp_specialize(
        [
            (
                {{ symbol }}__consumer,
                (
                    {{ (pipeline_schedule.consumer_endpoints + signature_arguments) | join(",\n                    ") }},
                ),
            ),
{% if pipeline_schedule.auxiliary_events %}
            (
                {{ symbol }}__auxiliary_consumer,
                (
                    {{ (pipeline_schedule.auxiliary_endpoints + signature_arguments) | join(",\n                    ") }},
                ),
            ),
{% endif %}
            (
                {{ symbol }}__producer,
                (
                    {{ (pipeline_schedule.producer_endpoints + signature_arguments) | join(",\n                    ") }},
                ),
            ),
        ],
        [{% if pipeline_schedule.auxiliary_events %}{{ pipeline_schedule.auxiliary_consumer_warps }}, {% endif %}{{ pipeline_schedule.producer_warps }}],
        [{% if pipeline_schedule.auxiliary_events %}{{ pipeline_schedule.auxiliary_consumer_registers }}, {% endif %}{{ pipeline_schedule.producer_registers }}],
    )
{% else %}
{% if scalar_arguments | default(()) %}
@triton.jit(do_not_specialize={{ scalar_arguments }})
{% else %}
@triton.jit
{% endif %}
def {{ symbol }}(
    {{ signature }}
):
{{ runtime_device_context() }}
{{ entry.mesh_coordinates() }}
{{ pipeline_role_events(entry_events) }}
{% endif %}
