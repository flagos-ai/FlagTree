        scope=tle.gpu.smem,
        nv_mma_shared_layout=False,
        alignment_bytes={{ pipeline_schedule.shared_arena_alignment_bytes }},
    )
{% for stage in pipeline_schedule.stages %}
{% for workspace in stage.workspaces %}
{% if cp_aligned %}
    {{ workspace.variable }}__raw = tle.gpu.alloc(
        [{{ workspace.shape | join(", ") }}], dtype={{ workspace.dtype }},
        layout=None, scope=tle.gpu.smem, alias=_flagmega_shared_arena,
        alias_offset_bytes={{ workspace.offset_bytes }}, nv_mma_shared_layout=True,
    )
{% endif %}
{% if cp_phase and workspace.shape[-2] != 32 %}
    # Match the global 2720 B row's 128 B phase; relative consumer geometry is unchanged.
{% for phase in range(4) %}
    {{ 'else:' if loop.last else ('if' if loop.first else 'elif') ~ ' (tl.program_id(0) * ' ~ cp_phase[0].rows_per_transaction ~ ') % 4 == ' ~ phase ~ ':' }}
        {{ workspace.variable }} = tle.gpu.alloc(
