    tl.store(tle.gpu.local_ptr(_prefetch_progress,(tl.full((),2,tl.int32),)),0)
    tl.store(tle.gpu.local_ptr(_prefetch_progress,(tl.full((),3,tl.int32),)),-1)
    tl.store(tle.gpu.local_ptr(_prefetch_progress,(tl.full((),5,tl.int32),)),-1)
    tl.store(tle.gpu.local_ptr(_prefetch_progress,(tl.full((),6,tl.int32),)),0)
{% endif %}
{% if no_shared or render_calls | selectattr('cross_layers','defined') | list %}
