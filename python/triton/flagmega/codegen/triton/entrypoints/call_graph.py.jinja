    tl.store(tle.gpu.local_ptr(_prefetch_progress,(tl.full((),10,tl.int32),)),0)
{% if render_calls[0].cross_lookahead_rows | default(0) %}
    tl.store(tle.gpu.local_ptr(_prefetch_progress,(tl.full((),11,tl.int32),)),0)
{% endif %}
{% endif %}
{% if no_shared %}
