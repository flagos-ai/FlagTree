{% endfor %}
{% endif %}
        ],
        [{% if pipeline_schedule.auxiliary_events %}{{ pipeline_schedule.auxiliary_consumer_warps }}, {% endif %}{% if pipeline_schedule.producer_warps == 2 %}1, 1{% else %}{{ pipeline_schedule.producer_warps }}{% endif %}{% if padding_prefetch %}, 2, 1{% endif %}],
