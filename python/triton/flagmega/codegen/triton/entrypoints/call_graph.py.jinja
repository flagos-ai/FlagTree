            ),
{% if pipeline_schedule.auxiliary_events %}
            (
                {{ symbol }}__auxiliary_consumer,
                (
                    {{ (pipeline_schedule.auxiliary_endpoints + signature_arguments) | join(",\n                    ") }},
                ),
            ),
{% endif %}
{% for bank in (('gate','up') if pipeline_schedule.producer_warps == 2 else (none,)) %}
            (
                {{ symbol }}__producer{% if bank is not none %}_{{ bank }}{% endif %},
                (
                    {{ (pipeline_schedule.producer_endpoints + signature_arguments + (['_prefetch_progress'] if bounded_prefetch else [])) | join(",\n                    ") }},
                ),
            ),
{% endfor %}
{% if padding_prefetch %}
{% for nw in (2,1) %}
