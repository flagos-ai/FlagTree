{% macro scoped_barrier(scope, axis_group_key=none, census=none) -%}
{% if scope == "device" %}{{ entry.device_barrier() }}
{% elif scope == "grid" %}{{ stage_barrier(axis_group_key, census) }}
{% else %}    tl.debug_barrier()
{% endif %}{%- endmacro %}

{% macro pipeline_role_events(events, producer_bank=none) -%}
{% if not events %}
