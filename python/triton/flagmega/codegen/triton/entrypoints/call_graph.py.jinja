{% endfor %}
{% if no_shared %}
{% for stage in pipeline_schedule.stages %}{% for channel in stage.channels %}
    {{ channel.reader_name }} = tl.full((),0,tl.int32)
    {{ channel.writer_name }} = tl.full((),0,tl.int32)
{% endfor %}{% endfor %}
{% else %}
