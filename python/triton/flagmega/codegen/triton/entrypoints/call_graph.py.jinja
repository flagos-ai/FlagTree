{% if cp_aligned %}
    {{ channel.writer_name }} = ({{ channel.pipe_name }}.writer(), {{ channel.fields[0].workspace.variable }}__raw)
{% else %}
    {{ channel.writer_name }} = {{ channel.pipe_name }}.writer()
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
