# flagmega-kernel: rope/decode
{% if render_calls is defined %}
{% include "kernels/rope/_function.py.jinja" %}
{% endif %}
@triton.jit
def _flagmega_rope(
    source,
    cosine,
    sine,
    destination,
    element_count: tl.constexpr,
    sequence_size: tl.constexpr,
    num_heads: tl.constexpr,
    head_dim: tl.constexpr,
    sequence_stride: tl.constexpr,
    head_stride: tl.constexpr,
    dimension_stride: tl.constexpr,
    elements_per_program: tl.constexpr,
    rotary_dim: tl.constexpr = None,
):
    """Apply rotary position embedding to an arbitrary sequence/head layout."""
    extent: tl.constexpr = head_dim if rotary_dim is None else rotary_dim
    program = tl.program_id(0)
    linear = program * elements_per_program + tl.arange(0, elements_per_program)
    mask = linear < element_count
    dimension = linear % head_dim
    rotary_mask = mask & (dimension < extent)
    canonical_head = (linear // head_dim) % num_heads
    sequence = linear // (num_heads * head_dim)
    source_offset = (
        sequence * sequence_stride
        + canonical_head * head_stride
        + dimension * dimension_stride
    )
    partner_dimension = tl.where(
        dimension < extent // 2,
        dimension + extent // 2,
        dimension - extent // 2,
    )
    partner_offset = (
        sequence * sequence_stride
        + canonical_head * head_stride
        + partner_dimension * dimension_stride
    )
    raw_value = tl.load(source + source_offset, mask=mask, other=0.0)
    value = raw_value.to(tl.float32)
    partner = tl.load(
        source + partner_offset, mask=rotary_mask, other=0.0
    ).to(tl.float32)
    rotated = tl.where(dimension < extent // 2, -partner, partner)
    frequency_offset = sequence * extent + dimension
    cos_value = tl.load(
        cosine + frequency_offset, mask=rotary_mask, other=0.0
    ).to(tl.float32)
    sin_value = tl.load(
        sine + frequency_offset, mask=rotary_mask, other=0.0
    ).to(tl.float32)
    cosine_product = libdevice.mul_rn(value, cos_value)
    sine_product = libdevice.mul_rn(rotated, sin_value)
    tl.store(
        destination + source_offset,
        tl.where(dimension < extent, (cosine_product + sine_product).to(raw_value.dtype), raw_value),
        mask=mask,
    )
