# flagmega-kernel: matmul_glu/mma platform=nvidia architecture=sm90
{% set matmul_glu_variant = "mma" %}
@triton.jit
def _flagmega_block_glu_local_tile(
    source, gate_weight, up_weight, gate_scale, up_scale, destination,
    weight_row_offsets, scale_row_offsets, destination_offsets, n_mask,
    K: tl.constexpr, BLOCK_K: tl.constexpr,
):
    """Compute one dense local-N GLU tile using ABI-provided row offsets."""
    gate_accumulator = tl.zeros(({{ tn }},), tl.float32)
    up_accumulator = tl.zeros(({{ tn }},), tl.float32)
    gate_compensation = tl.zeros(({{ tn }},), tl.float32)
    up_compensation = tl.zeros(({{ tn }},), tl.float32)
    for k_start in tl.range(0, K, BLOCK_K):
        k_offsets = k_start + tl.arange(0, BLOCK_K)
        source_value = tl.load(
            source + k_offsets, mask=k_offsets < K, other=0.0,
        ).to(tl.float32)
        maximum = tl.max(tl.abs(source_value), axis=0)
        activation_scale = tl.where(maximum == 0.0, 1.0, maximum / 448.0)
        quantized = tl.maximum(
            tl.minimum(source_value / activation_scale, 448.0), -448.0,
        ).to(tl.float8e4nv)
        scale_offset = scale_row_offsets + (k_start // BLOCK_K)
        gate_block_scale = tl.load(
            gate_scale + scale_offset, mask=n_mask, other=0.0,
        ).to(tl.float32)
        up_block_scale = tl.load(
            up_scale + scale_offset, mask=n_mask, other=0.0,
        ).to(tl.float32)
        if BLOCK_K >= 16:
            activation_matrix = tl.broadcast_to(quantized[None, :], (16, BLOCK_K))
            weight_offsets = k_offsets[:, None] + weight_row_offsets[None, :]
            mask = (k_offsets[:, None] < K) & n_mask[None, :]
            gate_matrix = tl.load(gate_weight + weight_offsets, mask=mask, other=0.0)
            up_matrix = tl.load(up_weight + weight_offsets, mask=mask, other=0.0)
            gate_partial = tl.sum(
                tl.dot(activation_matrix, gate_matrix, out_dtype=tl.float32), axis=0,
            ) * 0.0625 * activation_scale * gate_block_scale
            up_partial = tl.sum(
                tl.dot(activation_matrix, up_matrix, out_dtype=tl.float32), axis=0,
            ) * 0.0625 * activation_scale * up_block_scale
        else:
            dequantized = quantized.to(tl.float32) * activation_scale
            weight_offsets = weight_row_offsets[:, None] + k_offsets[None, :]
            mask = n_mask[:, None] & (k_offsets[None, :] < K)
            gate_value = tl.load(
                gate_weight + weight_offsets, mask=mask, other=0.0,
            ).to(tl.float32)
            up_value = tl.load(
                up_weight + weight_offsets, mask=mask, other=0.0,
            ).to(tl.float32)
            gate_partial = tl.sum(
                gate_value * dequantized[None, :], axis=1,
            ) * gate_block_scale
            up_partial = tl.sum(
                up_value * dequantized[None, :], axis=1,
            ) * up_block_scale
        gate_corrected = gate_partial - gate_compensation
        gate_updated = gate_accumulator + gate_corrected
        gate_compensation = (gate_updated - gate_accumulator) - gate_corrected
        gate_accumulator = gate_updated
        up_corrected = up_partial - up_compensation
        up_updated = up_accumulator + up_corrected
        up_compensation = (up_updated - up_accumulator) - up_corrected
        up_accumulator = up_updated
    gate_bf16 = gate_accumulator.to(tl.bfloat16).to(tl.float32)
    up_bf16 = up_accumulator.to(tl.bfloat16).to(tl.float32)
    tl.store(
        destination + destination_offsets,
        (_flagmega_silu(gate_bf16).to(tl.bfloat16).to(tl.float32) * up_bf16).to(tl.bfloat16),
        mask=n_mask,
    )
