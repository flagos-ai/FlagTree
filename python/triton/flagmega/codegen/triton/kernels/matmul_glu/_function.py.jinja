{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "matmul_glu" and call.variant == matmul_glu_variant %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{% if call.weight_encoding in ("IQ4_XS", "Q4_K") %}
{% set native_activation = native_gguf_activation_prologue is defined and call.weight_encoding == "IQ4_XS" %}
{% if native_activation %}
{% include native_gguf_activation_prologue %}
{% endif %}
{% set native_tiles = (call.local_n_capacity + call.tile_n - 1) // call.tile_n %}
{% if native_gguf_rotate_tiles is defined and native_gguf_rotate_tiles and native_tiles > 1 %}
    for local_n_tile in tl.range(0, {{ native_tiles }}):
        local_n_start = (((local_n_tile + shard_index) % {{ native_tiles }}) * {{ call.tile_n }}).to(tl.int32)
{% else %}
    for local_n_start in tl.range(0, {{ call.local_n_capacity }}, {{ call.tile_n }}):
{% endif %}
        local_n_offsets = local_n_start + tl.arange(0, {{ call.tile_n }})
        n_mask = local_n_offsets < ({{ call.active_n }})
        weight_rows = {{ call.weight_row_offset }}
        destination_offsets = {{ call.destination_offset }}
{% if call.weight_encoding == "IQ4_XS" %}
{% set native_extra = (", " ~ native_gguf_activation_arguments) if native_activation else "" %}
        gate = _flagmega_iq4_xs_dot({{ call.value }}, {{ call.gate_weight }}, weight_rows, n_mask, {{ call.k }}{{ native_extra }})
        up = _flagmega_iq4_xs_dot({{ call.value }}, {{ call.up_weight }}, weight_rows, n_mask, {{ call.k }}{{ native_extra }})
{% else %}
        gate = _flagmega_q4_k_dot({{ call.value }}, {{ call.gate_weight }}, weight_rows, n_mask, {{ call.k }})
        up = _flagmega_q4_k_dot({{ call.value }}, {{ call.up_weight }}, weight_rows, n_mask, {{ call.k }})
{% endif %}
        tl.store({{ call.result }} + destination_offsets, (_flagmega_silu(gate) * up).to(tl.bfloat16), mask=n_mask)
{% else %}
    for local_n_start in tl.range(
        0, {{ call.local_n_capacity }}, {{ call.tile_n }}
    ):
        local_n_offsets = local_n_start + tl.arange(0, {{ call.tile_n }})
        n_mask = local_n_offsets < ({{ call.active_n }})
        weight_rows = {{ call.weight_row_offset }}
        up_weight_rows = {{ call.up_weight_row_offset }}
        scale_rows = {{ call.scale_row_offset }}
        destination_offsets = {{ call.destination_offset }}
        _flagmega_block_glu_local_tile(
            {{ call.value }}, {{ call.gate_weight }}, {{ call.up_weight }},
            {{ call.gate_scale }}, {{ call.up_scale }}, {{ call.result }},
            weight_rows, up_weight_rows, scale_rows, destination_offsets, n_mask,
            {{ call.k }}, {{ call.block_k }},
            {{ call.gate_clamp_max }}, {{ call.up_clamp }},
            "{{ call.activation_quantization }}",
{% if call.variant == "mma" %}
            "{{ call.scaled_accumulation | default('compensated') }}",
{% endif %}
        )
{% endif %}


{% endif %}
{% endfor %}
