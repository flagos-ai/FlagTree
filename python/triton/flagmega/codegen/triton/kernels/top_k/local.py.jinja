                _fm_offsets = _fm_start + tl.arange(0, {{ call.tile }})
                _fm_active = (_fm_offsets < {{ call.capacity }}) & ({{ call.active }})
                _fm_candidates = tl.load({{ call.source }} + ({{ call.source_offset }}), mask=_fm_active, other=0).to({{ call.scalar_type }})
                _fm_nans = _fm_candidates != _fm_candidates
{% if call.largest %}
                _fm_follows = tl.where(_fm_previous_nan, (~_fm_nans) | (_fm_offsets > _fm_previous_index),
