                _fm_tile_nan = (tl.sum((_fm_available & _fm_nans).to(tl.int32), 0) > 0) & (tl.sum((_fm_available & ~_fm_nans).to(tl.int32), 0) == 0)
                _fm_tile_value = tl.min(tl.where(_fm_available & ~_fm_nans, _fm_candidates, tl.full((), {{ call.sentinel }}, {{ call.scalar_type }})), 0)
{% endif %}
                _fm_matching = _fm_available & tl.where(_fm_tile_nan, _fm_nans, ~_fm_nans & (_fm_candidates == _fm_tile_value))
                _fm_tile_index = tl.min(tl.where(_fm_matching, _fm_offsets.to(tl.int64), 9223372036854775807), 0)
