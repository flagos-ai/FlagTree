# flagmega-kernel: sparse_experts_gate_up/wgmma platform=nvidia architecture=sm90
{% import "entrypoints/_common.py.jinja" as entry with context %}
{% include "kernels/_ue8m0_quantization.py.jinja" %}
{% for call in render_calls | default(()) %}
{% if call.family == "sparse_experts_gate_up" and call.variant == "wgmma" %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for _fm_token in tl.range(0, {{ call.tokens }}):
        for _fm_route in tl.range(0, {{ call.routes }}):
            _fm_expert = tl.load({{ call.pointers.router_expert_ids }} + ({{ call.expert_offset }}), mask={{ call.slot_active }}, other=0).to(tl.int64)
            _fm_gate_input_scale = {{ call.scale_loads.gate_input_scale }}
            _fm_up_input_scale = {{ call.scale_loads.up_input_scale }}
            for _fm_n_start in tl.range(0, {{ call.scalar_n }}, 64):
                _fm_n = _fm_n_start + tl.arange(0, 64)
                _fm_n_mask = (_fm_n < {{ call.scalar_n }}) & ({{ call.n_active }}) & ({{ call.slot_active }})
                _fm_gate_acc = tl.zeros((64, 16), tl.float32)
                _fm_up_acc = tl.zeros((64, 16), tl.float32)
                for _fm_k_start in tl.range(0, {{ call.scalar_k }}, 128):
                    _fm_k = _fm_k_start + tl.arange(0, 128)
                    _fm_k_mask = (_fm_k < {{ call.scalar_k }}) & ({{ call.k_active }}) & ({{ call.slot_active }})
                    _fm_input = tl.load({{ call.input_pointer }} + ({{ call.q_offset }}), mask=_fm_k_mask, other=0.).to(tl.float32)
                    _fm_quantized, _fm_activation_scale = _flagmega_quantize_ue8m0(_fm_input, 0)
                    _fm_a = tl.broadcast_to(_fm_quantized.to(tl.float8e4nv)[:, None], (128, 16))
                    _fm_gate = tl.load({{ call.pointers.gate_weight }} + ({{ call.gate_offset }}), mask=_fm_n_mask[:, None] & _fm_k_mask[None, :], other=0.)
                    _fm_up = tl.load({{ call.pointers.up_weight }} + ({{ call.up_offset }}), mask=_fm_n_mask[:, None] & _fm_k_mask[None, :], other=0.)
                    _fm_gate_scale = {{ call.block_scale_loads.gate_proj_scale }}
                    _fm_up_scale = {{ call.block_scale_loads.up_proj_scale }}
                    # Weight rows form WGMMA's M axis. Reset the raw FP8 dot
                    # at each scale block, then apply B scale before A scale.
                    _fm_gate_acc += tl.dot(_fm_gate, _fm_a) * _fm_gate_scale * _fm_activation_scale
                    _fm_up_acc += tl.dot(_fm_up, _fm_a) * _fm_up_scale * _fm_activation_scale
                _fm_gate_result = tl.reshape(tl.gather(_fm_gate_acc, tl.full((64, 1), 0, tl.int32), 1), (64,)) * _fm_gate_input_scale
                _fm_up_result = tl.reshape(tl.gather(_fm_up_acc, tl.full((64, 1), 0, tl.int32), 1), (64,)) * _fm_up_input_scale
{% if call.attrs.round_projections %}
                _fm_gate_result = _fm_gate_result.to({{ call.output_dtype }}).to(tl.float32)
                _fm_up_result = _fm_up_result.to({{ call.output_dtype }}).to(tl.float32)
{% endif %}
{% if call.attrs.gate_clamp_max is not none %}
                _fm_gate_result = tl.minimum(_fm_gate_result, {{ call.attrs.gate_clamp_max }})
{% endif %}
{% if call.attrs.up_clamp is not none %}
                _fm_up_result = tl.clamp(_fm_up_result, -{{ call.attrs.up_clamp }}, {{ call.attrs.up_clamp }})
{% endif %}
                _fm_activation = _fm_gate_result * tl.sigmoid(_fm_gate_result)
{% if call.attrs.round_activation %}
                _fm_activation = _fm_activation.to({{ call.output_dtype }}).to(tl.float32)
{% endif %}
                tl.store({{ call.result }} + ({{ call.result_offset }}), _fm_activation * _fm_up_result, mask=_fm_n_mask & ({{ call.writer_active }}))
{% endif %}
{% endfor %}
