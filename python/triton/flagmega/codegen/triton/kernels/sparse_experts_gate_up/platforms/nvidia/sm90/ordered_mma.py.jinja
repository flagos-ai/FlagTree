# flagmega-kernel: sparse_experts_gate_up/ordered_mma platform=nvidia architecture=sm90
{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls | default(()) %}
{% if call.family == "sparse_experts_gate_up" and call.variant == "ordered_mma" %}
import triton.experimental.tle.language as tle
{{ call.symbol }}__mma = tl.constexpr(tle.gpu.MmaEncoding([2, 0], [1, {{ num_warps }}], [16, 8]))
{{ call.symbol }}__lhs = tl.constexpr(tle.gpu.DotOperandEncoding(0, {{ call.symbol }}__mma, 2))
{{ call.symbol }}__rhs = tl.constexpr(tle.gpu.DotOperandEncoding(1, {{ call.symbol }}__mma, 2))
{{ call.symbol }}__load = tl.constexpr(tle.gpu.BlockEncoding([1, 2], [4, 8], [{{ [num_warps, call.block_n // 4] | min }}, {{ num_warps // ([num_warps, call.block_n // 4] | min) }}], [1, 0]))
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for _fm_token in tl.range(0, {{ call.tokens }}):
        for _fm_route in tl.range(0, {{ call.routes }}):
            _fm_expert = tl.load({{ call.pointers.router_expert_ids }} + ({{ call.expert_offset }}), {{ call.slot_active }}, other=0).to(tl.int64)
            _fm_gate_scale = {{ call.scale_loads.gate_proj_scale }}
            _fm_up_scale = {{ call.scale_loads.up_proj_scale }}
            for _fm_n_start in tl.range(0, {{ call.scalar_n }}, {{ call.block_n }}):
                _fm_n = _fm_n_start + tl.arange(0, {{ call.block_n }})
                _fm_n_mask = (_fm_n < {{ call.scalar_n }}) & ({{ call.n_active }}) & ({{ call.slot_active }})
                _fm_gate_acc = tle.gpu.set_layout(tl.zeros((16, {{ call.block_n }}), tl.float32), {{ call.symbol }}__mma)
                _fm_up_acc = tle.gpu.set_layout(tl.zeros((16, {{ call.block_n }}), tl.float32), {{ call.symbol }}__mma)
                for _fm_k_start in tl.range(0, {{ call.scalar_k }}, {{ call.block_k }}):
                    _fm_k = _fm_k_start + tl.arange(0, {{ call.block_k }})
                    _fm_k_mask = (_fm_k < {{ call.scalar_k }}) & ({{ call.k_active }}) & ({{ call.slot_active }})
                    _fm_input = tl.load({{ call.input_pointer }} + ({{ call.q_offset }}), _fm_k_mask, other=0.)
                    _fm_x = tle.gpu.set_layout(tl.broadcast_to(_fm_input[None, :], (16, {{ call.block_k }})), {{ call.symbol }}__lhs)
                    _fm_gate = tle.gpu.set_layout(tl.load({{ call.pointers.gate_weight }} + ({{ call.gate_offset }}), _fm_n_mask[:, None] & _fm_k_mask[None, :], other=0.), {{ call.symbol }}__load)
                    _fm_up = tle.gpu.set_layout(tl.load({{ call.pointers.up_weight }} + ({{ call.up_offset }}), _fm_n_mask[:, None] & _fm_k_mask[None, :], other=0.), {{ call.symbol }}__load)
                    _fm_gate_acc = tl.dot(_fm_x, tle.gpu.set_layout(tl.trans(_fm_gate), {{ call.symbol }}__rhs), _fm_gate_acc)
                    _fm_up_acc = tl.dot(_fm_x, tle.gpu.set_layout(tl.trans(_fm_up), {{ call.symbol }}__rhs), _fm_up_acc)
                _fm_gate_result = tl.sum(tl.where(tl.arange(0, 16)[:, None] == 0, _fm_gate_acc, 0.), 0) * _fm_gate_scale
                _fm_up_result = tl.sum(tl.where(tl.arange(0, 16)[:, None] == 0, _fm_up_acc, 0.), 0) * _fm_up_scale
{% if call.attrs.round_projections %}
                _fm_gate_result = _fm_gate_result.to({{ call.output_dtype }}).to(tl.float32)
                _fm_up_result = _fm_up_result.to({{ call.output_dtype }}).to(tl.float32)
{% endif %}
{% if call.attrs.gate_clamp_max is not none %}
                _fm_gate_result = tl.minimum(_fm_gate_result, {{ call.attrs.gate_clamp_max }})
{% endif %}
{% if call.attrs.up_clamp is not none %}
                _fm_up_result = tl.clamp(_fm_up_result, -{{ call.attrs.up_clamp }}, {{ call.attrs.up_clamp }})
{% endif %}
                _fm_activation = _fm_gate_result * tl.sigmoid(_fm_gate_result)
{% if call.attrs.round_activation %}
                _fm_activation = _fm_activation.to({{ call.output_dtype }}).to(tl.float32)
{% endif %}
                tl.store({{ call.result }} + ({{ call.result_offset }}), _fm_activation * _fm_up_result, _fm_n_mask & ({{ call.writer_active }}))
{% endif %}
{% endfor %}
