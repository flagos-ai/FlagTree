{% macro state_layer(call) %}
    logical_layer = {{ call.layer_id }}
    layer = tl.full((), -1, tl.int32)
{% for logical_id in call.state_layer_ids %}
    layer = tl.where(logical_layer == {{ logical_id }}, {{ loop.index0 }}, layer)
{% endfor %}
    tl.device_assert(layer >= 0, "DSA logical layer is absent from the state contract")
{%- endmacro %}
{% for call in render_calls %}
{% if call.family == "dsa_indexer" and call.variant == "decode" %}
@triton.jit(noinline=True)
def {{ call.symbol }}__write({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{{ state_layer(call) }}
    d_offsets = tl.arange(0, {{ call.index_dim }})
    k = tl.load({{ call.key }} + d_offsets * {{ call.key_stride }}).to(tl.float32)
    gate = tl.load({{ call.gate }} + d_offsets * {{ call.gate_stride }})
    norm_w = tl.load({{ call.k_norm_weight }} + d_offsets * {{ call.norm_stride }}).to(tl.float32)
    norm_b = tl.load({{ call.k_norm_bias }} + d_offsets * {{ call.norm_stride }}).to(tl.float32)
    mean = tl.sum(k, axis=0) / {{ call.index_dim }}
    centered = k - mean
    variance = tl.sum(centered * centered, axis=0) / {{ call.index_dim }}
    k = centered * tl.rsqrt(variance + {{ call.epsilon }}) * norm_w + norm_b
    base = tl.load({{ call.sequence_lengths }}).to(tl.int32)
    state_base = layer * {{ call.state_layer_stride }} + base * {{ call.state_token_stride }}
    if {{ call.writer_active }}:
        tl.store({{ call.state }} + state_base + d_offsets * {{ call.state_value_stride }}, k)
        tl.store({{ call.state }} + state_base + ({{ call.index_dim }} + d_offsets) * {{ call.state_value_stride }}, gate)
        tl.store({{ call.state }} + state_base + 2 * {{ call.index_dim }} * {{ call.state_value_stride }}, 1.0)


@triton.jit(noinline=True)
def {{ call.symbol }}__select({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{{ state_layer(call) }}
    base = tl.load({{ call.sequence_lengths }}).to(tl.int32)
    positions = tl.arange(0, {{ call.state_tile }})
    flags = tl.load(
        {{ call.state }} + layer * {{ call.state_layer_stride }}
        + positions * {{ call.state_token_stride }} + 2 * {{ call.index_dim }} * {{ call.state_value_stride }},
        mask=(positions < {{ call.state_capacity }}) & (positions <= base), other=0,
    ) != 0
    first = tl.min(tl.where(flags, positions, {{ call.state_capacity }}), axis=0)
    visible_count = tl.sum(flags.to(tl.int32), axis=0)
    pool_count = tl.maximum((base + 1 - first + {{ call.pool - 1 }}) // {{ call.pool }}, 0)
    pool_ids = tl.arange(0, {{ call.pool_tile }})
    pool_scores = tl.full(({{ call.pool_tile }},), -float("inf"), tl.float32)
    pool_offsets = tl.arange(0, {{ call.pool }})
    d_offsets = tl.arange(0, {{ call.index_dim }})
    q_offsets = tl.arange(0, {{ call.q_width }})
    head_offsets = tl.arange(0, {{ call.index_heads }})
    q = tl.load({{ call.q }} + q_offsets * {{ call.q_stride }}).to(tl.float32)
    weight_value = tl.load({{ call.weights }} + head_offsets * {{ call.weights_stride }}).to(tl.float32)
    ape = tl.load({{ call.compress_ape }} + pool_offsets[:, None] * {{ call.ape_row_stride }}
                  + d_offsets[None, :] * {{ call.ape_dim_stride }}).to(tl.float32)
    # Score each visible pool once. Keep scores in registers while selection
    # removes winners, rather than rescanning the complete cache per winner.
    for pool_index in tl.range(0, pool_count):
        token_offsets = first + pool_index * {{ call.pool }} + pool_offsets
        state_token = layer * {{ call.state_layer_stride }} + token_offsets * {{ call.state_token_stride }}
        valid = tl.load({{ call.state }} + state_token + 2 * {{ call.index_dim }} * {{ call.state_value_stride }},
                        mask=token_offsets <= base, other=0) != 0
        keys = tl.load({{ call.state }} + state_token[:, None] + d_offsets[None, :] * {{ call.state_value_stride }},
                       mask=valid[:, None], other=0.0).to(tl.float32)
        gates = tl.load({{ call.state }} + state_token[:, None] + ({{ call.index_dim }} + d_offsets[None, :]) * {{ call.state_value_stride }},
                        mask=valid[:, None], other=0.0).to(tl.float32)
        logits = tl.where(valid[:, None], gates + ape, -float("inf"))
        maximum = tl.max(logits, axis=0)
        origin = tl.where(maximum == -float("inf"), 0.0, maximum)
        exponentials = tl.where(valid[:, None], tl.exp(logits - origin[None, :]), 0.0)
        probabilities = (exponentials / tl.maximum(tl.sum(exponentials, axis=0)[None, :], 1e-20)).to({{ call.value_type }})
        products = (probabilities.to(tl.float32) * keys).to({{ call.value_type }}).to(tl.float32)
        pooled = tl.sum(products, axis=0).to({{ call.value_type }}).to(tl.float32)
        scores = tl.sum(q.reshape(({{ call.index_heads }}, {{ call.index_dim }})) * pooled[None, :], axis=1)
        score = tl.sum(weight_value * tl.maximum(scores * {{ call.scale }}, 0.0), axis=0)
        complete = tl.min(valid.to(tl.int32), axis=0) != 0
        pool_scores = tl.where(pool_ids == pool_index, tl.where(complete, score, -float("inf")), pool_scores)
    output_offsets = tl.arange(0, {{ call.output_tile }})
{% if call.output_width > call.index_topk %}
    tail_count = visible_count % {{ call.pool }}
    tail_offset = output_offsets - {{ call.index_topk }}
    tail_value = first + visible_count - tail_count + tail_offset
    tail_valid = (tail_offset >= 0) & (tail_offset < tail_count) & (tail_value < base + 1)
    initial = tl.where(tail_valid, tail_value, -1)
{% else %}
    initial = tl.full(({{ call.output_tile }},), -1, tl.int32)
{% endif %}
    # Initialize padding and unused selections, including the first-token tail.
    tl.store({{ call.result }} + output_offsets, initial, mask=output_offsets < {{ call.output_width }})
    for selection in tl.range(0, tl.minimum(pool_count, {{ call.index_topk // call.pool }})):
        winner_score = tl.max(pool_scores, axis=0)
        winner_pool = tl.min(tl.where(pool_scores == winner_score, pool_ids, 2147483647), axis=0)
        selected_valid = winner_score > -float("inf")
        selected_value = first + winner_pool * {{ call.pool }} + pool_offsets
        tl.store({{ call.result }} + selection * {{ call.pool }} + pool_offsets,
                 tl.where(selected_valid, selected_value, -1))
        pool_scores = tl.where(pool_ids == winner_pool, -float("inf"), pool_scores)


@triton.jit(noinline=True)
def {{ call.symbol }}__advance({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    if {{ call.writer_active }}:
        base = tl.load({{ call.sequence_lengths }}).to(tl.int32)
        tl.store({{ call.sequence_lengths }}, base + 1)


@triton.jit
def {{ call.symbol }}({{ call.signature }}):
    {{ call.symbol }}__write({{ call.signature }})
{{ entry.stage_barrier() }}
    {{ call.symbol }}__select({{ call.signature }})
{{ entry.stage_barrier() }}
    if {{ call.advance_sequence }}:
        {{ call.symbol }}__advance({{ call.signature }})
{% endif %}
{% endfor %}
