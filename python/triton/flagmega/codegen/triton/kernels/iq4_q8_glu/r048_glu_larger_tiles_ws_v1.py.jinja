@triton.jit
def {{ call.symbol }}__row_ptr(W, byte):
    p0 = gpu.local_ptr(W[0],(0,byte//16,byte%16),shape=(4,32))
    p1 = gpu.local_ptr(W[1],(0,(byte-2048)//16,byte%16),shape=(4,32))
    p2 = gpu.local_ptr(W[2],(0,(byte-2560)//16,byte%16),shape=(4,32))
    p3 = gpu.local_ptr(W[3],(0,(byte-2688)//16,byte%16),shape=(4,32))
    return tl.where(byte<2048,p0,tl.where(byte<2560,p1,tl.where(byte<2688,p2,p3)))

