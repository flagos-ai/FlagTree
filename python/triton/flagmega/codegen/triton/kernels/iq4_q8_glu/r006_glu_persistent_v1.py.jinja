            tle.gpu.copy(_map{{ loop.index0 }},_slot{{ loop.index0 }}.{{ channel.name }},{{ call.transport_block_shape | default([1,256,16]) | list }},[row_index.to(tl.int32),136*it,0])
            {{ channel.writer_parameter }}.commit(epoch)
{% endfor %}
{% for channel in call.pipeline_channels %}
