@triton.jit
def {{ call.symbol }}__consumer({{ (call.pipeline_consumer_parameters + (call.signature,)) | join(', ') }}):
    w = gpu.set_layout(tl.broadcast_to(tl.arange(0, 4)[:, None], (4, 32)), E)
    l = gpu.set_layout(tl.broadcast_to(tl.arange(0, 32)[None, :], (4, 32)), E)
    tid = w * 32 + l
    g = tid % 8
    row_count = tl.cdiv({{ call.transport_n }} - tl.program_id(0), tl.num_programs(0))
    for row_iteration in range(row_count):
        row_index = tl.program_id(0) + row_iteration * tl.num_programs(0)
        row = gpu.set_layout(tl.full((4, 32), row_index, tl.int64), E)
{% if call.constexprs.ROWS == 1 %}
        p = gpu.set_layout(tl.full((4, 32), 0.0, tl.float32), E)
        u = gpu.set_layout(tl.full((4, 32), 0.0, tl.float32), E)
        for it in range(tl.cdiv({{ call.transport_k }} // 256, 16)):
            __READY0__ = {{ call.pipeline_channels[0].reader_parameter }}.wait((2 * row_iteration + it).to(tl.int32))
{% if call.transport_mode == 1 %}
            __READY1__ = {{ call.pipeline_channels[1].reader_parameter }}.wait((2 * row_iteration + it).to(tl.int32))
{% endif %}
            kbx = tid // 8 + 16 * it
            active = (row < {{ call.transport_n }}) & (kbx < {{ call.transport_k }} // 256)
            (J, D) = {{ call.symbol }}__dot_group_stage(__READY0__.slot.gate, {{ call.pointers[0] }}, row, kbx, g, active, {{ call.transport_k }})
            pn = tl.inline_asm_elementwise('fma.rn.f32 $0,$1,$2,$3;', constraints='=f,f,f,f', args=[D, J, p], dtype=tl.float32, is_pure=True, pack=1)
            p = tl.where(active, pn, p)
            if {{ call.transport_mode }} == 1:
                (J, D) = {{ call.symbol }}__dot_group_stage(__READY1__.slot.up, {{ call.pointers[0] }}, row, kbx, g, active, {{ call.transport_k }})
                un = tl.inline_asm_elementwise('fma.rn.f32 $0,$1,$2,$3;', constraints='=f,f,f,f', args=[D, J, u], dtype=tl.float32, is_pure=True, pack=1)
                u = tl.where(active, un, u)
            {{ call.pipeline_channels[0].reader_parameter }}.release((2 * row_iteration + it).to(tl.int32))
{% if call.transport_mode == 1 %}
            {{ call.pipeline_channels[1].reader_parameter }}.release((2 * row_iteration + it).to(tl.int32))
{% endif %}
        tl.static_assert({{ call.transport_k }} % 256 == 0, 'R003 requires complete original K256 blocks')
        (p, u) = typed_reduce(p, u, w, l, {{ call.transport_mode }} == 1)
        if {{ call.transport_mode }} == 1:
            p = p / (1.0 + tl.exp(-p)) * u
        writer = (row < {{ call.transport_n }}) & (w == 0) & (l == 0)
        if {{ call.transport_mode }} == 2:
            out = tl.where(row % 512 // 256 == 0, {{ call.pointers[3] }}, {{ call.pointers[4] }})
            offset = row // 512 * 256 + row % 256
            tl.store(out + offset, p.to(tl.bfloat16), writer)
        else:
            tl.store({{ call.pointers[3] }} + row, p, writer)
{% else %}
        p = ()
        u = ()
        for token in tl.static_range({{ call.constexprs.ROWS }}):
            p += (gpu.set_layout(tl.full((4, 32), 0.0, tl.float32), E),)
            u += (gpu.set_layout(tl.full((4, 32), 0.0, tl.float32), E),)
        epoch = row_iteration.to(tl.int32)
        __READY0__ = {{ call.pipeline_channels[0].reader_parameter }}.wait(epoch)
        __READY1__ = {{ call.pipeline_channels[1].reader_parameter }}.wait(epoch)
        credit_index = gpu.set_layout(tl.full((4, 32), 0, tl.int32), E)
        gate_row = tl.load(gpu.local_ptr(__READY0__.slot.gate, (credit_index,), shape=(4, 32)))
        up_row = tl.load(gpu.local_ptr(__READY1__.slot.up, (credit_index,), shape=(4, 32)))
        row = gpu.set_layout(gate_row.to(tl.int64), E)
        credits_match = gate_row == up_row
        for it in range(tl.cdiv({{ call.transport_k }} // 256, 16)):
            kbx = tid // 8 + 16 * it
            active = credits_match & (row < {{ call.transport_n }}) & (kbx < {{ call.transport_k }} // 256)
            p, u = {{ call.symbol }}__accumulate_pair({{ call.pointers[1] }}, {{ call.pointers[2] }}, {{ call.pointers[0] }}, row, kbx, g, active, p, u, {{ call.transport_k }}, {{ call.constexprs.ROWS }})
        {{ call.pipeline_channels[0].reader_parameter }}.release(epoch)
        {{ call.pipeline_channels[1].reader_parameter }}.release(epoch)
        {{ call.symbol }}__store_rows(p, u, {{ call.pointers[3] }}, row, w, l, {{ call.constexprs.ROWS }})
{% endif %}
