        tl.inline_asm_elementwise('{ .reg .pred p; setp.ne.u32 p,$1,0; @p prefetch.global.L2 [$2]; mov.u32 $0,0; }', constraints='=r,r,l', args=[lane < {{ (136 * (call.transport_k // 256) + 127) // 128 }}, ptr], dtype=tl.int32, is_pure=False, pack=1)
        tl.store(gpu.local_ptr(slot.{{ channel.name }}, (lane * 0,), shape=(32,)), row_index, lane == 0)
        {{ channel.writer_parameter }}.commit(epoch)
{% endfor %}
{% for channel in call.pipeline_channels %}
    {{ channel.writer_parameter }}.close(row_count.to(tl.int32))
