{% import "entrypoints/_common.py.jinja" as entry with context %}
{% if render_calls is defined %}
{% for call in render_calls %}
{% if call.family == "qkv_parallel_linear" and call.variant == "packed_fused_gemv" %}
{#- On RDNA the generic physical-order source broadcast goes through LDS with two
    CTA barriers per K step, serializing the weight loads; stream a 1-D source
    against an (N, K) weight tile instead. int64 offsets avoid the buffer-op
    waterfall on the non-uniform shard base. #}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    qkv_weight_base = {{ call.weight }} + shard_index * {{ call.weight_owner_stride }}
{% if call.local_m != 1 %}
    for qkv_local_m in tl.range(0, {{ call.local_m }}):
{% endif %}
{% filter indent(4 if call.local_m != 1 else 0, first=True) %}
{% for output in call.outputs %}
{% set qkv_tile_n = [call.tile_n, 64, output.local_n_capacity] | min %}
{% set qkv_n_tiles = output.local_n_capacity // qkv_tile_n %}
    for qkv_local_n_start in tl.range(
        0, {{ output.local_n_capacity }}, {{ qkv_tile_n }}
    ):
{% if qkv_rotate_owner_n_tiles | default(false) and qkv_n_tiles > 1 and output.local_n_capacity % qkv_tile_n == 0 %}
        qkv_local_n_offsets = (
            (qkv_local_n_start + tl.cast(shard_index % {{ qkv_n_tiles }}, tl.int32) * {{ qkv_tile_n }})
            % {{ output.local_n_capacity }}
        ) + tl.arange(0, {{ qkv_tile_n }})
{% else %}
        qkv_local_n_offsets = qkv_local_n_start + tl.arange(0, {{ qkv_tile_n }})
{% endif %}
        qkv_n_mask = (
            (qkv_local_n_offsets < {{ output.local_n_capacity }})
            & ({{ output.active }})
        )
        qkv_n = qkv_local_n_offsets.to(tl.int64)[:, None]
        qkv_accumulator = tl.zeros(
            ({{ qkv_tile_n }}, {{ call.block_k }}), tl.float32
        )
        for qkv_local_k_start in tl.range(
            0, {{ call.local_k_capacity }}, {{ call.block_k }}
        ):
            qkv_local_k_offsets = qkv_local_k_start + tl.arange(0, {{ call.block_k }})
            qkv_k_mask = (
                (qkv_local_k_offsets < {{ call.local_k_capacity }})
                & ({{ call.source_active }})
            )
            qkv_source = tl.load(
                {{ call.source }} + ({{ call.source_offset }}),
                mask=qkv_k_mask, other=0.0,
            )
            qkv_k = qkv_local_k_offsets.to(tl.int64)[None, :]
            qkv_weight = tl.load(
                qkv_weight_base
                + (qkv_k // {{ call.k_lane }}) * {{ call.weight_k_group_stride }}
                + ({{ output.weight_group_start }} + qkv_n // {{ call.n_lane }})
                    * {{ call.weight_n_group_stride }}
                + (qkv_n % {{ call.n_lane }}) * {{ call.k_lane }}
                + qkv_k % {{ call.k_lane }},
                mask=qkv_n_mask[:, None] & qkv_k_mask[None, :], other=0.0,
            )
            qkv_accumulator += (
                qkv_weight.to(tl.float32) * qkv_source.to(tl.float32)[None, :]
            )
        tl.store(
            {{ output.result }} + ({{ output.result_offset }}),
            tl.sum(qkv_accumulator, axis=1).to({{ call.output_type }}),
            mask=qkv_n_mask,
        )
{% endfor %}
{% endfilter %}


{% endif %}
{% endfor %}
{% endif %}
