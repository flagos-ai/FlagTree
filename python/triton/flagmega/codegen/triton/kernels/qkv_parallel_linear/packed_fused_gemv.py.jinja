# flagmega-kernel: qkv_parallel_linear/packed_fused_gemv platform=generic
{% import "entrypoints/_common.py.jinja" as entry with context %}
{% if render_calls is defined %}
{% for call in render_calls %}
{% if call.family == "qkv_parallel_linear" and call.variant == "packed_fused_gemv" %}
{{ entry.kernel_decorator(call) }}  {#- prefer_inline=true re-tested in Trial 55; see dense_matmul/_function.py.jinja's matching note -- kept reverted, no net performance win under current conditions even though Trial 15's stability mystery is now explained (Trial 49). #}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for qkv_local_m in range({{ call.local_m }}):
{% filter indent(4, true) %}
{% for output in call.outputs %}
{# Clamp the output tile to what this output actually owns. The three fused
   outputs have different `local_n_capacity` (for GQA, Q is wider than K/V),
   but all three used to inherit one `call.tile_n`, so a narrow output
   computed a full tile and masked most of it off. On BI-V150 Qwen3-1.7B
   (Q 128, K 64, V 64) that was 384 n-lanes computed to produce 256 -- 33%
   of the output-tile work discarded. Measured per output at the real shape,
   28 layers x 16 CTAs: shared tile 1.769 ms vs clamped 1.634 ms (-7.6%);
   the narrow outputs go 0.526 -> 0.458 and 0.514 -> 0.447.

   Capacities are not always tile multiples, so the existing masks stay:
   this removes whole wasted tiles, not the tail predicate. #}
{% set qkv_tile_n = [call.tile_n, output.local_n_capacity] | min %}
{% set qkv_preserve_reduction = corex_preserve_k_reduction | default(false) and call.block_k == 64 and call.k_lane == 16 and qkv_tile_n in [64, 128] %}
{% set qkv_source_pointer = call.source ~ " + (" ~ call.source_offset ~ ")" %}
{% set qkv_weight_pointer = call.weight ~ " + qkv_weight_offsets" %}
{% if qkv_preserve_reduction %}
{# Keep the packed payload's K register ownership through global loads. #}
{% set qkv_source_pointer = "tle.gpu.set_layout(" ~ qkv_source_pointer ~ ", qkv_layout)" %}
{% set qkv_weight_pointer = "tle.gpu.set_layout(" ~ qkv_weight_pointer ~ ", qkv_layout)" %}
{% endif %}
    for qkv_local_n_start in tl.range(
        0, {{ output.local_n_capacity }}, {{ qkv_tile_n }}
    ):
        {# A packed K group stores N rows of k_lane contiguous elements.
           Keep that physical order through the multiply and accumulate;
           reducing the two K axes at loop exit avoids converting each load
           to a logical (N, K) layout, which needs shared-memory exchanges. #}
        qkv_payload = tl.arange(0, {{ qkv_tile_n * call.k_lane }})
        qkv_n = qkv_local_n_start + qkv_payload // {{ call.k_lane }}
        qkv_k_groups = tl.arange(0, {{ call.block_k // call.k_lane }})
        qkv_accumulator = tl.zeros(
            ({{ call.block_k // call.k_lane }}, {{ qkv_tile_n * call.k_lane }}),
            tl.float32,
        )
{% if qkv_preserve_reduction %}
        qkv_layout: tl.constexpr = tle.gpu.BlockEncoding(
            [1, {{ 4 if qkv_tile_n == 128 else 2 }}], [1, 64], [4, 4], [1, 0]
        )
        qkv_accumulator = tle.gpu.set_layout(qkv_accumulator, qkv_layout)
{% endif %}
        for qkv_local_k_start in tl.range(
            0, {{ call.local_k_capacity }}, {{ call.block_k }}{% if qkv_preserve_reduction %}, loop_unroll_factor=8{% endif %}
        ):
            qkv_local_k_offsets = (
                qkv_local_k_start + qkv_k_groups[:, None] * {{ call.k_lane }}
                + qkv_payload[None, :] % {{ call.k_lane }}
            )
            qkv_source = tl.load(
                {{ qkv_source_pointer }},
                mask=(qkv_local_k_offsets < {{ call.local_k_capacity }})
                & ({{ call.source_active }}), other=0.0,
            )
            qkv_local_n_offsets = qkv_n[None, :]
            qkv_weight_offsets = (
                shard_index * {{ call.weight_owner_stride }}
                + (qkv_local_k_start // {{ call.k_lane }} + qkv_k_groups[:, None])
                    * {{ call.weight_k_group_stride }}
                + ({{ output.weight_group_start }} + qkv_n[None, :] // {{ call.n_lane }})
                    * {{ call.weight_n_group_stride }}
                + (qkv_n[None, :] % {{ call.n_lane }}) * {{ call.k_lane }}
                + qkv_payload[None, :] % {{ call.k_lane }}
            )
            qkv_weight = tl.load(
                {{ qkv_weight_pointer }},
                mask=(qkv_n[None, :] < {{ output.local_n_capacity }})
                & ({{ output.active }})
                & (qkv_local_k_offsets < {{ call.local_k_capacity }})
                & ({{ call.source_active }}), other=0.0,
            )
            qkv_accumulator += qkv_weight.to(tl.float32) * qkv_source.to(tl.float32)
{% if qkv_preserve_reduction %}
        # Q and K/V own different N capacities and therefore different
        # register folds. Preserve each original K tree at the reduction.
        qkv_fold = tle.gpu.set_layout(tl.reshape(qkv_accumulator,
            ({{ call.block_k // call.k_lane }}, {{ qkv_tile_n }}, {{ call.k_lane }})),
            tle.gpu.BlockEncoding(
                [1, 1, {{ 4 if qkv_tile_n == 128 else 2 }}],
                [1, {{ 16 if qkv_tile_n == 128 else 8 }}, {{ 4 if qkv_tile_n == 128 else 8 }}],
                [4, 4, 1], [2, 1, 0],
            ))
        qkv_result = tl.sum(tl.sum(qkv_fold, axis=2), axis=0)
{% else %}
        qkv_result = tl.sum(tl.sum(tl.reshape(
            qkv_accumulator,
            ({{ call.block_k // call.k_lane }}, {{ qkv_tile_n }}, {{ call.k_lane }}),
        ), axis=2), axis=0)
{% endif %}
        qkv_local_n_offsets = qkv_local_n_start + tl.arange(0, {{ qkv_tile_n }})
{% if qkv_preserve_reduction %}
        # Publish from the canonical fold's N ownership without another
        # shared-memory exchange for a default result-pointer encoding.
        qkv_output_layout_{{ loop.index0 }}: tl.constexpr = tle.gpu.BlockEncoding(
            [1, 1, {{ 4 if qkv_tile_n == 128 else 2 }}],
            [1, {{ 16 if qkv_tile_n == 128 else 8 }}, {{ 4 if qkv_tile_n == 128 else 8 }}],
            [4, 4, 1], [2, 1, 0],
        )
{% endif %}
        tl.store(
{% if qkv_preserve_reduction %}
            tle.gpu.set_layout(
                {{ output.result }} + ({{ output.result_offset }}),
                tle.gpu.SlicedEncoding(0, tle.gpu.SlicedEncoding(2, qkv_output_layout_{{ loop.index0 }})),
            ),
{% else %}
            {{ output.result }} + ({{ output.result_offset }}),
{% endif %}
            qkv_result.to({{ call.output_type }}),
            mask=(qkv_local_n_offsets < {{ output.local_n_capacity }})
                & ({{ output.active }}),
        )
{% endfor %}
{% endfilter %}


{% endif %}
{% endfor %}
{% endif %}
