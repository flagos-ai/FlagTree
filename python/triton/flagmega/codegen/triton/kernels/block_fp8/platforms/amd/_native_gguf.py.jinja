{#- AMD RDNA native GGUF (IQ4_XS / Q4_K) GEMV helpers.
    One thread owns one 32-value group (IQ4_XS) or one 64-value group pair
    (Q4_K) of a K step for two rows of an 8-row half tile, so the activation
    group is converted once and reused by both rows. Loads are wide and, for
    full K steps, unmasked: rows past the tile's end re-read a valid row and
    are masked only at the store. The IQ4_NL codebook is a v_perm_b32 table
    lookup (llama.cpp get_int_from_table_16), each group's d*(scale-32) is
    applied once to the group sum, and the cross-thread reduction runs once
    per tile after the K loop. Activations stay floating point. #}
@triton.jit
def _flagmega_amd_perm(high, low, selector):
    return tl.inline_asm_elementwise(
        "v_perm_b32 $0, $1, $2, $3", "=v,v,v,v", [high, low, selector],
        dtype=tl.uint32, is_pure=True, pack=1,
    )


@triton.jit
def _flagmega_amd_iq4_nl_lookup(codes):
    """The low nibble of each byte of `codes` -> that IQ4_NL codebook int8."""
    table0 = tl.full(codes.shape, 0xBFAD9881, tl.uint32)
    table1 = tl.full(codes.shape, 0xF6EADDCF, tl.uint32)
    table2 = tl.full(codes.shape, 0x26190D01, tl.uint32)
    table3 = tl.full(codes.shape, 0x71594535, tl.uint32)
    selector = codes & 0x07070707
    low = _flagmega_amd_perm(table1, table0, selector)
    high = _flagmega_amd_perm(table3, table2, selector)
    return _flagmega_amd_perm(high, low, ((codes >> 1) & 0x04040404) | 0x03020100)


@triton.jit
def _flagmega_amd_signed_byte(word, BYTE: tl.constexpr):
    return ((word.to(tl.int32, bitcast=True) << (24 - 8 * BYTE)) >> 24).to(tl.float32)


@triton.jit
def _flagmega_amd_unsigned_byte(word, BYTE: tl.constexpr):
    return ((word >> (8 * BYTE)) & 0xFF).to(tl.float32)


@triton.jit
def _flagmega_amd_bf16_pair(pair):
    return (pair << 16).to(tl.float32, bitcast=True), (pair & 0xFFFF0000).to(tl.float32, bitcast=True)


@triton.jit
def _flagmega_amd_iq4_xs_word(word, x_pairs, WORD: tl.constexpr):
    """Dot of qs word WORD of a 32-value group: low nibbles pair with values
    4*WORD..4*WORD+3, high nibbles with 16+4*WORD..16+4*WORD+3."""
    x0, x1 = _flagmega_amd_bf16_pair(tl.load(x_pairs + 2 * WORD))
    x2, x3 = _flagmega_amd_bf16_pair(tl.load(x_pairs + 2 * WORD + 1))
    x4, x5 = _flagmega_amd_bf16_pair(tl.load(x_pairs + 8 + 2 * WORD))
    x6, x7 = _flagmega_amd_bf16_pair(tl.load(x_pairs + 9 + 2 * WORD))
    low = _flagmega_amd_iq4_nl_lookup(word)
    high = _flagmega_amd_iq4_nl_lookup(word >> 4)
    return (
        _flagmega_amd_signed_byte(low, 0) * x0 + _flagmega_amd_signed_byte(low, 1) * x1
        + _flagmega_amd_signed_byte(low, 2) * x2 + _flagmega_amd_signed_byte(low, 3) * x3
        + _flagmega_amd_signed_byte(high, 0) * x4 + _flagmega_amd_signed_byte(high, 1) * x5
        + _flagmega_amd_signed_byte(high, 2) * x6 + _flagmega_amd_signed_byte(high, 3) * x7
    )


@triton.jit
def _flagmega_amd_iq4_xs_step(source_pairs, weight, rows, group, MASK_GROUPS: tl.constexpr, GROUPS: tl.constexpr):
    """Partial dot of the [2,4,G] (row, row, group) tile at global groups `group`."""
    q64 = weight.to(tl.pointer_type(tl.uint64))
    w32 = weight.to(tl.pointer_type(tl.uint32))
    block = group // 8
    in_block = group % 8
    q_index = rows // 8 + block * 17 + 1 + in_block * 2
    h_index = rows // 4 + block * 34
    if MASK_GROUPS:
        # A lane past the row's last group reads a zero header (zero scale)
        # and group 0's activations, so it adds exactly zero.
        active = group < GROUPS
        first = tl.load(q64 + q_index, mask=active, other=0)
        second = tl.load(q64 + q_index + 1, mask=active, other=0)
        h0 = tl.load(w32 + h_index, mask=active, other=0)
        h1 = tl.load(w32 + h_index + 1, mask=active, other=0)
        x_group = tl.where(active, group, 0)
    else:
        first = tl.load(q64 + q_index)
        second = tl.load(q64 + q_index + 1)
        h0 = tl.load(w32 + h_index)
        h1 = tl.load(w32 + h_index + 1)
        x_group = group
    delta = (h0 & 0xFFFF).to(tl.uint16).to(tl.float16, bitcast=True).to(tl.float32)
    scale_code = ((h1 >> (in_block * 4)) & 0xF) | ((((h0 >> 16) >> (in_block * 2)) & 0x3) << 4)
    scale = delta * (scale_code.to(tl.float32) - 32.0)
    x_pairs = source_pairs + x_group * 16
    dot = (
        _flagmega_amd_iq4_xs_word((first & 0xFFFFFFFF).to(tl.uint32), x_pairs, 0)
        + _flagmega_amd_iq4_xs_word((first >> 32).to(tl.uint32), x_pairs, 1)
        + _flagmega_amd_iq4_xs_word((second & 0xFFFFFFFF).to(tl.uint32), x_pairs, 2)
        + _flagmega_amd_iq4_xs_word((second >> 32).to(tl.uint32), x_pairs, 3)
    )
    return dot * scale


@triton.jit
def _flagmega_amd_iq4_xs_rows8(source, weight, rows8, K: tl.constexpr):
    """IQ4_XS dot of 8 rows (packed-byte offsets `rows8`) with `source`."""
    GROUPS: tl.constexpr = K // 32
    G: tl.constexpr = 32
    rows = tl.reshape(rows8, (2, 4))[:, :, None]
    lanes = tl.arange(0, G)[None, None, :]
    source_pairs = source.to(tl.pointer_type(tl.uint32))
    accumulator = tl.zeros((2, 4, G), tl.float32)
    for group0 in tl.range(0, GROUPS, G):
        accumulator += _flagmega_amd_iq4_xs_step(
            source_pairs, weight, rows, group0 + lanes, GROUPS % G != 0, GROUPS)
    return tl.reshape(tl.sum(accumulator, axis=2), (8,))


@triton.jit
def _flagmega_amd_q4_k_rows8(source, weight, rows8, K: tl.constexpr):
    """Q4_K dot of 8 rows; one thread owns a 64-value group pair (32 qs bytes)."""
    PAIRS: tl.constexpr = K // 64
    G: tl.constexpr = 16
    rows = tl.reshape(rows8, (2, 4))[:, :, None]
    pair = tl.arange(0, G)[None, None, :]
    q64 = weight.to(tl.pointer_type(tl.uint64))
    u8 = weight.to(tl.pointer_type(tl.uint8))
    f16 = weight.to(tl.pointer_type(tl.float16))
    source_pairs = source.to(tl.pointer_type(tl.uint32))
    accumulator = tl.zeros((2, 4, G), tl.float32)
    for pair0 in tl.range(0, PAIRS, G):
        p = pair0 + pair
        active = p < PAIRS
        block = p // 4
        in_block = p % 4
        base = rows + block * 144
        delta = tl.load(f16 + base // 2, mask=active, other=0.0).to(tl.float32)
        delta_min = tl.load(f16 + base // 2 + 1, mask=active, other=0.0).to(tl.float32)
        even = 2 * in_block
        s0e = tl.load(u8 + base + 4 + even % 4, mask=active, other=0)
        s1e = tl.load(u8 + base + 8 + even % 4, mask=active, other=0)
        s2e = tl.load(u8 + base + 12 + even % 4, mask=active, other=0)
        s0o = tl.load(u8 + base + 4 + (even + 1) % 4, mask=active, other=0)
        s1o = tl.load(u8 + base + 8 + (even + 1) % 4, mask=active, other=0)
        s2o = tl.load(u8 + base + 12 + (even + 1) % 4, mask=active, other=0)
        low_pair = in_block < 2
        scale_even = tl.where(low_pair, s0e & 0x3F, (s2e & 0xF) | ((s0e >> 2) & 0x30)).to(tl.float32)
        min_even = tl.where(low_pair, s1e & 0x3F, (s2e >> 4) | ((s1e >> 2) & 0x30)).to(tl.float32)
        scale_odd = tl.where(low_pair, s0o & 0x3F, (s2o & 0xF) | ((s0o >> 2) & 0x30)).to(tl.float32)
        min_odd = tl.where(low_pair, s1o & 0x3F, (s2o >> 4) | ((s1o >> 2) & 0x30)).to(tl.float32)
        q_index = rows // 8 + block * 18 + 2 + in_block * 4
        x_pairs = source_pairs + p * 32
        dot_even = tl.zeros(delta.shape, tl.float32)
        dot_odd = tl.zeros(delta.shape, tl.float32)
        sum_even = tl.zeros(delta.shape, tl.float32)
        sum_odd = tl.zeros(delta.shape, tl.float32)
        for half in tl.static_range(4):
            qwords = tl.load(q64 + q_index + half, mask=active, other=0)
            for part in tl.static_range(2):
                word = ((qwords >> (32 * part)) & 0xFFFFFFFF).to(tl.uint32)
                low = word & 0x0F0F0F0F
                high = (word >> 4) & 0x0F0F0F0F
                k = 2 * (2 * half + part)
                e0, e1 = _flagmega_amd_bf16_pair(tl.load(x_pairs + k, mask=active, other=0))
                e2, e3 = _flagmega_amd_bf16_pair(tl.load(x_pairs + k + 1, mask=active, other=0))
                o0, o1 = _flagmega_amd_bf16_pair(tl.load(x_pairs + 16 + k, mask=active, other=0))
                o2, o3 = _flagmega_amd_bf16_pair(tl.load(x_pairs + 17 + k, mask=active, other=0))
                dot_even += (_flagmega_amd_unsigned_byte(low, 0) * e0 + _flagmega_amd_unsigned_byte(low, 1) * e1
                             + _flagmega_amd_unsigned_byte(low, 2) * e2 + _flagmega_amd_unsigned_byte(low, 3) * e3)
                dot_odd += (_flagmega_amd_unsigned_byte(high, 0) * o0 + _flagmega_amd_unsigned_byte(high, 1) * o1
                            + _flagmega_amd_unsigned_byte(high, 2) * o2 + _flagmega_amd_unsigned_byte(high, 3) * o3)
                sum_even += e0 + e1 + e2 + e3
                sum_odd += o0 + o1 + o2 + o3
        accumulator += (delta * scale_even * dot_even - delta_min * min_even * sum_even
                        + delta * scale_odd * dot_odd - delta_min * min_odd * sum_odd)
    return tl.reshape(tl.sum(accumulator, axis=2), (8,))


@triton.jit
def _flagmega_amd_native_rows(source, weight, row_offsets, n_mask, K: tl.constexpr,
                              ENCODING: tl.constexpr, TN: tl.constexpr):
    """Native GGUF dot of a TN-row tile (TN in {8, 16}). 16 rows run as two
    contiguous 8-row halves, which bounds register pressure; a half without an
    active row (the ragged last tile of an owner) is skipped."""
    tl.static_assert(TN == 8 or TN == 16, "AMD native GGUF tiles hold 8 or 16 rows")
    safe = tl.where(n_mask, row_offsets, tl.max(tl.where(n_mask, row_offsets, 0), axis=0))
    if TN == 8:
        if ENCODING == "IQ4_XS":
            result = _flagmega_amd_iq4_xs_rows8(source, weight, safe, K)
        else:
            result = _flagmega_amd_q4_k_rows8(source, weight, safe, K)
    else:
        first_rows, second_rows = tl.split(tl.permute(tl.reshape(safe, (2, 8)), (1, 0)))
        _, second_active = tl.split(tl.permute(tl.reshape(n_mask.to(tl.int32), (2, 8)), (1, 0)))
        if ENCODING == "IQ4_XS":
            first = _flagmega_amd_iq4_xs_rows8(source, weight, first_rows, K)
        else:
            first = _flagmega_amd_q4_k_rows8(source, weight, first_rows, K)
        second = tl.zeros((8, ), tl.float32)
        if tl.max(second_active, axis=0) > 0:
            if ENCODING == "IQ4_XS":
                second = _flagmega_amd_iq4_xs_rows8(source, weight, second_rows, K)
            else:
                second = _flagmega_amd_q4_k_rows8(source, weight, second_rows, K)
        result = tl.reshape(tl.permute(tl.join(first, second), (1, 0)), (16, ))
    return result
