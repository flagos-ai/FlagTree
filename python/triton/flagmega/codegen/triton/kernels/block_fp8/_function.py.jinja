{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "block_fp8" and call.variant == block_fp8_variant %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{% if call.weight_encoding in ("IQ4_XS", "Q4_K") %}
{% set native_activation = native_gguf_activation_prologue is defined and call.weight_encoding == "IQ4_XS" %}
{% if native_activation %}
{% include native_gguf_activation_prologue %}
{% endif %}
{#- A platform template may dot native GGUF rows in smaller tiles than the planned tile_n. #}
{% set native_tile_n = native_gguf_tile_rows | default(call.tile_n) %}
{% set native_tiles = (call.local_n_capacity + native_tile_n - 1) // native_tile_n %}
{% if native_gguf_rotate_tiles is defined and native_gguf_rotate_tiles and native_tiles > 1 %}
    for local_n_tile in tl.range(0, {{ native_tiles }}):
        local_n_start = (((local_n_tile + shard_index) % {{ native_tiles }}) * {{ native_tile_n }}).to(tl.int32)
{% else %}
    for local_n_start in tl.range(0, {{ call.local_n_capacity }}, {{ native_tile_n }}):
{% endif %}
        local_n_offsets = local_n_start + tl.arange(0, {{ native_tile_n }})
        n_mask = {{ call.n_mask }}
{% if call.weight_encoding == "IQ4_XS" %}
        _flagmega_iq4_xs_linear_local_tile(
{% else %}
        _flagmega_q4_k_linear_local_tile(
{% endif %}
            {{ call.value }}, {{ call.weight }}, {{ call.result }},
            {{ call.weight_row_offset }},
            {{ call.destination_offset }}, n_mask, {{ call.k }},
{% if native_activation %}
            {{ native_gguf_activation_arguments }},
{% endif %}
        )
{% else %}
    for local_n_start in tl.range(
        0, {{ call.local_n_capacity }}, {{ call.tile_n }}
    ):
        local_n_offsets = local_n_start + tl.arange(0, {{ call.tile_n }})
        n_mask = {{ call.n_mask }}
        weight_rows = {{ call.weight_row_offset }}
        scale_rows = {{ call.scale_row_offset }}
        destination_offsets = {{ call.destination_offset }}
        _flagmega_block_linear_local_tile(
            {{ call.value }}, {{ call.weight }}, {{ call.scale }}, {{ call.result }},
            weight_rows, scale_rows, destination_offsets, n_mask,
            {{ call.k }}, {{ call.block_k }},
            "{{ call.activation_quantization }}", {{ call.weight_dequant_type }},
{% if call.variant == "mma" %}
            {{ call.dequant_mma_splits }},
            "{{ call.scaled_accumulation | default('compensated') }}",
{% endif %}
        )
{% endif %}


{% endif %}
{% endfor %}
