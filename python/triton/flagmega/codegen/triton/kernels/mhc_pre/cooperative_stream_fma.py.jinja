# flagmega-kernel: mhc_pre/{{ mhc_projection_variant | default("cooperative_stream_fma") }} platform=nvidia
{% if render_calls is defined %}
{% import "entrypoints/_common.py.jinja" as entry with context %}
import triton.experimental.tle.language as tle
{% if mhc_projection_variant | default("cooperative_stream_fma") == "cooperative_contiguous_tf32" %}
{% include "kernels/mhc_pre/_contiguous_projection.py.jinja" %}
{% else %}
{% include "kernels/mhc_pre/_split_projection.py.jinja" %}
{% endif %}
{% macro cta_coordinates() %}
    _fm_cta = tl.program_id(0) + tl.num_programs(0) * (tl.program_id(1) + tl.num_programs(1) * tl.program_id(2))
    _fm_ctas = tl.num_programs(0) * tl.num_programs(1) * tl.num_programs(2)
{% endmacro %}
{% for call in render_calls %}
{% if call.family == "mhc_pre" and call.variant == mhc_projection_variant | default("cooperative_stream_fma") %}
{{ call.symbol }}__dot_layout = tl.constexpr(tle.gpu.BlockEncoding(
    [1, 1, 1], [1, 1, 32], [{{ [num_warps // 4, 2] | min }}, {{ num_warps // (4 * ([num_warps // 4, 2] | min)) }}, 4], [2, 1, 0],
))
{{ call.symbol }}__source_layout = tl.constexpr(tle.gpu.SlicedEncoding(0, {{ call.symbol }}__dot_layout))
{% if call.variant == "cooperative_contiguous_tf32" %}
{{ call.symbol }}__mix_layout = tl.constexpr(tle.gpu.BlockEncoding([1], [32], [{{ num_warps }}], [0]))
{% endif %}
{% if not call.collapse_sequential_fma %}
# Keep stream reduction in lanes, as in the original stream_fma wrapper.
# Moving it into warps changes the FP32 addition tree at BF16 midpoints.
{{ call.symbol }}__collapse_sum_layout = tl.constexpr(tle.gpu.BlockEncoding(
    [1, 1], [8, 4], [{{ num_warps }}, 1], [1, 0],
))
{% endif %}
@triton.jit(noinline=True)
def {{ call.symbol }}__project({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{{ cta_coordinates() }}
    # A task owns one row pair and one logical split. The partial remains
    # unrounded until the original split-order merge in the next phase.
    for _fm_task in tl.range(_fm_cta, ({{ call.token_active }}) * {{ call.projection_tasks_per_token }}, _fm_ctas):
        _fm_token = _fm_task // {{ call.projection_tasks_per_token }}
        _fm_part = _fm_task % {{ call.projection_tasks_per_token }}
        _fm_split = _fm_part % {{ call.projection_splits }}
        _fm_work = {{ call.projection_partials }} + _fm_token * {{ call.projection_workspace_width }}
{% if call.variant == "cooperative_contiguous_tf32" %}
        _fm_mixes, _fm_square = _flagmega_mhc_contiguous_projection_split(
            {{ call.streams }} + ({{ call.streams_fma_token_offset }}),
            {{ call.projection }} + ({{ call.projection_fma_base_offset }}), _fm_split,
            {{ call.hc }}, {{ call.hidden }}, {{ call.projection_splits }},
            {{ call.streams_fma_stream_stride }}, {{ call.streams_fma_hidden_stride }},
            {{ call.projection_fma_row_stride }}, {{ call.projection_fma_hidden_stride }},
            {{ call.symbol }}__dot_layout, {{ call.symbol }}__source_layout, {{ call.symbol }}__mix_layout,
        )
        _fm_rows = tle.gpu.set_layout(tl.arange(0, 32), {{ call.symbol }}__mix_layout)
        tl.store(_fm_work + _fm_rows * {{ call.projection_splits }} + _fm_split,
                 _fm_mixes, mask=_fm_rows < {{ call.coefficients }})
        tl.store(_fm_work + {{ call.projection_square_start }} + _fm_split, _fm_square)
{% else %}
        if _fm_part < {{ call.projection_pair_count * call.projection_splits }}:
            _fm_row = (_fm_part // {{ call.projection_splits }}) * 2
            _fm_first, _fm_second = _flagmega_mhc_project_split_pair(
                {{ call.streams }} + ({{ call.streams_fma_token_offset }}),
                {{ call.projection }} + ({{ call.projection_fma_base_offset }}), _fm_row, _fm_split,
                {{ call.hc }}, {{ call.hidden }}, {{ call.projection_splits }},
                {{ call.streams_fma_stream_stride }}, {{ call.streams_fma_hidden_stride }},
                {{ call.projection_fma_row_stride }}, {{ call.projection_fma_hidden_stride }},
                {{ call.symbol }}__dot_layout, {{ call.symbol }}__source_layout,
            )
            tl.store(_fm_work + _fm_row * {{ call.projection_splits }} + _fm_split, _fm_first)
            tl.store(_fm_work + (_fm_row + 1) * {{ call.projection_splits }} + _fm_split, _fm_second,
                     _fm_row + 1 < {{ call.coefficients }})
        else:
            _fm_square = _flagmega_mhc_square_split(
                {{ call.streams }} + ({{ call.streams_fma_token_offset }}), _fm_split,
                {{ call.hc }}, {{ call.hidden }}, {{ call.projection_splits }},
                {{ call.streams_fma_stream_stride }}, {{ call.streams_fma_hidden_stride }},
                {{ call.symbol }}__source_layout,
            )
            tl.store(_fm_work + {{ call.projection_square_start }} + _fm_split, _fm_square)
{% endif %}


@triton.jit(noinline=True)
def {{ call.symbol }}__mix({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{{ cta_coordinates() }}
    _fm_i = tl.arange(0, {{ call.stream_lanes }})
    _fm_stream_active = _fm_i < ({{ call.stream_active }})
    _fm_pair_active = _fm_stream_active[:, None] & _fm_stream_active[None, :]
    _fm_scale_pre = tl.load({{ call.scale }} + ({{ call.scale_offsets[0] }})).to(tl.float32)
    _fm_scale_post = tl.load({{ call.scale }} + ({{ call.scale_offsets[1] }})).to(tl.float32)
    _fm_scale_comb = tl.load({{ call.scale }} + ({{ call.scale_offsets[2] }})).to(tl.float32)
    for _fm_token in tl.range(_fm_cta, {{ call.token_active }}, _fm_ctas):
        _fm_work = {{ call.projection_partials }} + _fm_token * {{ call.projection_workspace_width }}
        _fm_rows = tl.arange(0, {{ call.projection_coefficient_lanes }})
        _fm_mixes = tl.zeros(({{ call.projection_coefficient_lanes }},), tl.float32)
{% if call.variant == "cooperative_contiguous_tf32" %}
        _fm_mixes = tle.gpu.set_layout(_fm_mixes, {{ call.symbol }}__mix_layout)
{% endif %}
        _fm_square_sum = tl.full((), 0., tl.float32)
        for _fm_split in tl.static_range({{ call.projection_splits }}):
            _fm_partial = tl.load(_fm_work + _fm_rows * {{ call.projection_splits }} + _fm_split,
                                  _fm_rows < {{ call.coefficients }}, other=0.)
{% if call.variant == "cooperative_contiguous_tf32" %}
            _fm_partial = tle.gpu.set_layout(_fm_partial, {{ call.symbol }}__mix_layout)
{% endif %}
            _fm_mixes = libdevice.add_rn(_fm_mixes, _fm_partial)
            _fm_square_sum = libdevice.add_rn(_fm_square_sum,
                tl.load(_fm_work + {{ call.projection_square_start }} + _fm_split))
        _fm_pre_mix = tl.gather(_fm_mixes, _fm_i, 0)
        _fm_post_mix = tl.gather(_fm_mixes, _fm_i + {{ call.hc }}, 0)
        _fm_comb_indices = {{ 2 * call.hc }} + _fm_i[:, None] * {{ call.hc }} + _fm_i[None, :]
        _fm_comb_mix = tl.reshape(tl.gather(_fm_mixes, tl.reshape(
            tl.minimum(_fm_comb_indices, {{ call.projection_coefficient_lanes - 1 }}),
            ({{ call.stream_lanes * call.stream_lanes }},)), 0),
            ({{ call.stream_lanes }}, {{ call.stream_lanes }}))
        _fm_rms = tl.rsqrt(_fm_square_sum / {{ call.elements }} + {{ call.epsilon }})
        _fm_pre_logits = tl.fma(_fm_pre_mix * _fm_rms, _fm_scale_pre,
            tl.load({{ call.base }} + ({{ call.base_pre_offset }}),
                    mask=_fm_stream_active, other=0.).to(tl.float32))
        _fm_post_logits = tl.fma(_fm_post_mix * _fm_rms, _fm_scale_post,
            tl.load({{ call.base }} + ({{ call.base_post_offset }}),
                    mask=_fm_stream_active, other=0.).to(tl.float32))
        _fm_pre = libdevice.div_rn(1., 1. + libdevice.exp(-_fm_pre_logits)) + {{ call.hc_epsilon }}
        _fm_post = libdevice.div_rn(1., 1. + libdevice.exp(-_fm_post_logits)) * {{ call.post_multiplier }}
        _fm_comb = tl.fma(_fm_comb_mix * _fm_rms, _fm_scale_comb,
            tl.load({{ call.base }} + ({{ call.base_comb_offset }}),
                    mask=_fm_pair_active, other=0.).to(tl.float32))
        _fm_comb = tl.where(_fm_pair_active, _fm_comb, float("-inf"))
        _fm_row_max = tl.where(_fm_stream_active[:, None], tl.max(_fm_comb, 1)[:, None], 0.)
        _fm_comb = tl.where(_fm_pair_active, libdevice.exp(_fm_comb - _fm_row_max), 0.)
        _fm_comb = libdevice.div_rn(_fm_comb, tl.where(_fm_stream_active[:, None],
                                       tl.sum(_fm_comb, 1)[:, None], 1.))
        _fm_comb = tl.where(_fm_pair_active, _fm_comb + {{ call.hc_epsilon }}, 0.)
        _fm_comb = libdevice.div_rn(_fm_comb, tl.sum(_fm_comb, 0)[None, :] + {{ call.hc_epsilon }})
        for _fm_iteration in tl.range(0, {{ call.sinkhorn_iterations - 1 }}):
            _fm_comb = libdevice.div_rn(_fm_comb, tl.sum(_fm_comb, 1)[:, None] + {{ call.hc_epsilon }})
            _fm_comb = libdevice.div_rn(_fm_comb, tl.sum(_fm_comb, 0)[None, :] + {{ call.hc_epsilon }})
        tl.store({{ call.post }} + ({{ call.post_offset }}), _fm_post, mask=_fm_stream_active)
        tl.store({{ call.comb }} + ({{ call.comb_offset }}), _fm_comb, mask=_fm_pair_active)
        tl.store(_fm_work + {{ call.projection_pre_start }} + _fm_i, _fm_pre, mask=_fm_stream_active)


@triton.jit(noinline=True)
def {{ call.symbol }}__collapse({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{{ cta_coordinates() }}
    _fm_i = tl.arange(0, {{ call.stream_lanes }})
    _fm_stream_active = _fm_i < ({{ call.stream_active }})
{% if call.independent_collapse_pre %}
    # Rotate collapse ownership away from the low CTA IDs doing Sinkhorn.
    # This is a permutation for every positive grid size, including one CTA.
    _fm_collapse_cta = (_fm_cta + _fm_ctas - ({{ call.tokens }} % _fm_ctas)) % _fm_ctas
    for _fm_task in tl.range(_fm_collapse_cta, ({{ call.token_active }}) * {{ (call.hidden + call.collapse_tile - 1) // call.collapse_tile }}, _fm_ctas):
{% else %}
    for _fm_task in tl.range(_fm_cta, ({{ call.token_active }}) * {{ (call.hidden + call.collapse_tile - 1) // call.collapse_tile }}, _fm_ctas):
{% endif %}
        _fm_token = _fm_task // {{ (call.hidden + call.collapse_tile - 1) // call.collapse_tile }}
        _fm_start = (_fm_task % {{ (call.hidden + call.collapse_tile - 1) // call.collapse_tile }}) * {{ call.collapse_tile }}
        _fm_work = {{ call.projection_partials }} + _fm_token * {{ call.projection_workspace_width }}
{% if call.independent_collapse_pre %}
        # The collapse needs only the pre rows and RMS, not post/comb or
        # Sinkhorn. Merge those already published partials in the same order.
        _fm_pre_mix = tl.zeros(({{ call.stream_lanes }},), tl.float32)
        _fm_square_sum = tl.full((), 0., tl.float32)
        for _fm_split in tl.static_range({{ call.projection_splits }}):
            _fm_partial = tl.load(_fm_work + _fm_i * {{ call.projection_splits }} + _fm_split,
                                  _fm_stream_active, other=0.)
            _fm_pre_mix = libdevice.add_rn(_fm_pre_mix, _fm_partial)
            _fm_square_sum = libdevice.add_rn(_fm_square_sum,
                tl.load(_fm_work + {{ call.projection_square_start }} + _fm_split))
        _fm_rms = tl.rsqrt(_fm_square_sum / {{ call.elements }} + {{ call.epsilon }})
        _fm_pre_logits = tl.fma(_fm_pre_mix * _fm_rms,
            tl.load({{ call.scale }} + ({{ call.scale_offsets[0] }})).to(tl.float32),
            tl.load({{ call.base }} + ({{ call.base_pre_offset }}),
                    mask=_fm_stream_active, other=0.).to(tl.float32))
        _fm_pre = libdevice.div_rn(1., 1. + libdevice.exp(-_fm_pre_logits)) + {{ call.hc_epsilon }}
{% else %}
        _fm_pre = tl.load(_fm_work + {{ call.projection_pre_start }} + _fm_i, _fm_stream_active, other=0.)
{% endif %}
{% if not call.collapse_sequential_fma %}
        _fm_pre = tle.gpu.set_layout(_fm_pre,
            tle.gpu.SlicedEncoding(1, {{ call.symbol }}__collapse_sum_layout))
{% endif %}
{% if call.collapse_sequential_fma %}
{% for source in range(call.hc) %}
        _fm_pre_{{ source }} = tl.reshape(tl.gather(
            _fm_pre, tl.full((1,), {{ source }}, tl.int32), 0), ())
{% endfor %}
{% endif %}
        _fm_hidden = _fm_start + tl.arange(0, {{ call.collapse_tile }})
        _fm_hidden_active = _fm_hidden < ({{ call.hidden_active }})
        _fm_plane = tl.load({{ call.streams }} + ({{ call.streams_plane_offset }}),
                            mask=_fm_stream_active[:, None] & _fm_hidden_active[None, :], other=0.).to(tl.float32)
{% if call.collapse_input_type is not none %}
        _fm_plane = _fm_plane.to({{ call.collapse_input_type }}).to(tl.float32)
{% endif %}
{% if call.collapse_sequential_fma %}
        _fm_collapsed = tl.full(({{ call.collapse_tile }},), 0., tl.float32)
{% for source in range(call.hc) %}
        _fm_plane_{{ source }} = tl.reshape(tl.gather(
            _fm_plane, tl.full((1, {{ call.collapse_tile }}), {{ source }}, tl.int32), 0),
            ({{ call.collapse_tile }},))
        _fm_collapsed = tl.fma(_fm_pre_{{ source }}, _fm_plane_{{ source }}, _fm_collapsed)
{% endfor %}
{% else %}
        _fm_plane = tle.gpu.set_layout(_fm_plane, {{ call.symbol }}__collapse_sum_layout)
        _fm_collapsed = tl.sum(_fm_pre[:, None] * _fm_plane, 0)
{% endif %}
        tl.store({{ call.collapsed }} + ({{ call.collapsed_offset }}),
                 _fm_collapsed.to({{ call.collapsed_type }}), mask=_fm_hidden_active)


{% if call.independent_collapse_pre %}
@triton.jit
def {{ call.symbol }}({{ call.signature }}):
    {{ call.symbol }}__project({{ call.signature }})
{{ entry.stage_barrier() }}
    {{ call.symbol }}__mix({{ call.signature }})
    {{ call.symbol }}__collapse({{ call.signature }})
{% else %}
{{ entry.phase_schedule(call, ("project", "mix", "collapse")) }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
