# flagmega-kernel: mhc_pre/{{ mhc_projection_variant | default("stream_fma") }} platform=generic
{% if render_calls is defined %}
{% import "entrypoints/_common.py.jinja" as entry with context %}
import triton.experimental.tle.language as tle
{% if mhc_projection_variant | default("stream_fma") == "stream_fma" %}
{% include "kernels/mhc_pre/_stream_projection.py.jinja" %}
{% else %}
{% include "kernels/mhc_pre/_contiguous_projection.py.jinja" %}
{% endif %}
{% for call in render_calls %}
{% if call.family == "mhc_pre" and call.variant == mhc_projection_variant | default("stream_fma") %}
{{ call.symbol }}__dot_layout = tl.constexpr(tle.gpu.BlockEncoding(
    [1, 1, 1], [1, 1, 32],
    [{{ [num_warps // 4, 2] | min }}, {{ num_warps // (4 * ([num_warps // 4, 2] | min)) }}, 4], [2, 1, 0],
))
{{ call.symbol }}__source_layout = tl.constexpr(tle.gpu.SlicedEncoding(0, {{ call.symbol }}__dot_layout))
{{ call.symbol }}__mix_layout = tl.constexpr(tle.gpu.BlockEncoding([1], [32], [{{ num_warps }}], [0]))
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    _fm_i = tl.arange(0, {{ call.stream_lanes }})
    _fm_stream_active = _fm_i < ({{ call.stream_active }})
    _fm_pair_active = _fm_stream_active[:, None] & _fm_stream_active[None, :]
    _fm_scale_pre = tl.load({{ call.scale }} + ({{ call.scale_offsets[0] }})).to(tl.float32)
    _fm_scale_post = tl.load({{ call.scale }} + ({{ call.scale_offsets[1] }})).to(tl.float32)
    _fm_scale_comb = tl.load({{ call.scale }} + ({{ call.scale_offsets[2] }})).to(tl.float32)
    for _fm_token in tl.range(0, {{ call.token_active }}):
        _fm_mixes, _fm_square_sum = {{ "_flagmega_mhc_stream_projection" if call.variant == "stream_fma" else "_flagmega_mhc_contiguous_projection" }}(
            {{ call.streams }} + ({{ call.streams_fma_token_offset }}),
            {{ call.projection }} + ({{ call.projection_fma_base_offset }}),
            {{ call.hc }}, {{ call.hidden }}, {{ call.projection_splits }},
            {{ call.streams_fma_stream_stride }}, {{ call.streams_fma_hidden_stride }},
            {{ call.projection_fma_row_stride }}, {{ call.projection_fma_hidden_stride }},
            {{ call.symbol }}__dot_layout, {{ call.symbol }}__source_layout, {{ call.symbol }}__mix_layout,
        )
        _fm_pre_mix = tl.gather(_fm_mixes, _fm_i, 0)
        _fm_post_mix = tl.gather(_fm_mixes, _fm_i + {{ call.hc }}, 0)
        _fm_comb_indices = {{ 2 * call.hc }} + _fm_i[:, None] * {{ call.hc }} + _fm_i[None, :]
        _fm_comb_mix = tl.reshape(tl.gather(_fm_mixes, tl.reshape(
            tl.minimum(_fm_comb_indices, {{ call.projection_coefficient_lanes - 1 }}),
            ({{ call.stream_lanes * call.stream_lanes }},)), 0),
            ({{ call.stream_lanes }}, {{ call.stream_lanes }}))
        # RMS without a mean term, over all hc_mult * hidden stream elements.
        _fm_rms = tl.rsqrt(_fm_square_sum / {{ call.elements }} + {{ call.epsilon }})
        # The floor added to pre is the hyper-connection epsilon, not the RMS
        # one: GLM-5.3 ships 1e-6 and 1e-5, so the two are not interchangeable.
        # Keep the normalized projection's rounding before the scale/bias FMA.
        # Accurate exp and division also avoid amplifying reciprocal errors
        # across the repeated Sinkhorn sweeps.
        _fm_pre_logits = tl.fma(_fm_pre_mix * _fm_rms, _fm_scale_pre,
            tl.load({{ call.base }} + ({{ call.base_pre_offset }}),
                    mask=_fm_stream_active, other=0.).to(tl.float32))
        _fm_post_logits = tl.fma(_fm_post_mix * _fm_rms, _fm_scale_post,
            tl.load({{ call.base }} + ({{ call.base_post_offset }}),
                    mask=_fm_stream_active, other=0.).to(tl.float32))
        _fm_pre = libdevice.div_rn(1., 1. + libdevice.exp(-_fm_pre_logits)) + {{ call.hc_epsilon }}
        _fm_post = libdevice.div_rn(1., 1. + libdevice.exp(-_fm_post_logits)) * {{ call.post_multiplier }}
        _fm_comb = tl.fma(_fm_comb_mix * _fm_rms, _fm_scale_comb,
            tl.load({{ call.base }} + ({{ call.base_comb_offset }}),
                    mask=_fm_pair_active, other=0.).to(tl.float32))
        # Softmax over the sink axis. Inactive lanes exist only when hc_mult is
        # not a power of two; they are held out of the max and the sum so they
        # cannot contribute a NaN that the Sinkhorn sweeps would then spread.
        _fm_comb = tl.where(_fm_pair_active, _fm_comb, float("-inf"))
        _fm_row_max = tl.where(_fm_stream_active[:, None], tl.max(_fm_comb, 1)[:, None], 0.)
        _fm_comb = tl.where(_fm_pair_active, libdevice.exp(_fm_comb - _fm_row_max), 0.)
        _fm_comb = libdevice.div_rn(_fm_comb, tl.where(_fm_stream_active[:, None],
                                       tl.sum(_fm_comb, 1)[:, None], 1.))
        _fm_comb = tl.where(_fm_pair_active, _fm_comb + {{ call.hc_epsilon }}, 0.)
        # Sinkhorn-Knopp: the first sweep normalizes the source axis only, then
        # each remaining iteration normalizes sink then source. The epsilon in
        # every denominator is part of the reference contract, not a guard.
        _fm_comb = libdevice.div_rn(_fm_comb, tl.sum(_fm_comb, 0)[None, :] + {{ call.hc_epsilon }})
        for _fm_iteration in tl.range(0, {{ call.sinkhorn_iterations - 1 }}):
            _fm_comb = libdevice.div_rn(_fm_comb, tl.sum(_fm_comb, 1)[:, None] + {{ call.hc_epsilon }})
            _fm_comb = libdevice.div_rn(_fm_comb, tl.sum(_fm_comb, 0)[None, :] + {{ call.hc_epsilon }})
        tl.store({{ call.post }} + ({{ call.post_offset }}), _fm_post,
                 mask=_fm_stream_active & ({{ call.post_writer_active }}))
        tl.store({{ call.comb }} + ({{ call.comb_offset }}), _fm_comb,
                 mask=_fm_pair_active & ({{ call.comb_writer_active }}))
        # Pass two: collapse the streams with the pre coefficients. The sum is
        # accumulated in FP32 and only the result converts to collapsed_type.
{% if call.collapse_sequential_fma %}
{% for source in range(call.hc) %}
        _fm_pre_{{ source }} = tl.reshape(tl.gather(
            _fm_pre, tl.full((1,), {{ source }}, tl.int32), 0), ())
{% endfor %}
{% endif %}
        for _fm_start in tl.range(0, {{ call.hidden }}, {{ call.collapse_tile }}):
            _fm_hidden = _fm_start + tl.arange(0, {{ call.collapse_tile }})
            _fm_hidden_active = _fm_hidden < ({{ call.hidden_active }})
            _fm_plane = tl.load(
                {{ call.streams }} + ({{ call.streams_plane_offset }}),
                mask=_fm_stream_active[:, None] & _fm_hidden_active[None, :],
                other=0.).to(tl.float32)
{% if call.collapse_input_type is not none %}
            _fm_plane = _fm_plane.to({{ call.collapse_input_type }}).to(tl.float32)
{% endif %}
{% if call.collapse_sequential_fma %}
            _fm_collapsed = tl.full(({{ call.collapse_tile }},), 0., tl.float32)
{% for source in range(call.hc) %}
            _fm_plane_{{ source }} = tl.reshape(tl.gather(
                _fm_plane, tl.full((1, {{ call.collapse_tile }}), {{ source }}, tl.int32), 0),
                ({{ call.collapse_tile }},))
            _fm_collapsed = tl.fma(_fm_pre_{{ source }}, _fm_plane_{{ source }}, _fm_collapsed)
{% endfor %}
{% else %}
            _fm_collapsed = tl.sum(_fm_pre[:, None] * _fm_plane, 0)
{% endif %}
            tl.store({{ call.collapsed }} + ({{ call.collapsed_offset }}),
                     _fm_collapsed.to({{ call.collapsed_type }}),
                     mask=_fm_hidden_active & ({{ call.collapsed_writer_active }}))

{% endif %}
{% endfor %}
{% endif %}
