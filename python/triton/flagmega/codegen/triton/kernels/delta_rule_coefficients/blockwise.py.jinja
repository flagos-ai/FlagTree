    _fm_row = tl.arange(0, 64)
    _fm_col = tl.arange(0, 64)
    _fm_feature = tl.arange(0, {{ call.key_tile }})
    for _fm_work in range({{ call.blocks }} * {{ call.heads }}):
        _fm_block = _fm_work // {{ call.heads }}
        _fm_head = _fm_work % {{ call.heads }}
        _fm_tokens = _fm_block * {{ call.block_size }} + _fm_row
        _fm_active = (_fm_row < {{ call.block_size }}) & (_fm_tokens < {{ call.tokens }})
        _fm_key = tl.load({{ call.key }} + ({{ call.key_offset }}),
                          _fm_active[:, None] & (_fm_feature[None, :] < {{ call.key_dim }}), other=0.0)
        _fm_beta = tl.load({{ call.beta }} + ({{ call.beta_offset }}), _fm_active, other=0.0)
        _fm_coefficients = _flagmega_delta_rule_coefficients_tile(_fm_key, _fm_beta)
        _fm_values = tl.where(_fm_active[:, None] & _fm_active[None, :], _fm_coefficients, 0.0)
        tl.store({{ call.result }} + ({{ call.result_offset }}), _fm_values,
                  (_fm_row[:, None] < {{ call.block_size }}) & (_fm_col[None, :] < {{ call.block_size }})
                  & ({{ call.writer_active }}))


