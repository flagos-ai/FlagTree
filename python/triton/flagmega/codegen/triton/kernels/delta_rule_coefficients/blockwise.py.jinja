# flagmega-kernel: delta_rule_coefficients/blockwise
@triton.jit
def _flagmega_delta_rule_coefficients_tile(key, beta):
    row = tl.arange(0, 64)
    col = tl.arange(0, 64)
    matrix = tl.dot(key, tl.trans(key)) * beta[:, None]
    matrix = tl.where(row[:, None] > col[None, :], matrix, 0.0).to(tl.float16).to(tl.float32)
    matrix = tl.where(row[:, None] == col[None, :], 1.0, matrix)
    same_group = row[:, None] // 8 == col[None, :] // 8
    for pivot in tl.static_range(7):
        factor = -tl.sum(tl.where(same_group & (col[None, :] % 8 == pivot), matrix, 0.0), 1)
        source_row = tl.broadcast_to((row // 8 * 8 + pivot)[:, None], (64, 64))
        source = tl.gather(matrix, source_row, 0)
        update = same_group & (row[:, None] % 8 > pivot)
        matrix = tl.where(update & (col[None, :] % 8 < pivot), tl.fma(factor[:, None], source, matrix), matrix)
        matrix = tl.where(update & (col[None, :] % 8 == pivot), factor[:, None], matrix)
    matrix = matrix.to(tl.float16)
    for level in tl.static_range(3):
        width = 16 << level
        half = width // 2
        same_block = row[:, None] // width == col[None, :] // width
        top = row[:, None] % width < half
        left = col[None, :] % width < half
        a = tl.where(same_block & top & left, matrix, 0.0).to(tl.float16)
        d = tl.where(same_block & ~top & ~left, matrix, 0.0).to(tl.float16)
        c = tl.where(same_block & ~top & left, matrix, 0.0).to(tl.float16)
        product = (-tl.dot(d, c)).to(tl.float16)
        if width == 64:
            p0 = tl.where(col[None, :] < 16, product, 0.0).to(tl.float16)
            p1 = tl.where(col[None, :] >= 16, product, 0.0).to(tl.float16)
            lower = (tl.dot(p0, a).to(tl.float16) + tl.dot(p1, a).to(tl.float16)).to(tl.float16)
        else:
            lower = tl.dot(product, a).to(tl.float16)
        matrix = tl.where(same_block & ~top & left, lower, matrix)
    return (matrix.to(tl.float32) * beta[None, :]).to(tl.bfloat16)

