{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "elementwise" and call.variant == elementwise_variant %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{% if call.task_launch_recipe | default(none) %}
{% if call.task_launch_recipe.program_kind == 'persistent' %}
    for local_start in tl.range(tl.program_id(0) * {{ call.tile }}, {{ call.local_capacity }}, tl.num_programs(0) * {{ call.tile }}):
{% else %}
    for local_start in tl.range(tl.program_id(0) * {{ call.tile }}, (tl.program_id(0) + 1) * {{ call.tile }}, {{ call.tile }}):
{% endif %}
{% else %}
    for local_start in tl.range(0, {{ call.local_capacity }}, {{ call.tile }}):
{% endif %}
        local_offsets = local_start + tl.arange(0, {{ call.tile }})
        local_mask = (
            (local_offsets < {{ call.local_capacity }}) & ({{ call.active }})
        )
        lhs_value = tl.load(
            {{ call.lhs }} + (({{ call.lhs_offset }}) + tl.zeros_like(local_offsets)),
            mask=local_mask & ({{ call.lhs_read_active | default('True') }}),
            other={{ call.lhs_other | default(0.0) }},
        )
{% if call.variant in ("add", "mul", "div") %}
        rhs_value = tl.load(
            {{ call.rhs }} + (({{ call.rhs_offset }}) + tl.zeros_like(local_offsets)),
            mask=local_mask & ({{ call.rhs_read_active | default('True') }}),
            other={{ call.rhs_other | default(0.0) }},
        )
{% endif %}
{% for line in call.fusion_lines %}
        {{ line }}
{% endfor %}
        tl.store(
            {{ call.result }} + (({{ call.result_offset }}) + tl.zeros_like(local_offsets)),
{% if call.fusion_lines %}
            {{ call.fusion_value }},
{% elif call.variant == "add" %}
            lhs_value + rhs_value,
{% elif call.variant == "mul" %}
            lhs_value * rhs_value,
{% elif call.variant == "div" %}
            tl.div_rn(lhs_value.to(tl.float32), rhs_value.to(tl.float32)),
{% elif call.variant == "sigmoid" %}
            tl.sigmoid(lhs_value.to(tl.float32)),
{% elif call.variant == "silu" %}
{% if call.math_mode | default('fast') == "accurate" %}
            lhs_value.to(tl.float32) / (1.0 + libdevice.exp(-lhs_value.to(tl.float32))),
{% else %}
            lhs_value.to(tl.float32) * tl.sigmoid(lhs_value.to(tl.float32)),
{% endif %}
{% elif call.variant == "cast" %}
            lhs_value.to({{ call.output_type }}),
{% endif %}
            mask=local_mask,
        )


{% endif %}
{% endfor %}
