{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "elementwise" and call.variant == elementwise_variant %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for local_start in tl.range(0, {{ call.local_capacity }}, {{ call.tile }}):
        local_offsets = local_start + tl.arange(0, {{ call.tile }})
        local_mask = (
            (local_offsets < {{ call.local_capacity }}) & ({{ call.active }})
        )
        lhs_value = tl.load(
            {{ call.lhs }} + ({{ call.lhs_offset }}),
            mask=local_mask,
            other=0.0,
        )
{% if call.variant in ("add", "mul") %}
        rhs_value = tl.load(
            {{ call.rhs }} + ({{ call.rhs_offset }}),
            mask=local_mask,
            other=0.0,
        )
{% endif %}
        tl.store(
            {{ call.result }} + ({{ call.result_offset }}),
{% if call.variant == "add" %}
            lhs_value + rhs_value,
{% elif call.variant == "mul" %}
            lhs_value * rhs_value,
{% elif call.variant == "silu" %}
            lhs_value.to(tl.float32) * tl.sigmoid(lhs_value.to(tl.float32)),
{% elif call.variant == "cast" %}
            lhs_value.to({{ call.output_type }}),
{% endif %}
            mask=local_mask,
        )


{% endif %}
{% endfor %}
