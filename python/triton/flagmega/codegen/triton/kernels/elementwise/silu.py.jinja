# flagmega-kernel: elementwise/silu platform=generic
{% set elementwise_variant = "silu" %}
{% set physical_block = elementwise_block | default('block') %}
{% include "kernels/elementwise/packed_axes.py.jinja" %}
@triton.jit
def _flagmega_elementwise_silu(source, destination, size: tl.constexpr, block: tl.constexpr):
    schedule_offsets = tl.program_id(0) * {{ physical_block }} + tl.arange(0, {{ physical_block }})
    offsets, mask = _flagmega_elementwise_packed_offsets(schedule_offsets, size)
    value = tl.load(source + offsets, mask=mask).to(tl.float32)
    tl.store(destination + offsets, value * tl.sigmoid(value), mask=mask)
{% if render_calls is defined %}
{% include "kernels/elementwise/_function.py.jinja" %}
{% endif %}
