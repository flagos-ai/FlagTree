# flagmega-kernel: elementwise/add platform=generic
{% set elementwise_variant = "add" %}
{% set physical_block = elementwise_block | default('block') %}
{% include "kernels/elementwise/packed_axes.py.jinja" %}
@triton.jit
def _flagmega_elementwise_add(lhs, rhs, destination, size: tl.constexpr, block: tl.constexpr):
    program_count = tl.num_programs(0)
    for start in tl.range(tl.program_id(0) * {{ physical_block }}, size, program_count * {{ physical_block }}):
        schedule_offsets = start + tl.arange(0, {{ physical_block }})
        offsets, mask = _flagmega_elementwise_packed_offsets(schedule_offsets, size)
        tl.store(destination + offsets, tl.load(lhs + offsets, mask=mask) + tl.load(rhs + offsets, mask=mask), mask=mask)
