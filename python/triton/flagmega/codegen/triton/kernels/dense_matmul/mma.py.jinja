# flagmega-kernel: dense_matmul/mma (platform-neutral bf16 WMMA GEMM, M>1)
{% import "entrypoints/_common.py.jinja" as entry with context %}
{% set dense_matmul_variant = "mma" %}
{% if render_calls is defined %}
{% for call in render_calls %}
{% if call.family == "dense_matmul" and call.variant == "mma" %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    dense_m_offsets = tl.arange(0, {{ call.local_m_capacity }})
    m_mask = dense_m_offsets < ({{ call.m_active_extent }})
    for dense_local_n_start in tl.range(0, {{ call.local_n_capacity }}, {{ call.tile_n }}):
        dense_local_n_offsets = dense_local_n_start + tl.arange(0, {{ call.tile_n }})
        dense_global_n = {{ call.global_n }}
        dense_n_mask = (
            (dense_local_n_offsets < {{ call.local_n_capacity }})
            & (dense_local_n_offsets < ({{ call.n_active_extent }}))
        )
        dense_accumulator = tl.zeros(({{ call.local_m_capacity }}, {{ call.tile_n }}), tl.float32)
        for dense_local_k_start in tl.range(0, {{ call.local_k_capacity }}, {{ call.block_k }}):
            dense_local_k_offsets = dense_local_k_start + tl.arange(0, {{ call.block_k }})
            dense_global_k = {{ call.global_k }}
            dense_k_mask = dense_local_k_offsets < ({{ call.k_active_extent }})
            dense_a_tile = tl.load(
                {{ call.source }} + ({{ call.source_offset }}),
                mask=m_mask[:, None] & dense_k_mask[None, :], other=0.0,
            )
            dense_w_tile = tl.load(
                {{ call.weight }} + ({{ call.weight_offset }}),
                mask=dense_n_mask[:, None] & dense_k_mask[None, :], other=0.0,
            )
            dense_accumulator += tl.dot(
                dense_a_tile, tl.trans(dense_w_tile), out_dtype=tl.float32,
            )
        tl.store(
            {{ call.result }} + ({{ call.result_offset }}),
            dense_accumulator.to({{ call.output_type }}),
            mask=m_mask[:, None] & dense_n_mask[None, :],
        )
{% endif %}
{% endfor %}
{% endif %}
