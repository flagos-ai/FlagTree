{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "dense_matmul" and call.variant == dense_matmul_variant %}
{{ entry.kernel_decorator(call, prefer_inline=true) }}  {#- prefer_inline=true. Trials 13-15 measured this backend losing a
   deferred-upcast micro-optimization across a `noinline` boundary (0.119 ->
   0.098 ms on one operator, bitwise-identical output). Trial 55 re-tested
   and REVERTED it: projection_wide regressed 6.6% under the conditions of
   the time. Re-tested again after the GEMV retune, the per-variant and
   per-site tiles, and the two template fixes: it is now worth -0.019
   ms/token (9.505 -> 9.486, interleaved, token-exact at ctx 1/40/300/600).
   A correctly-rejected decision expires when the workload around it
   changes -- the same reason the GLU reduction tile had to be re-swept.
   Scoped deliberately: enabling this on qkv_parallel_linear and
   packed_k_major_gemv_norm_stats as well measured +0.018, so only this
   template and dense_matmul_glu carry it. #}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
{% if call.local_m_capacity != 1 %}
    for dense_local_m in tl.range(0, {{ call.local_m_capacity }}):
{% endif %}
{% filter indent(4 if call.local_m_capacity != 1 else 0, first=True) %}
    for dense_local_n_start in tl.range(
        0, {{ call.local_n_capacity }}, {{ call.tile_n }}
    ):
        dense_local_n_offsets = dense_local_n_start + tl.arange(0, {{ call.tile_n }})
        dense_global_n = {{ call.global_n }}
        {# Mask elision when bounds divide exactly and the active
           predicate folded to literal True -- see the matching note in
           qkv_parallel_linear/packed_fused_gemv.py.jinja (Trial 65). #}
        {% set dense_n_masked = (call.local_n_capacity % call.tile_n != 0) or (call.result_active != "True") %}
        {% if dense_n_masked %}
        dense_n_mask = (
            (dense_local_n_offsets < {{ call.local_n_capacity }})
            & ({{ call.result_active }})
        )
        {% endif %}
{% if dense_matmul_uses_descriptor %}
        dense_accumulator = tl.zeros(({{ call.tile_n }},), tl.float32)
{% else %}
        {# 2D accumulator with the k-axis reduce deferred to loop exit:
           see qkv_parallel_linear/packed_fused_gemv.py.jinja (Trial 60)
           -- deferring broke the per-iteration reduce->add->reload
           serial chain and measured -25.7% on BI-V150. The descriptor
           path keeps the 1D form because its accumulate helper already
           returns per-k-block reduced vectors. #}
        dense_accumulator = tl.zeros(
            ({{ call.tile_n }}, {{ call.block_k }}), tl.float32
        )
{% endif %}
        for dense_local_k_start in tl.range(
            0, {{ call.local_k_capacity }}, {{ call.block_k }}
        ):
            dense_local_k_offsets = dense_local_k_start + tl.arange(0, {{ call.block_k }})
            dense_global_k = {{ call.global_k }}
            {% set dense_k_masked = (call.local_k_capacity % call.block_k != 0) or (call.source_active != "True") %}
            {% if dense_k_masked or dense_matmul_uses_descriptor %}
            dense_k_mask = (
                (dense_local_k_offsets < {{ call.local_k_capacity }})
                & ({{ call.source_active }})
            )
            {% endif %}
{% if dense_matmul_uses_descriptor %}
            dense_accumulator += {{ call.accumulate_helper }}(
                {{ call.source }}, {{ call.weight_descriptor }},
                {{ call.source_offset }},
                {{ call.descriptor_n_offset }}, {{ call.descriptor_k_offset }},
                dense_k_mask, {{ call.transpose_b }},
            )
{% else %}
{# Preserve FP32 products while deferring the K reduction. #}
            {% if dense_k_masked %}
            dense_source_value = tl.load(
                {{ call.source }} + ({{ call.source_offset }}),
                mask=dense_k_mask, other=0.0,
            )
            {% else %}
            dense_source_value = tl.load({{ call.source }} + ({{ call.source_offset }}))
            {% endif %}
            {% if dense_n_masked and dense_k_masked %}
            dense_weight_value = tl.load(
                {{ call.weight }} + ({{ call.weight_offset }}),
                mask=dense_n_mask[:, None] & dense_k_mask[None, :],
                other=0.0,
            )
            {% elif dense_n_masked %}
            dense_weight_value = tl.load(
                {{ call.weight }} + ({{ call.weight_offset }}),
                mask=dense_n_mask[:, None],
                other=0.0,
            )
            {% elif dense_k_masked %}
            dense_weight_value = tl.load(
                {{ call.weight }} + ({{ call.weight_offset }}),
                mask=dense_k_mask[None, :],
                other=0.0,
            )
            {% else %}
            dense_weight_value = tl.load({{ call.weight }} + ({{ call.weight_offset }}))
            {% endif %}
            dense_accumulator += (
                dense_weight_value.to(tl.float32) * dense_source_value[None, :].to(tl.float32)
            ).to(tl.float32)
{% endif %}
{% if dense_matmul_uses_descriptor %}
        dense_result = dense_accumulator
{% else %}
        dense_result = tl.sum(dense_accumulator, axis=1)
{% endif %}
        {% if dense_n_masked %}
        tl.store(
            {{ call.result }} + ({{ call.result_offset }}),
            dense_result.to({{ call.output_type }}),
            mask=dense_n_mask,
        )
        {% else %}
        tl.store(
            {{ call.result }} + ({{ call.result_offset }}),
            dense_result.to({{ call.output_type }}),
        )
        {% endif %}
{% endfilter %}


{% endif %}
{% endfor %}
