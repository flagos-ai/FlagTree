# flagmega-kernel: dense_matmul/tensor_descriptor_gemv platform=generic
{% set dense_matmul_variant = "tensor_descriptor_gemv" %}
{% set dense_matmul_uses_descriptor = true %}
@triton.jit
def _flagmega_dense_matmul_tensor_descriptor_gemv_accumulate(
    source,
    weight_descriptor,
    source_offsets,
    descriptor_n_offset,
    descriptor_k_offset,
    k_mask,
    transpose_b: tl.constexpr,
):
    """Accumulate one M=1 GEMV tile loaded through a host tensor descriptor."""
    source_value = tl.load(
        source + source_offsets, mask=k_mask, other=0.0,
    ).to(tl.float32)
    if transpose_b:
        weight_value = weight_descriptor.load(
            [descriptor_n_offset, descriptor_k_offset]
        )
    else:
        weight_value = tl.trans(weight_descriptor.load(
            [descriptor_k_offset, descriptor_n_offset]
        ))
    return tl.sum(
        weight_value.to(tl.float32) * source_value[None, :], axis=1
    )
