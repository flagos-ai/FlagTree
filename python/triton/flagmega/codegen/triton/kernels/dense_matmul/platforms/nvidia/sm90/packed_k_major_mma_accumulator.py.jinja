# flagmega-kernel: dense_matmul/packed_k_major_mma_accumulator platform=nvidia architecture=sm90
{% if render_calls is defined %}
{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "dense_matmul" and call.variant == "packed_k_major_mma_accumulator" %}
import triton.experimental.tle.language as tle
{{ call.symbol }}__mma_layout = tl.constexpr(tle.gpu.MmaEncoding(
    [2, 0], [1, {{ num_warps }}], [16, 8],
))
{{ call.symbol }}__lhs_layout = tl.constexpr(tle.gpu.DotOperandEncoding(0, {{ call.symbol }}__mma_layout, 2))
{{ call.symbol }}__rhs_layout = tl.constexpr(tle.gpu.DotOperandEncoding(1, {{ call.symbol }}__mma_layout, 2))
{% if call.coalesced_weight_load %}
{% set load_warps_n = [num_warps, call.tile_n // 4] | min %}
{{ call.symbol }}__weight_load_layout = tl.constexpr(tle.gpu.BlockEncoding(
    [1, 2], [4, 8], [{{ load_warps_n }}, {{ num_warps // load_warps_n }}], [1, 0],
))
{% endif %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for dense_local_m in tl.range(0, {{ call.local_m_capacity }}):
        for dense_local_n_start in tl.range(0, {{ call.local_n_capacity }}, {{ call.tile_n }}):
            dense_local_n_offsets = dense_local_n_start + tl.arange(0, {{ call.tile_n }})
            dense_global_n = {{ call.global_n }}
            dense_n_mask = ((dense_local_n_offsets < {{ call.local_n_capacity }}) & ({{ call.result_active }}))
            dense_total = tl.zeros(({{ call.tile_n }},), tl.float32)
            for dense_partition in tl.range(0, {{ call.accumulation_splits }}):
                dense_accumulator = tle.gpu.set_layout(
                    tl.zeros((16, {{ call.tile_n }}), tl.float32), {{ call.symbol }}__mma_layout,
                )
                for dense_partition_k in tl.range(0, {{ call.partition_k }}, {{ call.block_k }}):
                    dense_local_k_offsets = (dense_partition * {{ call.partition_k }} + dense_partition_k
                                             + tl.arange(0, {{ call.block_k }}))
                    dense_global_k = {{ call.global_k }}
                    dense_k_mask = ((dense_local_k_offsets < {{ call.local_k_capacity }}) & ({{ call.source_active }}))
                    dense_source_value = tl.load({{ call.source }} + ({{ call.source_offset }}), mask=dense_k_mask, other=0.)
                    dense_weight_value = tl.load({{ call.weight }} + ({{ call.weight_offset }}),
                                                mask=dense_n_mask[:, None] & dense_k_mask[None, :], other=0.)
{% if call.coalesced_weight_load %}
                    # Load each K16 packet across independent warp owners.
                    # Replication belongs to the MMA fragment conversion,
                    # not the global pointer tensor and its live addresses.
                    dense_weight_value = tle.gpu.set_layout(dense_weight_value, {{ call.symbol }}__weight_load_layout)
{% endif %}
                    dense_activation_matrix = tl.broadcast_to(dense_source_value[None, :], (16, {{ call.block_k }}))
                    dense_activation_matrix = tle.gpu.set_layout(dense_activation_matrix, {{ call.symbol }}__lhs_layout)
                    dense_weight_matrix = tle.gpu.set_layout(tl.trans(dense_weight_value), {{ call.symbol }}__rhs_layout)
                    dense_accumulator = tl.dot(dense_activation_matrix, dense_weight_matrix, dense_accumulator)
                dense_partial = tl.reshape(tl.gather(
                    dense_accumulator, tl.full((1, {{ call.tile_n }}), 0, tl.int32), 0,
                ), ({{ call.tile_n }},))
                dense_total = libdevice.add_rn(dense_total, dense_partial)
            # The explicit accumulator PostOps cast, when present, rounds
            # here after the complete ordered FP32 reduction.
            tl.store({{ call.result }} + ({{ call.result_offset }}), dense_total.to({{ call.output_type }}), mask=dense_n_mask)


{% endif %}
{% endfor %}
{% endif %}
