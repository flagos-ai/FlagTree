# flagmega-kernel: kda_input_projection/mma platform=nvidia architecture=sm90
{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls | default(()) %}
{% if call.family == "kda_input_projection" and call.variant == "mma" %}
import triton.experimental.tle.language as tle
{{ call.symbol }}__mma_layout = tl.constexpr(tle.gpu.MmaEncoding([2, 0], [{{ num_warps }}, 1], [16, 8]))
{{ call.symbol }}__weight_layout = tl.constexpr(tle.gpu.DotOperandEncoding(0, {{ call.symbol }}__mma_layout, 2))
{{ call.symbol }}__value_layout = tl.constexpr(tle.gpu.DotOperandEncoding(1, {{ call.symbol }}__mma_layout, 2))


{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for _fm_task in tl.range(block_index, {{ call.tasks }}, tl.num_programs(0)):
{% for field in call.fields %}
        {{ field.branch }}
            _fm_row = (_fm_task - {{ field.start }}) * 64
            _fm_rows = {{ field.rows }}
            _fm_weight = {{ field.weight }}
            _fm_destination = {{ field.output }}
{% endfor %}
        _fm_n = _fm_row + tl.arange(0, 64)
        _fm_accumulator = tle.gpu.set_layout(tl.zeros((64, 16), tl.float32), {{ call.symbol }}__mma_layout)
        for _fm_start in tl.range(0, {{ call.reduction }}, {{ call.block_k }}):
            _fm_k = _fm_start + tl.arange(0, {{ call.block_k }})
            _fm_w = tl.load(_fm_weight + _fm_n[:, None] * {{ call.reduction }} + _fm_k[None, :],
                            (_fm_n[:, None] < _fm_rows) & (_fm_k[None, :] < {{ call.reduction }}), other=0.)
            _fm_x = tl.load({{ call.source }} + _fm_k, _fm_k < {{ call.reduction }}, other=0.)
            _fm_a = tle.gpu.set_layout(_fm_w, {{ call.symbol }}__weight_layout)
            _fm_b = tle.gpu.set_layout(tl.broadcast_to(_fm_x[:, None], ({{ call.block_k }}, 16)), {{ call.symbol }}__value_layout)
            _fm_accumulator = tl.dot(_fm_a, _fm_b, _fm_accumulator)
        _fm_result = tl.reshape(tl.gather(_fm_accumulator, tl.full((64, 1), 0, tl.int32), 1), (64,))
        tl.store(_fm_destination + _fm_n, _fm_result.to(tl.bfloat16), _fm_n < _fm_rows)
{% endif %}
{% endfor %}
