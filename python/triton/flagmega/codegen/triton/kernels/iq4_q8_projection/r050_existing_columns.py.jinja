{# Preserve the currently selected column arithmetic; add R049 inline hints. #}
import triton.experimental.tle.language.gpu as gpu
{% for call in render_calls %}
{% if call.variant == "r050_projection_consumer_prefetch_v1" and call.family == "iq4_q8_projection" and call.constexprs.COLS > 1 %}
E=tl.constexpr(gpu.BlockEncoding([1,1],[1,32],[{{call.cta_warps}},1],[1,0]))
@triton.jit
def partial_store(p, S, w, l, plane: tl.constexpr):
    # Warp0 has no payload store. Its materialized pointer remains in range.
    index = plane * 96 + 32 * tl.maximum(w - 1, 0) + l
    ptr = gpu.set_layout(gpu.local_ptr(S, (index,), shape=(4, 32)), E)
    tl.store(ptr, p, w > 0)


@triton.jit
def partial_read(p, S, w, l, plane: tl.constexpr):
    for t in tl.static_range(3):
        index = plane * 96 + 32 * t + l
        ptr = gpu.set_layout(gpu.local_ptr(S, (index,), shape=(4, 32)), E)
        v = tl.load(ptr, w == 0, 0)
        p = tl.inline_asm_elementwise(
            "add.rn.f32 $0,$1,$2;", constraints="=f,f,f",
            args=[p, v], dtype=tl.float32, is_pure=True, pack=1)
    return gpu.set_layout(p, E)


@triton.jit
def warp0_sum(p, w, l):
    # Uniform warp branch; every lane in warp0 reaches all five full-mask shuffles.
    for off in tl.static_range(5):
        p = tl.inline_asm_elementwise("""{
.reg .pred z; .reg .b32 v;
setp.eq.u32 z,$2,0; @!z bra DONE;
shfl.sync.bfly.b32 v,$1,$3,0x1f,0xffffffff;
add.rn.f32 $0,$1,v; bra END;
DONE: mov.b32 $0,0; END:
}""", constraints="=f,f,r,r", args=[p, w, 16 >> off],
            dtype=tl.float32, is_pure=False, pack=1)
    return gpu.set_layout(tl.where((w == 0) & (l == 0), p, 0.), E)


@triton.jit
def typed_reduce(p, u, w, l, GLU: tl.constexpr):
    # Physical affine arena: exact effective capacity, no compiler padding.
    S = gpu.alloc((192 if GLU else 96,), tl.float32, layout=None,
                  nv_mma_shared_layout=False, alignment_bytes=16)
    partial_store(p, S, w, l, 0)
    if GLU:
        partial_store(u, S, w, l, 1)
    tl.debug_barrier()
    p = partial_read(p, S, w, l, 0)
    if GLU:
        u = partial_read(u, S, w, l, 1)
    p = warp0_sum(p, w, l)
    if GLU:
        u = warp0_sum(u, w, l)
    return p, gpu.set_layout(tl.where((w == 0) & (l == 0), u, 0.), E)


@triton.constexpr_function
def column_layout(COLS: tl.constexpr):
    return gpu.BlockEncoding([COLS, 1, 1], [1, 1, 32], [1, {{call.cta_warps}}, 1], [2, 1, 0])


@triton.jit
def vector_packets(word, COLS: tl.constexpr):
    word = gpu.set_layout(word, column_layout(COLS))
    t0 = gpu.set_layout(tl.full((COLS, 4, 32), 0xBFAD9881, tl.uint32), column_layout(COLS))
    t1 = gpu.set_layout(tl.full((COLS, 4, 32), 0xF6EADDCF, tl.uint32), column_layout(COLS))
    t2 = gpu.set_layout(tl.full((COLS, 4, 32), 0x26190D01, tl.uint32), column_layout(COLS))
    t3 = gpu.set_layout(tl.full((COLS, 4, 32), 0x71594535, tl.uint32), column_layout(COLS))
    a, b = tl.inline_asm_elementwise(
        """{
.reg .b32 sel,idx,lo,hi,t0,t1;
shr.u32 idx,$2,16;
and.b32 sel,$2,0x88888888; shr.u32 sel,sel,1; or.b32 sel,sel,0x32103210;
and.b32 lo,$2,0x7777; prmt.b32 lo,$3,$4,lo;
and.b32 hi,$2,0x7777; prmt.b32 hi,$5,$6,hi;
prmt.b32 t0,lo,hi,sel;
shr.u32 sel,sel,16;
and.b32 lo,idx,0x7777; prmt.b32 lo,$3,$4,lo;
and.b32 hi,idx,0x7777; prmt.b32 hi,$5,$6,hi;
prmt.b32 t1,lo,hi,sel;
prmt.b32 $0,t0,t1,0x6420; prmt.b32 $1,t0,t1,0x7531;
}""",
        constraints="=r,=r,r,r,r,r,r",
        args=[word, t0, t1, t2, t3],
        dtype=(tl.int32, tl.int32),
        is_pure=True,
        pack=1,
    )
    return gpu.set_layout(a, column_layout(COLS)), gpu.set_layout(b, column_layout(COLS))


@triton.jit
def vector_group(W, Q, row, kbx, g, active, acc, K: tl.constexpr, ROWS: tl.constexpr, COLS: tl.constexpr):
    # Two-column payloads fit in signed 32-bit word offsets. Keep the accepted
    # four-column address calculation for the vocabulary projection.
    if COLS == 2:
        base = row.to(tl.int32) * (K // 256) * 34 + kbx.to(tl.int32) * 34
    else:
        base = row.to(tl.int64) * (K // 256) * 34 + kbx.to(tl.int64) * 34
    WP = W.to(tl.pointer_type(tl.uint32))
    QP = Q.to(tl.pointer_type(tl.uint32))
    if COLS == 2:
        qb = (8 * kbx.to(tl.int32) + g) * 9
    else:
        qb = (8 * kbx.to(tl.int64) + g) * 9
    h = gpu.set_layout(tl.load(WP + base, active, 0), column_layout(COLS))
    s = gpu.set_layout(tl.load(WP + base + 1, active, 0), column_layout(COLS))
    sg = (((s >> (8 * (g // 2) + 4 * (g % 2))) & 15) | (((h >> (16 + 2 * g)) & 3) << 4)).to(tl.int32) - 32
    dw = (h & 65535).to(tl.uint16).to(tl.float16, bitcast=True).to(tl.float32)
    I = ()
    for r in tl.static_range(ROWS):
        I += (gpu.set_layout(tl.full((COLS, 4, 32), 0, tl.int32), column_layout(COLS)),)
    # Stream one nibble word through every token before decoding the next.
    # This shares the decode without keeping eight decoded packets live.
    for j in tl.static_range(4):
        word = gpu.set_layout(tl.load(WP + base + 2 + 4 * g + j, active, 0), column_layout(COLS))
        a, b = vector_packets(word, COLS)
        next_I = ()
        for r in tl.static_range(ROWS):
            qr = qb + r * (K // 32) * 9
            q0 = gpu.set_layout(tl.load(QP + qr + 1 + j, active, 0).to(tl.int32, bitcast=True), column_layout(COLS))
            q1 = gpu.set_layout(tl.load(QP + qr + 5 + j, active, 0).to(tl.int32, bitcast=True), column_layout(COLS))
            Ir = tl.inline_asm_elementwise(
                "dp4a.s32.s32 $0,$1,$2,$3;",
                constraints="=r,r,r,r",
                args=[a, q0, I[r]],
                dtype=tl.int32,
                is_pure=True,
                pack=1,
            )
            Ir = tl.inline_asm_elementwise(
                "dp4a.s32.s32 $0,$1,$2,$3;",
                constraints="=r,r,r,r",
                args=[b, q1, Ir],
                dtype=tl.int32,
                is_pure=True,
                pack=1,
            )
            next_I += (Ir,)
        I = next_I
    result = ()
    for r in tl.static_range(ROWS):
        dq = gpu.set_layout(tl.load(QP + qb + r * (K // 32) * 9, active, 0), column_layout(COLS))
        dx = (dq & 65535).to(tl.uint16).to(tl.float16, bitcast=True).to(tl.float32)
        J = (I[r] * sg).to(tl.float32)
        D = tl.inline_asm_elementwise(
            "mul.rn.f32 $0,$1,$2;", constraints="=f,f,f", args=[dw, dx], dtype=tl.float32, is_pure=True, pack=1
        )
        pn = tl.inline_asm_elementwise(
            "fma.rn.f32 $0,$1,$2,$3;",
            constraints="=f,f,f,f",
            args=[D, J, acc[r]],
            dtype=tl.float32,
            is_pure=True,
            pack=1,
        )
        result += (gpu.set_layout(tl.where(active, pn, acc[r]), column_layout(COLS)),)
    return result


@triton.jit
def {{call.symbol}}({{call.signature}}):
    N: tl.constexpr = {{call.transport_n}}
    K: tl.constexpr = {{call.transport_k}}
    ROWS: tl.constexpr = {{call.constexprs.ROWS}}
    MODE: tl.constexpr = 0
    COLS: tl.constexpr = {{call.constexprs.COLS}}
    Q={{call.pointers[0]}}
    W={{call.pointers[1]}}
    Y={{call.pointers[3]}}
    Z={{call.pointers[4]}}
    ce: tl.constexpr = column_layout(COLS)
    c = gpu.set_layout(tl.broadcast_to(tl.arange(0, COLS)[:, None, None], (COLS, 4, 32)), ce)
    w = gpu.set_layout(tl.broadcast_to(tl.arange(0, 4)[None, :, None], (COLS, 4, 32)), ce)
    l = gpu.set_layout(tl.broadcast_to(tl.arange(0, 32)[None, None, :], (COLS, 4, 32)), ce)
    tid = w * 32 + l
    g = tid % 8
    pw=gpu.set_layout(tl.broadcast_to(tl.arange(0,4)[:,None],(4,32)),E)
    pl=gpu.set_layout(tl.broadcast_to(tl.arange(0,32)[None,:],(4,32)),E)
    ptid=pw*32+pl
    for row_iteration in range(tl.cdiv(N,{{call.transport_grid_cap}}*COLS)):
        output_base=(tl.program_id(0)+row_iteration*{{call.transport_grid_cap}})*COLS
        row=output_base+c
        future=output_base+{{call.prefetch_distance*call.transport_grid_cap}}*COLS
{% for chunk in range((call.constexprs.COLS*136*(call.transport_k//256)+16383)//16384) %}
        ptr=W+future.to(tl.int64)*{{136*(call.transport_k//256)}}+(ptid+{{128*chunk}})*128
        valid=(future<N)&((ptid+{{128*chunk}})*128<tl.minimum(COLS,N-future)*{{136*(call.transport_k//256)}})
        tl.inline_asm_elementwise('{ .reg .pred p; setp.ne.u32 p,$1,0; @p prefetch.global.L2 [$2]; mov.u32 $0,0; }',constraints='=r,r,l',args=[valid,ptr],dtype=tl.int32,is_pure=False,pack=1)
{% endfor %}
        p = ()
        for r in tl.static_range(ROWS):
            p += (gpu.set_layout(tl.full((COLS, 4, 32), 0.0, tl.float32), ce),)
        for it in range(tl.cdiv(K // 256, 16)):
            kbx = tid // 8 + 16 * it
            active = (row < N) & (kbx < K // 256)
            p = vector_group(W, Q, row, kbx, g, active, p, K, ROWS, COLS)
        w2 = gpu.set_layout(tl.broadcast_to(tl.arange(0, 4)[:, None], (4, 32)), E)
        l2 = gpu.set_layout(tl.broadcast_to(tl.arange(0, 32)[None, :], (4, 32)), E)
        for col in tl.static_range(COLS):
            for r in tl.static_range(ROWS):
                v = gpu.set_layout(tl.gather(p[r], tl.full((1, 4, 32), col, tl.int32), 0).reshape((4, 32)), E)
                v, u = typed_reduce(v, v, w2, l2, False)
                output_col = output_base + col
                if MODE == 2:
                    out = tl.where(output_col % 512 // 256 == 0, Y, Z)
                    offset = r * (N // 2) + output_col // 512 * 256 + output_col % 256
                else:
                    out = Y
                    offset = r * N + output_col
                tl.store(out + tl.full((4, 32), offset, tl.int32), v, (output_col < N) & (w2 == 0) & (l2 == 0))
                tl.debug_barrier()
{% endif %}
{% endfor %}
