   SPDX-License-Identifier: MIT #}{% macro position(call, prefix, token, mask, indent) %}
{{ indent }}{{ prefix }}_cache_token_position = qkv_cache_position + ({{ token }})
{{ indent }}{{ prefix }}_cache_logical_block = {{ prefix }}_cache_token_position // {{ call.block_size }}
{{ indent }}{{ prefix }}_cache_block_offset = {{ prefix }}_cache_token_position % {{ call.block_size }}
{{ indent }}{{ prefix }}_cache_physical_block = tl.load(
{{ indent }}    {{ call.block_table }} + {{ prefix }}_cache_logical_block + tl.zeros_like({{ mask }}).to(tl.int64),
{{ indent }}    mask={{ mask }}, other=0,
{{ indent }}).to(tl.int64)
{% endmacro %}
