# flagmega-kernel: add_norm_stats/persistent_rms platform=generic
{% set add_norm_stats_variant = "persistent_rms" %}
@triton.jit
def _flagmega_add_norm_stats_persistent_rms(
    source, residual, destination, stats_output,
    ELEMENTS: tl.constexpr, TILE: tl.constexpr,
):
    square_sum = tl.zeros((TILE,), tl.float32)
    for start in tl.range(0, ELEMENTS, TILE):
        offsets = start + tl.arange(0, TILE)
        mask = offsets < ELEMENTS
        value = (
            tl.load(source + offsets, mask=mask, other=0.0)
            + tl.load(residual + offsets, mask=mask, other=0.0)
        ).to(tl.bfloat16)
        tl.store(destination + offsets, value, mask=mask)
        value_fp32 = value.to(tl.float32)
        square_sum += tl.where(mask, value_fp32 * value_fp32, 0.0)
    tl.store(stats_output, tl.sum(square_sum, axis=0))
