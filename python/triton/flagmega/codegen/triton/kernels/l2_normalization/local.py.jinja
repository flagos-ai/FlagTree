# flagmega-kernel: l2_normalization/local platform=generic
{% if render_calls is defined %}
{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "l2_normalization" %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for _fm_row in tl.range(0, {{ call.rows }}):
        _fm_sum = tl.full((), 0., tl.float32)
        for _fm_start in tl.range(0, {{ call.capacity }}, {{ call.tile }}):
            _fm_offsets = _fm_start + tl.arange(0, {{ call.tile }})
            _fm_mask = (_fm_offsets < {{ call.capacity }}) & ({{ call.active }})
            _fm_values = tl.load({{ call.source }} + ({{ call.source_offset }}), mask=_fm_mask, other=0.).to(tl.float32)
            _fm_sum += tl.sum(_fm_values * _fm_values, 0)
{% if call.epsilon_add %}
        _fm_denominator = tl.sqrt(_fm_sum + {{ call.epsilon }})
{% else %}
        _fm_denominator = tl.sqrt(tl.maximum(_fm_sum, {{ call.epsilon }}))
{% endif %}
{% if call.reciprocal_multiply %}
        _fm_reciprocal = 1. / _fm_denominator
{% endif %}
        for _fm_start in tl.range(0, {{ call.capacity }}, {{ call.tile }}):
            _fm_offsets = _fm_start + tl.arange(0, {{ call.tile }})
            _fm_mask = (_fm_offsets < {{ call.capacity }}) & ({{ call.active }})
            _fm_values = tl.load({{ call.source }} + ({{ call.source_offset }}), mask=_fm_mask, other=0.).to(tl.float32)
{% if call.reciprocal_multiply %}
            _fm_normalized = _fm_values * _fm_reciprocal
{% else %}
            _fm_normalized = _fm_values / _fm_denominator
{% endif %}
            tl.store({{ call.result }} + ({{ call.result_offset }}), _fm_normalized, mask=_fm_mask & ({{ call.writer_active }}))


{% endif %}
{% endfor %}
{% endif %}
