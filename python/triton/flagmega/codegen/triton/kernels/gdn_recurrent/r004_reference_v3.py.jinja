def _r004_reference_rms_v3(Core,Norm,Weighted):
    h = tl.program_id(0)
    i = tle.gpu.set_layout(tl.arange(0,128),V)
    core = tl.load(Core+h*128+i)
    sumsq = local4_square(core)
    inv = tl.rsqrt(sumsq/128.0 + 9.999999974752427e-7)
    inv2 = tle.gpu.set_layout(tl.broadcast_to(inv[:,None],[32,4]),V2)
    inv1 = tle.gpu.set_layout(tl.reshape(inv2,[128]),V)
    weight = tl.load(Norm+i)
    tl.store(Weighted+h*128+i,core*inv1*weight)


