# flagmega-kernel: gdn_recurrent/persistent
@triton.jit
def _flagmega_dense_rows(
    source, weight, rows, active,
    K: tl.constexpr, TILE_K: tl.constexpr,
    UNIFORM_ROWS: tl.constexpr = False,
):
    """Dense projections for the value heads touched by one local tile."""
    lane_active = active
    if UNIFORM_ROWS:
        # The logical shard map proves that active lanes name the same row.
        # Inactive lanes need not carry that row; an empty tile reads none.
        rows = tl.min(tl.where(active, rows.to(tl.int64), 0x7fffffffffffffff), 0)
        active = tl.sum(active.to(tl.int32), 0) > 0
        rows = tl.where(active, rows, 0)
    REDUCE_AXIS: tl.constexpr = len(rows.shape)
    accumulator = tl.full(rows.shape, 0, tl.float32)
    compensation = tl.full(rows.shape, 0, tl.float32)
    for k_start in tl.range(0, K, TILE_K):
        k_offsets = k_start + tl.arange(0, TILE_K)
        source_value = tl.load(
            source + k_offsets, mask=k_offsets < K, other=0.0,
        ).to(tl.float32)
        weight_value = tl.load(
            weight + tl.expand_dims(rows, REDUCE_AXIS) * K + k_offsets,
            mask=tl.expand_dims(active, REDUCE_AXIS) & (k_offsets < K),
            other=0.0,
        ).to(tl.float32)
        partial = tl.sum(weight_value * source_value, axis=REDUCE_AXIS)
        corrected = partial - compensation
        updated = accumulator + corrected
        compensation = (updated - accumulator) - corrected
        accumulator = updated
    return tl.where(lane_active, accumulator.to(tl.bfloat16).to(tl.float32), 0.0)


@triton.jit
def _flagmega_gdn_head_gates(
    beta_projection, a_projection, value_head, active,
    a_log, dt_bias, ROUND_BETA: tl.constexpr,
):
    """Head-only gates, valid while this invocation's projection key matches."""
    beta = tl.sigmoid(beta_projection)
    if ROUND_BETA:
        beta = beta.to(tl.bfloat16).to(tl.float32)
    decay_input = a_projection + tl.load(
        dt_bias + value_head, mask=active, other=0.0,
    ).to(tl.float32)
    softplus = tl.where(
        decay_input > 20.0,
        decay_input,
        libdevice.log1p(libdevice.exp(decay_input)),
    )
    decay_log = -libdevice.exp(
        tl.load(a_log + value_head, mask=active, other=0.0).to(tl.float32)
    ) * softplus
    decay = libdevice.exp(decay_log)
    return beta, decay


@triton.jit
def _flagmega_gdn_recurrent_local_core_tile(
    qkv, beta, decay, recurrent_state, core_scratch,
    local_values, global_values, active,
    VALUE_HEADS: tl.constexpr, KEY_HEADS: tl.constexpr,
    KEY_DIM: tl.constexpr, VALUE_DIM: tl.constexpr,
    REPEATS: tl.constexpr, TILE_K: tl.constexpr,
    QK_NORM_ADD: tl.constexpr, QK_NORM_EPS: tl.constexpr,
    ROUND_NORMALIZED_QK: tl.constexpr, ROUND_CORE: tl.constexpr,
):
    """Update exactly the state/value coordinates owned by this shard."""
    KEY_TOTAL: tl.constexpr = KEY_HEADS * KEY_DIM
    value_head = global_values // VALUE_DIM
    value_coordinate = global_values % VALUE_DIM
    key_head = value_head // REPEATS
    # Proven uniform heads use a scalar gate. Other maps use one per value
    # lane; both broadcast over the key dimension without a reduction.
    decay_columns = tl.expand_dims(decay, len(decay.shape))

    key_offsets = tl.arange(0, TILE_K)
    key_mask = key_offsets < KEY_DIM
    query_raw = tl.load(
        qkv + key_head[:, None] * KEY_DIM + key_offsets[None, :],
        mask=active[:, None] & key_mask[None, :],
        other=0.0,
    ).to(tl.float32)
    key_raw = tl.load(
        qkv + KEY_TOTAL + key_head[:, None] * KEY_DIM + key_offsets[None, :],
        mask=active[:, None] & key_mask[None, :],
        other=0.0,
    ).to(tl.float32)
    if QK_NORM_ADD:
        query_norm = tl.sqrt(tl.sum(query_raw * query_raw, axis=1) + QK_NORM_EPS)
        key_norm = tl.sqrt(tl.sum(key_raw * key_raw, axis=1) + QK_NORM_EPS)
    else:
        query_norm = tl.maximum(tl.sqrt(tl.sum(query_raw * query_raw, axis=1)), QK_NORM_EPS)
        key_norm = tl.maximum(tl.sqrt(tl.sum(key_raw * key_raw, axis=1)), QK_NORM_EPS)
    state_offsets = (
        (
            (value_head[:, None] * VALUE_DIM + value_coordinate[:, None])
            * (KEY_DIM // 4)
            + key_offsets[None, :] // 4
        ) * 4
        + key_offsets[None, :] % 4
    )
    state_mask = active[:, None] & key_mask[None, :]
    old_state = tl.load(
        recurrent_state + state_offsets, mask=state_mask, other=0.0,
    ).to(tl.float32)
    normalized_key = key_raw / key_norm[:, None]
    if ROUND_NORMALIZED_QK:
        normalized_key = normalized_key.to(tl.bfloat16).to(tl.float32)
    recalled = tl.sum(
        old_state * decay_columns * normalized_key, axis=1,
    )
    target = tl.load(
        qkv + 2 * KEY_TOTAL + global_values,
        mask=active,
        other=0.0,
    ).to(tl.float32)
    delta = (target - recalled) * beta
    new_state = (
        old_state * decay_columns
        + normalized_key * delta[:, None]
    )
    tl.store(recurrent_state + state_offsets, new_state, mask=state_mask)
    normalized_query = query_raw / query_norm[:, None]
    if ROUND_NORMALIZED_QK:
        normalized_query = normalized_query.to(tl.bfloat16).to(tl.float32)
    normalized_query *= {{ query_scale_repr }}
    core = tl.sum(new_state * normalized_query, axis=1)
    if ROUND_CORE:
        core = core.to(tl.bfloat16).to(tl.float32)
    tl.store(core_scratch + global_values, core, mask=active)


@triton.jit
def _flagmega_gdn_recurrent_local_norm_tile(
    z, destination, norm_weight, core_scratch,
    source_offsets, result_offsets, global_values, active,
    VALUE_DIM: tl.constexpr, EPS: tl.constexpr,
):
    """Normalize complete heads after every owner has published core values."""
    value_head = global_values // VALUE_DIM
    value_coordinate = global_values % VALUE_DIM
    head_offsets = tl.arange(0, {{ head_block }})
    head_mask = head_offsets < VALUE_DIM
    head_core = tl.load(
        core_scratch + value_head[:, None] * VALUE_DIM + head_offsets[None, :],
        mask=active[:, None] & head_mask[None, :],
        other=0.0,
    ).to(tl.float32)
    inverse_rms = tl.rsqrt(
        tl.sum(head_core * head_core, axis=1) / VALUE_DIM + EPS,
    )
    core = tl.load(core_scratch + global_values, mask=active, other=0.0)
    norm = tl.load(
        norm_weight + value_coordinate, mask=active, other=0.0,
    ).to(tl.float32)
    gate = tl.load(z + source_offsets, mask=active, other=0.0).to(tl.float32)
    result = core * inverse_rms * norm * _flagmega_silu(gate)
    tl.store(destination + result_offsets, result.to(tl.bfloat16), mask=active)

