// FlagMega high_level stage=imported semantic_hash=7a8ddecadb747bcecc075107c9b465d45ae89248e6072c0ffa730c013699b642
%decode_layer = fn(%decode_layer_hidden: f32[1,2048], %decode_layer_state: &paged_attention_kv_cache{kv_caches: bf16<8>[16,28,2,256,8,16], query_start_loc: i32[2], seq_lens: i32[1], slot_mapping: i64[1], block_table: i32[1,16]}, %decode_layer_input_norm_weight: bf16[2048], %decode_layer_q_weight: bf16[2048,2048], %decode_layer_k_weight: bf16[1024,2048], %decode_layer_v_weight: bf16[1024,2048], %decode_layer_q_norm_weight: bf16[128], %decode_layer_k_norm_weight: bf16[128], %decode_layer_o_weight: bf16[2048,2048], %decode_layer_post_norm_weight: bf16[2048], %decode_layer_gate_weight: bf16[6144,2048], %decode_layer_up_weight: bf16[6144,2048], %decode_layer_down_weight: bf16[2048,6144], %decode_layer_layer_id: i32[], %decode_layer_advance_sequence: bool[], %decode_layer_rotary_cos: f32[1,1,128], %decode_layer_rotary_sin: f32[1,1,128]): // (f32[1,2048], &paged_attention_kv_cache{kv_caches: bf16<8>[16,28,2,256,8,16], query_start_loc: i32[2], seq_lens: i32[1], slot_mapping: i64[1], block_table: i32[1,16]}, bf16[2048], bf16[2048,2048], bf16[1024,2048], bf16[1024,2048], bf16[128], bf16[128], bf16[2048,2048], bf16[2048], bf16[6144,2048], bf16[6144,2048], bf16[2048,6144], i32[], bool[], f32[1,1,128], f32[1,1,128]) -> (f32[1,2048], &paged_attention_kv_cache{kv_caches: bf16<8>[16,28,2,256,8,16], query_start_loc: i32[2], seq_lens: i32[1], slot_mapping: i64[1], block_table: i32[1,16]})
{
  weights {
    // display grouping only; not an execution schedule
    %w0 = Tensors.Permute(Axes: [1, 0], %decode_layer_q_weight): // bf16[2048,2048] name='decode_layer_q_weight_kn'
    %w1 = Tensors.Permute(Axes: [1, 0], %decode_layer_k_weight): // bf16[2048,1024] name='decode_layer_k_weight_kn'
    %w2 = Tensors.Permute(Axes: [1, 0], %decode_layer_v_weight): // bf16[2048,1024] name='decode_layer_v_weight_kn'
    %w3 = None(): // none name='decode_layer_qkv_none'
  }
  // compute
  %0  = NN.NormStats(Axis: -1, UseMean: False, %decode_layer_hidden): // f32[1,1,1] name='decode_layer_input_norm.stats'
  %1  = NN.NormApply(Axis: -1, Epsilon: 1e-06, RoundBeforeScale: False, UseMean: False, %decode_layer_hidden, %0, %decode_layer_input_norm_weight, const(bf16[2048] : splat(0.0))): // f32[1,2048] name='decode_layer_input_norm.wide'
  %2  = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %1): // bf16[1,2048] name='decode_layer_input_norm'
  %3  = NN.QKVParallelLinear(NumHeads: 16, NumKvHeads: 8, OutputDataType: 'bfloat16', %2, %w0, %w1, %w2, %w3, %w3, %w3, %w3, %w3, %w3, %w3, %w3, %w3): // (bf16[1,2048], bf16[1,1024], bf16[1,1024]) name='decode_layer_qkv_projection'
  %4  = GetItem(%3, 0): // bf16[1,2048] name='decode_layer_query_flat'
  %5  = Tensors.Reshape(Shape: [1, 16, 128], %4): // bf16[1,16,128] name='decode_layer_query'
  %6  = GetItem(%3, 1): // bf16[1,1024] name='decode_layer_key_flat'
  %7  = Tensors.Reshape(Shape: [1, 8, 128], %6): // bf16[1,8,128] name='decode_layer_key'
  %8  = GetItem(%3, 2): // bf16[1,1024] name='decode_layer_value_flat'
  %9  = Tensors.Reshape(Shape: [1, 8, 128], %8): // bf16[1,8,128] name='decode_layer_value'
  %10 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %5): // f32[1,16,128] name='decode_layer_query_norm.wide_input'
  %11 = NN.NormStats(Axis: -1, UseMean: False, %10): // f32[1,1,16,1] name='decode_layer_query_norm.stats'
  %12 = NN.NormApply(Axis: -1, Epsilon: 1e-06, RoundBeforeScale: False, UseMean: False, %10, %11, %decode_layer_q_norm_weight, const(bf16[128] : splat(0.0))): // f32[1,16,128] name='decode_layer_query_norm'
  %13 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %7): // f32[1,8,128] name='decode_layer_key_norm.wide_input'
  %14 = NN.NormStats(Axis: -1, UseMean: False, %13): // f32[1,1,8,1] name='decode_layer_key_norm.stats'
  %15 = NN.NormApply(Axis: -1, Epsilon: 1e-06, RoundBeforeScale: False, UseMean: False, %13, %14, %decode_layer_k_norm_weight, const(bf16[128] : splat(0.0))): // f32[1,8,128] name='decode_layer_key_norm'
  %16 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %decode_layer_rotary_cos): // bf16[1,1,128] name='decode_layer_query_rope.table_0.bf16'
  %17 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %16): // f32[1,1,128] name='decode_layer_query_rope.table_0.f32'
  %18 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %decode_layer_rotary_sin): // bf16[1,1,128] name='decode_layer_query_rope.table_1.bf16'
  %19 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %18): // f32[1,1,128] name='decode_layer_query_rope.table_1.f32'
  %20 = NN.RoPE(%12, %17, %19): // f32[1,16,128] name='decode_layer_query_rope.wide'
  %21 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %20): // bf16[1,16,128] name='decode_layer_query_rope'
  %22 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %decode_layer_rotary_cos): // bf16[1,1,128] name='decode_layer_key_rope.table_0.bf16'
  %23 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %22): // f32[1,1,128] name='decode_layer_key_rope.table_0.f32'
  %24 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %decode_layer_rotary_sin): // bf16[1,1,128] name='decode_layer_key_rope.table_1.bf16'
  %25 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %24): // f32[1,1,128] name='decode_layer_key_rope.table_1.f32'
  %26 = NN.RoPE(%15, %23, %25): // f32[1,8,128] name='decode_layer_key_rope.wide'
  %27 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %26): // bf16[1,8,128] name='decode_layer_key_rope'
  %28 = Tensors.Pack(Axes: [2], Lanes: [8], %21): // bf16<8>[1,16,16] name='decode_layer_query_cache_pack'
  %29 = Tensors.Pack(Axes: [2], Lanes: [8], %27): // bf16<8>[1,8,16] name='decode_layer_key_cache_pack'
  %30 = Tensors.Pack(Axes: [2], Lanes: [8], %9): // bf16<8>[1,8,16] name='decode_layer_value_cache_pack'
  %31 = NN.UpdatePagedAttentionKVCache(CacheKind: 'key', Layout: ['seq', 'head', 'dim'], %29, %decode_layer_state, %decode_layer_layer_id, const(bool[] : False)): // &paged_attention_kv_cache{kv_caches: bf16<8>[16,28,2,256,8,16], query_start_loc: i32[2], seq_lens: i32[1], slot_mapping: i64[1], block_table: i32[1,16]} !read_write<paged_attention_kv_cache> name='decode_layer_key_cache_update'
  %32 = NN.UpdatePagedAttentionKVCache(CacheKind: 'value', Layout: ['seq', 'head', 'dim'], %30, %31, %decode_layer_layer_id, %decode_layer_advance_sequence): // &paged_attention_kv_cache{kv_caches: bf16<8>[16,28,2,256,8,16], query_start_loc: i32[2], seq_lens: i32[1], slot_mapping: i64[1], block_table: i32[1,16]} !read_write<paged_attention_kv_cache> name='decode_layer_updated_state'
  %33 = NN.PagedAttention(HiddenSize: 2048, Layout: ['seq', 'head', 'dim'], Scale: 0.08838834764831845, %28, %32, %decode_layer_layer_id): // bf16<8>[1,16,16] !read<paged_attention_kv_cache> name='decode_layer_paged_attention'
  %34 = Tensors.Unpack(Axes: [2], %33): // bf16[1,16,128] name='decode_layer_paged_attention_unpacked'
  %35 = Tensors.Reshape(Shape: [1, 2048], %34): // bf16[1,2048] name='decode_layer_attention_merged'
  %36 = Math.MatMul(TransposeA: False, TransposeB: True, %35, %decode_layer_o_weight): // bf16[1,2048] name='decode_layer_attention_output'
  %37 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %decode_layer_hidden): // bf16[1,2048] name='decode_layer_after_attention.residual_bf16'
  %38 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %37): // f32[1,2048] name='decode_layer_after_attention.residual_wide'
  %39 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %36): // f32[1,2048] name='decode_layer_after_attention.projection_wide'
  %40 = Math.Add(%38, %39): // f32[1,2048] name='decode_layer_after_attention'
  %41 = NN.NormStats(Axis: -1, UseMean: False, %40): // f32[1,1,1] name='decode_layer_post_attention_norm.stats'
  %42 = NN.NormApply(Axis: -1, Epsilon: 1e-06, RoundBeforeScale: False, UseMean: False, %40, %41, %decode_layer_post_norm_weight, const(bf16[2048] : splat(0.0))): // f32[1,2048] name='decode_layer_post_attention_norm.wide'
  %43 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %42): // bf16[1,2048] name='decode_layer_post_attention_norm'
  %44 = Math.MatMul(TransposeA: False, TransposeB: True, %43, %decode_layer_gate_weight): // bf16[1,6144] name='decode_layer_mlp_gate_up.gate'
  %45 = Math.MatMul(TransposeA: False, TransposeB: True, %43, %decode_layer_up_weight): // bf16[1,6144] name='decode_layer_mlp_gate_up.up'
  %46 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %44): // f32[1,6144] name='decode_layer_mlp_gate_up.gate_wide'
  %47 = Math.Silu(%46): // f32[1,6144] name='decode_layer_mlp_gate_up.silu'
  %48 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %45): // f32[1,6144] name='decode_layer_mlp_gate_up.up_wide'
  %49 = Math.Mul(%47, %48): // f32[1,6144] name='decode_layer_mlp_gate_up.product'
  %50 = Tensors.Cast(Dtype: 'bfloat16', RoundingContract: 'preserve', %49): // bf16[1,6144] name='decode_layer_mlp_gate_up'
  %51 = Math.MatMul(TransposeA: False, TransposeB: True, %50, %decode_layer_down_weight): // bf16[1,2048] name='decode_layer_mlp_down'
  %52 = Tensors.Cast(Dtype: 'float32', RoundingContract: 'preserve', %51): // f32[1,2048] name='decode_layer_output.projection_wide'
  %53 = Math.Add(%40, %52): // f32[1,2048] name='decode_layer_output'
  return (%53, %32)
}
