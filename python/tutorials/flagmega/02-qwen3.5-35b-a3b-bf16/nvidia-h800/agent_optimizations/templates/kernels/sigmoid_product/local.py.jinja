{% import "entrypoints/_common.py.jinja" as entry with context %}
{% for call in render_calls %}
{% if call.family == "sigmoid_product" %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for _fm_start in tl.range(0, {{ call.capacity }}, {{ call.tile }}):
        _fm_offsets = _fm_start + tl.arange(0, {{ call.tile }})
        _fm_mask = (_fm_offsets < {{ call.capacity }}) & ({{ call.active }})
        _fm_value = tl.load({{ call.pointers.value }} + ({{ call.offsets.value }}), mask=_fm_mask, other=0.0).to(tl.float32)
        _fm_gate = tl.load({{ call.pointers.gate }} + ({{ call.offsets.gate }}), mask=_fm_mask, other=0.0).to(tl.float32)
        _fm_result = (_fm_value * tl.sigmoid(_fm_gate)).to(tl.bfloat16)
        tl.store({{ call.result }} + ({{ call.result_offset }}), _fm_result,
                 mask=_fm_mask & ({{ call.writer_active }}))


{% endif %}
{% endfor %}
