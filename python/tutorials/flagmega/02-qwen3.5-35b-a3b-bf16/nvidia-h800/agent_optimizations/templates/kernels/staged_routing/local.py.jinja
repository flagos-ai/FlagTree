# flagmega-kernel: staged_routing/local platform=generic pair-order-v44
{% if render_calls is defined %}
{% import "entrypoints/_common.py.jinja" as entry with context %}
@triton.jit
def _flagmega_staged_routing_pair_max(a, ai, b, bi):
    a_nan = a != a
    b_nan = b != b
    equal = (a == b) | (a_nan & b_nan)
    left = (a_nan & ~b_nan) | ((a_nan == b_nan) & ((a > b) | (equal & (ai < bi))))
    return tl.where(left, a, b), tl.where(left, ai, bi)


{% for call in render_calls %}
{% if call.family == "staged_routing" %}
{{ entry.kernel_decorator(call) }}
def {{ call.symbol }}({{ call.signature }}):
{{ entry.mesh_coordinates() }}
    for _fm_row in tl.range(0, {{ call.rows }}):
        _fm_offsets = tl.arange(0, {{ call.tile }})
        _fm_mask = (_fm_offsets < {{ call.capacity }}) & ({{ call.active }})
        _fm_values = tl.load({{ call.source }} + ({{ call.source_offset }}), mask=_fm_mask, other=-float("inf")).to(tl.float32)
        _fm_numerator = tl.exp(_fm_values - tl.max(_fm_values, 0))
        _fm_probabilities = _fm_numerator / tl.sum(_fm_numerator, 0)
        _fm_available = _fm_mask
        _fm_selected_offsets = tl.arange(0, {{ call.selected_tile }})
        _fm_selected_values = tl.full(({{ call.selected_tile }},), 0, tl.float32)
        _fm_selected_indices = tl.full(({{ call.selected_tile }},), 0, tl.int64)
        for _fm_selection in tl.range(0, {{ call.k }}):
            # Stable total order (NaNs first, descending probability, lower id).
            # A single value/index reduction carries the original winner bits.
            _fm_candidate_values = tl.where(_fm_available, _fm_probabilities, -float("inf"))
            _fm_candidate_indices = tl.where(_fm_available, _fm_offsets, 2147483647)
            _fm_selected, _fm_winner_index = tl.reduce((_fm_candidate_values, _fm_candidate_indices), 0, _flagmega_staged_routing_pair_max)
            _fm_selected_values = tl.where(_fm_selected_offsets == _fm_selection, _fm_selected, _fm_selected_values)
            _fm_selected_indices = tl.where(_fm_selected_offsets == _fm_selection, _fm_winner_index.to(tl.int64), _fm_selected_indices)
            _fm_available = _fm_available & (_fm_offsets != _fm_winner_index)
        _fm_denominator = tl.full((), 0, tl.float32) + tl.sum(_fm_selected_values, 0)
        _fm_weights = tl.div_rn(_fm_selected_values, _fm_denominator)
        _fm_write_mask = (_fm_selected_offsets < {{ call.k }}) & ({{ call.outer_active }})
        tl.store({{ call.values_pointer }} + ({{ call.values_offset }}), _fm_weights, mask=_fm_write_mask & ({{ call.values_active }}))
        tl.store({{ call.indices_pointer }} + ({{ call.indices_offset }}), _fm_selected_indices, mask=_fm_write_mask & ({{ call.indices_active }}))


{% endif %}
{% endfor %}
{% endif %}
