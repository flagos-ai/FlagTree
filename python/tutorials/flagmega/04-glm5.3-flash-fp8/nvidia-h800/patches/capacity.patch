+"""Compile the actual host allocation bodies with CPU allocation/IPC shims.
+
+This tests allocation sizes, published stride, slot aliasing and epoch partition
+without initializing CUDA. It is separate from device protocol acceptance.
+"""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(os.environ.get("FLAGCX_CAPACITY_SOURCE_ROOT",Path(__file__).resolve().parents[3]))
+
+
+def block(source, start):
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[opening:end]
+
+
+class BarrierCapacityHostTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        source = (ROOT/"flagcx/adaptor/flagcx_device.cc").read_text()
+        start = source.index("static flagcxResult_t setupIpcBarriers(")
+        signature = source[start:source.index("{", start)]
+        allocator = signature + block(source, start)
+        query_start = source.find('extern "C" flagcxResult_t\nflagcxDevCommGetIntraBarrierCount(')
+        cls.has_query = query_start >= 0
+        query = (source[query_start:source.index("{",query_start)] + block(source,query_start)
+                 if cls.has_query else "")
+        traits = (ROOT/"flagcx/adaptor/include/device_api/default_comm_traits.h").read_text()
+        inter = traits.index("struct Barrier<Default<P>, flagcxTeamTagInter, Coop>")
+        constructor = traits.index("  Barrier(Coop coop, const Net &net",inter)
+        constructor = traits[constructor:traits.index("{}",constructor)+2]
+        inter_test = r'''
+#include <vector>
+struct EpochComm { uint64_t *epochBuffer; int nBarriers; uint64_t *interSignalFlags; bool isInterLeader; };
+struct EpochNet { void *fifoBuffer = nullptr; };
+struct EpochCoop {};
+struct EpochTeam {};
+constexpr int flagcxDeviceMemoryOrderRelaxed = 0;
+struct EpochAtomic { static uint64_t load(uint64_t *p,int) { return *p; } };
+struct Barrier {
+  using Coop = EpochCoop; using Net = EpochNet; using Comm = EpochComm;
+  using Team = EpochTeam; using Atomic = EpochAtomic;
+  Coop _coop; uint64_t *_interSignals; void *_fifoBuffer; int _nInterPeers;
+  bool _isLeader; uint32_t _ctaIndex; uint64_t *_epochBuffer; uint64_t _epoch;
+'''+constructor+r'''
+};
+static int checkInterEpochs(int capacity) {
+  std::vector<uint64_t> storage(size_t(capacity)+FLAGCX_DEVICE_CTA_COUNT);
+  EpochComm dc{storage.data(),capacity,nullptr,false};
+  bool ok = true;
+  for (int index=0; index<FLAGCX_DEVICE_CTA_COUNT; ++index) {
+    Barrier barrier(EpochCoop{},EpochNet{},dc,EpochTeam{},index,0);
+    ok &= barrier._epochBuffer == storage.data()+capacity+index;
+  }
+  std::printf("{\"intra_capacity\":%d,\"inter_epoch_disjoint\":%s}\n",capacity,ok?"true":"false");
+  return ok ? 0 : 2;
+}
+'''
+        marker = source.index("size_t epochBufSize =", source.index("flagcxDevCommCreate("))
+        epoch_start = source.rfind("{", 0, marker)
+        epochs = "static int allocateEpochs(flagcxComm_t comm, flagcxDevComm_t handle) "
+        epochs += block(source, epoch_start)[:-1] + "return 0; }"
+        fixture = Path(__file__).with_name("barrier_capacity_host_fixture.h").read_text()
+        main = r'''
+int main(int argc, char **argv) {
+  int requested = std::atoi(argv[1]);
+  if (requested < 0) return checkInterEpochs(-requested);
+  signalHostEnable = std::atoi(argv[2]);
+  MockComm comm;
+  MockHandle handle;
+#if HAS_CAPACITY_QUERY
+  if (requested == 0) {
+    int actual = -1;
+    if (flagcxDevCommGetIntraBarrierCount(nullptr,&actual) != flagcxInvalidArgument ||
+        flagcxDevCommGetIntraBarrierCount(&handle,nullptr) != flagcxInvalidArgument)
+      return 4;
+    handle.nBarriers = 129;
+    if (flagcxDevCommGetIntraBarrierCount(&handle,&actual) || actual != 0) return 4;
+    handle.devComm = &handle;
+    handle.nBarriers = 17;
+    if (flagcxDevCommGetIntraBarrierCount(&handle,&actual) || actual != 17) return 4;
+    std::puts("{\"capacity_query_passed\":true}");
+    return 0;
+  }
+#endif
+  handle.nBarriers = std::max(FLAGCX_DEVICE_CTA_COUNT, requested);
+  if (setupIpcBarriers(&comm, &handle) || allocateEpochs(&comm, &handle)) return 3;
+#if HAS_CAPACITY_QUERY
+  int published = -1;
+  if (flagcxDevCommGetIntraBarrierCount(&handle,&published) || published != handle.nBarriers) return 4;
+#endif
+  size_t flags = allocations.at(handle.localBarrierFlags);
+  size_t epochs = allocations.at(handle.epochBuffer);
+  bool unique = true, inBounds = true, zero = true;
+  std::set<size_t> addresses;
+  for (int rank = 0; rank < comm.localRanks; ++rank)
+    for (int slot = 0; slot < requested; ++slot) {
+      size_t offset = size_t(rank)*handle.nBarriers + slot;
+      unique &= addresses.insert(offset).second;
+      inBounds &= offset < flags/sizeof(uint64_t);
+    }
+  for (size_t i = 0; i < flags/sizeof(uint64_t); ++i) zero &= handle.localBarrierFlags[i] == 0;
+  for (size_t i = 0; i < epochs/sizeof(uint64_t); ++i) zero &= handle.epochBuffer[i] == 0;
+  bool epochBounds = epochs >= (size_t(handle.nBarriers)+FLAGCX_DEVICE_CTA_COUNT)*sizeof(uint64_t);
+  bool ok = unique && inBounds && zero && epochBounds && handle.nBarriers >= requested;
+  std::printf("{\"requested\":%d,\"actual\":%d,\"host_pinned\":%d,\"flags_bytes\":%zu,\"epoch_bytes\":%zu,\"unique\":%s,\"in_bounds\":%s,\"passed\":%s}\n",
+              requested,handle.nBarriers,signalHostEnable,flags,epochs,
+              unique?"true":"false",inBounds?"true":"false",ok?"true":"false");
+  return ok ? 0 : 2;
+}
+'''
+        cls.temporary = tempfile.TemporaryDirectory(prefix="flagcx-capacity-host-")
+        cls.executable = Path(cls.temporary.name)/"probe"
+        cpp = cls.executable.with_suffix(".cpp")
+        cpp.write_text(f"#define HAS_CAPACITY_QUERY {int(cls.has_query)}\n"+fixture+"\n"+inter_test+"\n"+allocator+"\n"+epochs+"\n"+query+"\n"+main)
+        subprocess.run(["g++","-std=c++17","-O0",str(cpp),"-o",str(cls.executable)],check=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.temporary.cleanup()
+
+    def test_capacity_stride_storage_and_initialization(self):
+        for requested in [1,17,36,37,129,257]:
+            for pinned in [0,1]:
+                with self.subTest(requested=requested,pinned=pinned):
+                    result = subprocess.run([str(self.executable),str(requested),str(pinned)],
+                                            capture_output=True,text=True,check=False)
+                    self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+                    row = json.loads(result.stdout)
+                    self.assertTrue(row["passed"])
+                    self.assertEqual(row["actual"],max(36,requested))
+
+    def test_actual_capacity_query(self):
+        if not self.has_query:
+            self.skipTest("The old SDK has no capacity query; allocation regression still executes.")
+        result = subprocess.run([str(self.executable),"0","0"],capture_output=True,text=True)
+        self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+
+    def test_inter_epochs_follow_expanded_intra_region(self):
+        for capacity in [36,37,129,257]:
+            with self.subTest(capacity=capacity):
+                result=subprocess.run([str(self.executable),str(-capacity),"0"],capture_output=True,text=True)
+                self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
