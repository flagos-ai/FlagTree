+// CPU fixture for the actual host allocator; no CUDA context or GPU work.
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <set>
+#include <unordered_map>
+
+using flagcxResult_t = int;
+using flagcxShmHandle_t = void *;
+constexpr int flagcxSuccess = 0, flagcxSystemError = 1, flagcxInvalidArgument = 2;
+constexpr int flagcxMemDevice = 0, flagcxMemcpyHostToDevice = 0;
+constexpr int FLAGCX_DEVICE_CTA_COUNT = 36, FLAGCX_INIT = 0;
+constexpr int SHM_PATH_MAX = 256;
+static int signalHostEnable;
+static std::unordered_map<void *, size_t> allocations;
+static int flagcxParamSignalHostEnable() { return signalHostEnable; }
+#define INFO(...) ((void)0)
+#define FLAGCXCHECK(call) do { int rc = (call); if (rc) return rc; } while (0)
+#define FLAGCXCHECKGOTO(call, result, label) do { result = (call); if (result) goto label; } while (0)
+
+struct MockDevice {
+  int deviceMalloc(void **p, size_t bytes, int, void *) {
+    *p = std::calloc(1, bytes); allocations[*p] = bytes; return !*p;
+  }
+  int deviceMemset(void *p, int value, size_t bytes, int, void *) {
+    std::memset(p, value, bytes); return 0;
+  }
+  int deviceFree(void *p, int, void *) { std::free(p); return 0; }
+  int deviceMemcpy(void *dst, const void *src, size_t bytes, int, void *, void *) {
+    std::memcpy(dst, src, bytes); return 0;
+  }
+  int hostGetDevicePointer(void **dst, void *src) { *dst = src; return 0; }
+};
+static MockDevice mockDevice;
+static MockDevice *deviceAdaptor = &mockDevice;
+struct MockIpc { uint64_t **devPeerPtrs = nullptr; };
+struct MockComm {
+  int localRanks = 4, rank = 0, localRank = 0, nranks = 4;
+  int ranks[4] = {0, 1, 2, 3};
+  int *localRankToRank = ranks;
+  uint64_t magic = 0;
+  void *bootstrap = nullptr;
+  MockIpc ipcTable[1];
+};
+using flagcxComm_t = MockComm *;
+struct MockHandle {
+  void *devComm = nullptr;
+  int nLocalRanks = 0, nBarriers = 0, barrierIpcIndex = -1;
+  int *localRankToRank = nullptr;
+  uint64_t *localBarrierFlags = nullptr, *epochBuffer = nullptr;
+  uint64_t **barrierPeers = nullptr, **barrierDevPeerPtrsRaw = nullptr;
+  void *localBarrierShmPtr = nullptr;
+  void **peerBarrierShmPtrs = nullptr;
+  size_t barrierShmSize = 0;
+  flagcxShmHandle_t myShmHandle = nullptr;
+  flagcxShmHandle_t *peerShmHandles = nullptr;
+};
+using flagcxDevComm_t = MockHandle *;
+static int buildIpcPeerPointers(flagcxComm_t comm, void *buffer, size_t) {
+  auto peers = static_cast<uint64_t **>(std::calloc(comm->localRanks, sizeof(void *)));
+  for (int i = 0; i < comm->localRanks; ++i) peers[i] = static_cast<uint64_t *>(buffer);
+  comm->ipcTable[0].devPeerPtrs = peers;
+  return 0;
+}
+static int flagcxShmOpen(char *, size_t, size_t bytes, void **cpu, void *, int,
+                        flagcxShmHandle_t *handle) {
+  *cpu = std::calloc(1, bytes); *handle = *cpu; allocations[*cpu] = bytes;
+  return !*cpu;
+}
+static int bootstrapCollBarrier(void *, int, int, int) { return 0; }
+static void flagcxShmUnlink(void *) {}
+static void flagcxShmClose(void *) {}
+static int shmHostRegister(void *, size_t) { return 0; }
+static void shmHostUnregister(void *) {}
+static int flagcxDevCommDestroy(flagcxComm_t, flagcxDevComm_t) { return 0; }
