@triton.jit
def _flagmega_amd_dot4(codes, words, accumulator):
    """Signed int8x4 dot product accumulated in int32 (v_dot4_i32_iu8, both operands signed)."""
    return tl.inline_asm_elementwise(
        "v_dot4_i32_iu8 $0, $1, $2, $3 neg_lo:[1,1,0]", "=v,v,v,v",
        [codes.to(tl.int32, bitcast=True), words, accumulator], dtype=tl.int32, is_pure=True, pack=1,
    )


@triton.jit
def _flagmega_amd_scaled_byte(value, inverse):
    """Low byte = int8 rne(fl(value * inverse)) (the cvt.rni of the NVIDIA q8_1_rne): adding 1.5 * 2^23
    rounds a |v| < 2^22 to an integer in round-to-nearest-even and leaves it in the low mantissa bits.
    The multiply stays unfused so the product is rounded first, as in the reference."""
    return tl.inline_asm_elementwise(
        "v_mul_f32 $0, $1, $2\n\tv_add_f32 $0, 0x4b400000, $0", "=&v,v,v", [value, inverse], dtype=tl.uint32,
        is_pure=True, pack=1)


@triton.jit
def _flagmega_amd_q8_load(source, FIRST: tl.constexpr, TG: tl.constexpr, COUNT: tl.constexpr):
    """Values of groups [FIRST, FIRST + COUNT) as [TG, 32] in the source dtype, zero past COUNT
    (converted when packed, so loads held across pieces stay packed bf16)."""
    group = tl.arange(0, TG)
    offsets = (FIRST + group)[:, None] * 32 + tl.arange(0, 32)[None, :]
    if COUNT < TG:
        return tl.load(source + offsets, mask=(group < COUNT)[:, None], other=0.0)
    return tl.load(source + offsets)


@triton.jit
def _flagmega_amd_q8_store(value, words, scales, LOCAL: tl.constexpr, TG: tl.constexpr):
    """q8_1_rne of [TG, 32] `value` into local groups [LOCAL, LOCAL + TG): int8 = rne(x * 127 / amax)
    packed four per int32 word, scale = fp16(amax / 127)."""
    group = tl.arange(0, TG)
    value = value.to(tl.float32)
    maximum = tl.max(tl.abs(value), axis=1)
    inverse = tl.where(maximum > 0, 127.0 / maximum, 0.0)
    q = _flagmega_amd_scaled_byte(value, tl.broadcast_to(inverse[:, None], value.shape)) & 255
    shift = (tl.arange(0, 4)[None, None, :] * 8).to(tl.uint32)
    packed = tl.sum(tl.reshape(q, (TG, 8, 4)) << shift, axis=2).to(tl.int32, bitcast=True)
    tl.store(tle.gpu.local_ptr(words, ((LOCAL + group)[:, None] * 8 + tl.arange(0, 8)[None, :], )), packed)
    tl.store(tle.gpu.local_ptr(scales, (LOCAL + group, )), (maximum / 127.0).to(tl.float16))


@triton.jit
def _flagmega_amd_q8_quantize(source, words, scales, tail_words, tail_scales, K: tl.constexpr, CHUNK: tl.constexpr,
                              TAIL: tl.constexpr, MAIN_GROUPS: tl.constexpr):
    """Groups below MAIN_GROUPS go to `words`/`scales` in one or two CHUNK-group pieces, the rest to the
    tail buffers (TAIL groups, zero padded). Every piece is loaded before any is packed, so the
    activation reads cost one memory latency."""
    GROUPS: tl.constexpr = K // 32
    tl.static_assert(MAIN_GROUPS <= 2 * CHUNK)
    first = _flagmega_amd_q8_load(source, 0, CHUNK, CHUNK)
    if MAIN_GROUPS > CHUNK:
        second = _flagmega_amd_q8_load(source, CHUNK, CHUNK, CHUNK)
    if GROUPS > MAIN_GROUPS:
        tail = _flagmega_amd_q8_load(source, MAIN_GROUPS, TAIL, GROUPS - MAIN_GROUPS)
    _flagmega_amd_q8_store(first, words, scales, 0, CHUNK)
    if MAIN_GROUPS > CHUNK:
        _flagmega_amd_q8_store(second, words, scales, CHUNK, CHUNK)
    if GROUPS > MAIN_GROUPS:
        _flagmega_amd_q8_store(tail, tail_words, tail_scales, 0, TAIL)


@triton.jit
def _flagmega_amd_iq4_xs_q8_step(words, scales, weight, rows, group, local_group, MASK_GROUPS: tl.constexpr,
                                 GROUPS: tl.constexpr):
    """Partial dot of the [2,4,G] (row, row, group) tile at global groups `group`; the activation
    groups are `local_group` of the q8 buffers. Per group: sum of int8 codebook x int8 activation in
    int32, times the integer scale (ls - 32), times d_w * d_x (the NVIDIA q8_1 dp8 accumulation)."""
    q64 = weight.to(tl.pointer_type(tl.uint64))
    w32 = weight.to(tl.pointer_type(tl.uint32))
    block = group // 8
    in_block = group % 8
    q_index = rows // 8 + block * 17 + 1 + in_block * 2
    h_index = rows // 4 + block * 34
    if MASK_GROUPS:
        # A lane past the row's last group reads a zero header (zero scale), so it adds zero.
        active = group < GROUPS
        first = tl.load(q64 + q_index, mask=active, other=0)
        second = tl.load(q64 + q_index + 1, mask=active, other=0)
        h0 = tl.load(w32 + h_index, mask=active, other=0)
        h1 = tl.load(w32 + h_index + 1, mask=active, other=0)
        x_group = tl.where(active, local_group, 0)
    else:
        first = tl.load(q64 + q_index)
        second = tl.load(q64 + q_index + 1)
        h0 = tl.load(w32 + h_index)
        h1 = tl.load(w32 + h_index + 1)
        x_group = local_group
    delta = (h0 & 0xFFFF).to(tl.uint16).to(tl.float16, bitcast=True).to(tl.float32)
    scale_code = ((h1 >> (in_block * 4)) & 0xF) | ((((h0 >> 16) >> (in_block * 2)) & 0x3) << 4)
    x_scale = tl.load(tle.gpu.local_ptr(scales, (x_group, ))).to(tl.float32)
    base = x_group * 8
    dot = tl.zeros(first.shape, tl.int32)
    for WORD in tl.static_range(4):
        if WORD < 2:
            qword = ((first >> (32 * WORD)) & 0xFFFFFFFF).to(tl.uint32)
        else:
            qword = ((second >> (32 * (WORD - 2))) & 0xFFFFFFFF).to(tl.uint32)
        # Low nibbles pair with activation word WORD (values 4W..4W+3), high nibbles with word 4+WORD.
        low = _flagmega_amd_iq4_nl_lookup(qword)
        high = _flagmega_amd_iq4_nl_lookup(qword >> 4)
        x_low = tl.broadcast_to(tl.load(tle.gpu.local_ptr(words, (base + WORD, ))), dot.shape)
        x_high = tl.broadcast_to(tl.load(tle.gpu.local_ptr(words, (base + 4 + WORD, ))), dot.shape)
        dot = _flagmega_amd_dot4(low, x_low, dot)
        dot = _flagmega_amd_dot4(high, x_high, dot)
    return (dot * (scale_code.to(tl.int32) - 32)).to(tl.float32) * (delta * x_scale)


@triton.jit
def _flagmega_amd_iq4_xs_q8_rows8(words, scales, tail_words, tail_scales, weight, rows8, K: tl.constexpr,
                                  MAIN_GROUPS: tl.constexpr):
    GROUPS: tl.constexpr = K // 32
    G: tl.constexpr = 32
    rows = tl.reshape(rows8, (2, 4))[:, :, None]
    lanes = tl.arange(0, G)[None, None, :]
    accumulator = tl.zeros((2, 4, G), tl.float32)
    for group0 in tl.range(0, MAIN_GROUPS, G):
        accumulator += _flagmega_amd_iq4_xs_q8_step(words, scales, weight, rows, group0 + lanes, group0 + lanes,
                                                    MAIN_GROUPS % G != 0, MAIN_GROUPS)
    for group0 in tl.range(MAIN_GROUPS, GROUPS, G):
        accumulator += _flagmega_amd_iq4_xs_q8_step(tail_words, tail_scales, weight, rows, group0 + lanes,
                                                    group0 - MAIN_GROUPS + lanes, GROUPS % G != 0, GROUPS)
    return tl.reshape(tl.sum(accumulator, axis=2), (8, ))


@triton.jit
def _flagmega_amd_iq4_xs_q8_rows(words, scales, tail_words, tail_scales, weight, row_offsets, n_mask,
                                 K: tl.constexpr, MAIN_GROUPS: tl.constexpr, TN: tl.constexpr):
    """q8 IQ4_XS dot of a TN-row tile (TN in {8, 16}); 16 rows run as two 8-row halves and an
    inactive half is skipped, as in _flagmega_amd_native_rows."""
    tl.static_assert(TN == 8 or TN == 16, "AMD native GGUF tiles hold 8 or 16 rows")
    safe = tl.where(n_mask, row_offsets, tl.max(tl.where(n_mask, row_offsets, 0), axis=0))
    if TN == 8:
        result = _flagmega_amd_iq4_xs_q8_rows8(words, scales, tail_words, tail_scales, weight, safe, K, MAIN_GROUPS)
    else:
        first_rows, second_rows = tl.split(tl.permute(tl.reshape(safe, (2, 8)), (1, 0)))
        _, second_active = tl.split(tl.permute(tl.reshape(n_mask.to(tl.int32), (2, 8)), (1, 0)))
        first = _flagmega_amd_iq4_xs_q8_rows8(words, scales, tail_words, tail_scales, weight, first_rows, K,
                                              MAIN_GROUPS)
        second = tl.zeros((8, ), tl.float32)
        if tl.max(second_active, axis=0) > 0:
            second = _flagmega_amd_iq4_xs_q8_rows8(words, scales, tail_words, tail_scales, weight, second_rows, K,
                                                   MAIN_GROUPS)
        result = tl.reshape(tl.permute(tl.join(first, second), (1, 0)), (16, ))
    return result

