@triton.jit
def _flagmega_iq4_xs_dot(source, weight, row_offsets, n_mask, K: tl.constexpr, q8_words, q8_scales, q8_tail_words,
                         q8_tail_scales, Q8_MAIN_GROUPS: tl.constexpr):
    return _flagmega_amd_iq4_xs_q8_rows(q8_words, q8_scales, q8_tail_words, q8_tail_scales, weight, row_offsets,
                                        n_mask, K, Q8_MAIN_GROUPS, {{ glu_dot_rows | default(tn) }})

@triton.jit
def _flagmega_q4_k_dot(source, weight, row_offsets, n_mask, K: tl.constexpr):
    return _flagmega_amd_native_rows(source, weight, row_offsets, n_mask, K, "Q4_K", {{ tn }})

