{#- gfx1201: before the q8 quantize, scalar-prefetch the first weight rows this
    block streams, so DRAM is busy while the activation is quantized. #}
{% set q8_weight_prefetch_kb = q8_weight_prefetch_kb | default(64) %}
{#- Each block also starts its native row-tile loop at tile (shard_index mod tiles),
    so the blocks stream different offsets of their row slabs at any moment. Every
    row is still dotted by one tile in the same order, so results are bitwise. #}
{% set native_gguf_rotate_tiles = true %}
