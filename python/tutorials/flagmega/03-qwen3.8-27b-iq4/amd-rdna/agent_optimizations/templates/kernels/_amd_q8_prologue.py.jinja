{#- Quantize this call's activation once per CTA into LDS (q8_1_rne). LDS
    buffers must have power-of-two extents, so the groups are split into the
    largest power-of-two prefix and a power-of-two tail. #}
{% set q8_groups = call.k // 32 %}
{% set q8 = namespace(main=1, tail=1) %}
{% for _ in range(31) %}
{% if q8.main * 2 <= q8_groups %}
{% set q8.main = q8.main * 2 %}
{% endif %}
{% endfor %}
{% for _ in range(31) %}
{% if q8.tail < q8_groups - q8.main %}
{% set q8.tail = q8.tail * 2 %}
{% endif %}
{% endfor %}
{% if q8_weight_prefetch_kb is defined and q8_weight_prefetch_kb > 0 %}
{% set q8_row_bytes = call.k // 256 * 136 %}
{% set q8_span = call.local_n_capacity * q8_row_bytes %}
{% set q8_chunks = [q8_weight_prefetch_kb // 4, (q8_span + 4095) // 4096] | min %}
{% set q8_queue = native_gguf_tile_queue.get(call.symbol) if native_gguf_tile_queue is defined else none %}
{% if q8_queue %}
    queue_rows = shard_index.to(tl.int64) * {{ q8_queue.rows }} + tl.arange(0, {{ q8_queue.rows }})
    q8_prefetch_row = tl.min({{ q8_queue.weight_row_offset }}, axis=0)
{% else %}
    local_n_offsets = tl.arange(0, {{ native_gguf_tile_rows | default(call.tile_n) }})
    q8_prefetch_row = tl.min({{ call.weight_row_offset }}, axis=0)
{% endif %}
{% for q8_prefetch_weight in ([call.gate_weight, call.up_weight] if call.gate_weight is defined else [call.weight]) %}
    _flagmega_amd_q8_prefetch({{ q8_prefetch_weight }} + q8_prefetch_row, {{ q8_chunks }})
{% endfor %}
{% endif %}
    q8_main_groups: tl.constexpr = {{ q8.main }}
    q8_words = tle.gpu.alloc([{{ q8.main * 8 }}], tl.int32, nv_mma_shared_layout=False)
    q8_scales = tle.gpu.alloc([{{ q8.main }}], tl.float16, nv_mma_shared_layout=False)
    q8_tail_words = tle.gpu.alloc([{{ q8.tail * 8 }}], tl.int32, nv_mma_shared_layout=False)
    q8_tail_scales = tle.gpu.alloc([{{ q8.tail }}], tl.float16, nv_mma_shared_layout=False)
    _flagmega_amd_q8_quantize({{ call.value }}, q8_words, q8_scales, q8_tail_words, q8_tail_scales, {{ call.k }},
                              {{ q8.main if q8.main <= 256 else q8.main // 2 }}, {{ q8.tail }}, q8_main_groups)
    tl.debug_barrier()
