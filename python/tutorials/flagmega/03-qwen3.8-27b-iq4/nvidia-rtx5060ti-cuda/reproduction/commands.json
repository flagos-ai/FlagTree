{
  "schema": "flagmega.public-original-gguf-commands/v1",
  "execution_owner": "Root",
  "environment": {
    "PYTHONPATH": "${PUBLIC_REPO}/python:${PUBLIC_DELIVERY}",
    "PYTHONDONTWRITEBYTECODE": "1",
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "LD_PRELOAD": "${LIBSTDCXX}",
    "PATH": "${PINNED_TOOLCHAIN_PATH}"
  },
  "unset_environment": [
    "U4_PRIVATE_FLAGMEGA_ROOT"
  ],
  "build_environment": {
    "CUDA_VISIBLE_DEVICES": "",
    "FLAGMEGA_GPU_LEASE_GRANTED": "0"
  },
  "execution_environment": {
    "CUDA_VISIBLE_DEVICES": "0",
    "FLAGMEGA_GPU_LEASE_GRANTED": "1"
  },
  "per_build_cache_environment": {
    "XDG_CACHE_HOME": "${REPRO_ROOT}/${BUILD_ID}-xdg",
    "TRITON_CACHE_DIR": "${REPRO_ROOT}/${BUILD_ID}-triton",
    "TMPDIR": "${REPRO_ROOT}/${BUILD_ID}-tmp"
  },
  "storage": "Root creates fresh cache/tmp parents on capacity-approved storage. RDATA cache and artifact must support exact required FICLONE; no payload copy fallback.",
  "builds": [
    {
      "id": "rebuild1",
      "fresh_process": true,
      "argv": [
        "${PYTHON}",
        "${PUBLIC_DELIVERY}/compile.py",
        "--checkpoint",
        "${ORIGINAL_GGUF}",
        "--trial",
        "${REPRO_ROOT}/rebuild1",
        "--rdata-cache-dir",
        "${REPRO_ROOT}/rebuild1-cache",
        "--recipe",
        "${PUBLIC_DELIVERY}/local_optimizations/recipes/u4_l_fullhead48.json",
        "--placement",
        "yx=4x24/bb",
        "--schedule",
        "candidate49"
      ]
    },
    {
      "id": "rebuild2",
      "fresh_process": true,
      "argv": [
        "${PYTHON}",
        "${PUBLIC_DELIVERY}/compile.py",
