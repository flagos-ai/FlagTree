from agent_optimizations.transport import barrier_address as _flagmega_iq4_barrier_address

@triton.jit
def _flagmega_iq4_bulk_expect(bar, size):
    tl.inline_asm_elementwise(
        """{ .reg .pred leader; .reg .u32 lane; .reg .b64 state;
        mov.u32 lane, %laneid; setp.eq.u32 leader, lane, 0;
        @leader mbarrier.arrive.expect_tx.shared::cta.b64 state, [$1], $2;
        mov.u32 $0, 0; }""", '=r,r,r',
        [bar.to(tl.uint64).to(tl.uint32), size], tl.int32, is_pure=False, pack=1)


@triton.jit
def _flagmega_iq4_bulk_transfer(source, destination, bar, size):
    tl.inline_asm_elementwise(
        """{ .reg .pred leader; .reg .u32 lane;
        mov.u32 lane, %laneid; setp.eq.u32 leader, lane, 0;
        @leader cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes [$2], [$1], $4, [$3];
        mov.u32 $0, 0; }""", '=r,l,r,r,r',
        [source.to(tl.uint64), destination.to(tl.uint64).to(tl.uint32),
         bar.to(tl.uint64).to(tl.uint32), size], tl.int32, is_pure=False, pack=1)


@triton.jit
def _flagmega_iq4_fragment2(main, tail, index, mask, ROWS: tl.constexpr, WORDS: tl.constexpr):
    p0 = tle.gpu.local_ptr(main, (index,), [ROWS, WORDS])
    p1 = tle.gpu.local_ptr(tail, (index - 2048,), [ROWS, WORDS])
    return tl.load(tl.where(index < 2048, p0, p1), mask=mask, other=0)


@triton.jit
def _flagmega_iq4_fragment3(main, tail, tail2, index, mask, ROWS: tl.constexpr, WORDS: tl.constexpr):
    p0 = tle.gpu.local_ptr(main, (index,), [ROWS, WORDS])
    p1 = tle.gpu.local_ptr(tail, (index - 4096,), [ROWS, WORDS])
    p2 = tle.gpu.local_ptr(tail2, (index - 4608,), [ROWS, WORDS])
    return tl.load(tl.where(index < 4096, p0, tl.where(index < 4608, p1, p2)), mask=mask, other=0)


@triton.jit
def _flagmega_iq4_fragment4(main, tail, tail2, tail3, index, mask, ROWS: tl.constexpr, WORDS: tl.constexpr):
    p0 = tle.gpu.local_ptr(main, (index,), [ROWS, WORDS])
    p1 = tle.gpu.local_ptr(tail, (index - 2048,), [ROWS, WORDS])
    p2 = tle.gpu.local_ptr(tail2, (index - 2560,), [ROWS, WORDS])
    p3 = tle.gpu.local_ptr(tail3, (index - 2688,), [ROWS, WORDS])
    return tl.load(tl.where(index < 2048, p0, tl.where(index < 2560, p1, tl.where(index < 2688, p2, p3))), mask=mask, other=0)


