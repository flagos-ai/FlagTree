{% if gdn_uniform_norm | default(false) and call.uniform_projection_rows | default(false) %}
            uniform_value_head=value_heads,
            cached_key=cached_key, cached_query=cached_query,
{% endif %}
        )
{{ entry.stage_barrier() }}
{% if cache_vectors %}
    cached_norm_head = tl.full((), -1, tl.int64)
    cached_inverse = tl.zeros((), tl.float32)
{% endif %}
    for recurrent_norm_start in tl.range(
        0, {{ call.local_capacity }}, {{ call.value_tile }}
    ):
        local_values = recurrent_norm_start + tl.arange(0, {{ call.value_tile }})
        recurrent_norm_mask = (
            (local_values < ({{ call.active_values }}))
            & ({{ call.writer_active }})
        )
        global_values = {{ call.global_value }}
{% if cache_vectors %}
        norm_head = (({{ call.global_projection_value | replace('recurrent_start', 'recurrent_norm_start') }}) // {{ call.value_dim }}).to(tl.int64)
        norm_active = (recurrent_norm_start < ({{ call.active_values }})) & ({{ call.writer_active }})
        if norm_active & (norm_head != cached_norm_head):
            cached_inverse = _flagmega_gdn_cached_head_inverse({{ call.core_scratch }}, norm_head, norm_active,
                {{ call.value_dim }}, {{ call.epsilon }})
            cached_norm_head = norm_head
{% endif %}
        _flagmega_gdn_recurrent_local_norm_tile(
            {{ call.z }}, {{ call.result }}, {{ call.norm_weight }},
            {{ call.core_scratch }}, {{ call.z_offset }}, {{ call.result_offset }}, global_values,
            recurrent_norm_mask, {{ call.value_dim }}, {{ call.epsilon }},
{% if gdn_uniform_norm | default(false) and call.uniform_projection_rows | default(false) %}
            uniform_value_head=((( {{ call.global_projection_value | replace('recurrent_start', 'recurrent_norm_start') }} )) // {{ call.value_dim }}).to(tl.int64),
            cached_inverse=cached_inverse,
{% endif %}
        )


{% endif %}
