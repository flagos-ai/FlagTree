{% if call.uniform_projection_rows | default(false) %}
    # A unit-step, tile-aligned shard map proves that every active value in
    # this tile has the same head. The active prefix starts at recurrent_start.
    cached_heads = tl.full((), -1, tl.int64)
    beta = tl.zeros((), tl.float32)
    decay = tl.zeros((), tl.float32)
{% if cache_vectors %}
    head_parent: tl.constexpr = tle.gpu.BlockEncoding([1, 4], [1, 32], [{{ iq4_warps }} , 1], [1, 0])
