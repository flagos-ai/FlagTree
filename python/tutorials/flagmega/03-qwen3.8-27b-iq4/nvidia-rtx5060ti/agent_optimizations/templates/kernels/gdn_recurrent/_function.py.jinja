        recurrent_mask = (
            (local_values < ({{ call.active_values }}))
            & ({{ call.writer_active }})
        )
        global_values = {{ call.global_value }}
{% if call.uniform_projection_rows | default(false) %}
        value_heads = (({{ call.global_projection_value }}) // {{ call.value_dim }}).to(tl.int64)
        projection_active = (recurrent_start < ({{ call.active_values }})) & ({{ call.writer_active }})
        if projection_active & (value_heads != cached_heads):
{% else %}
        value_heads = (global_values // {{ call.value_dim }}).to(tl.int64)
        if tl.sum((recurrent_mask & (value_heads != cached_heads)).to(tl.int32), 0) > 0:
{% endif %}
{% if cache_vectors %}
            cached_key, cached_query = _flagmega_gdn_cached_head_vectors({{ call.qkv }}, value_heads, projection_active,
                {{ call.key_heads }}, {{ call.key_dim }}, {{ call.repeats }}, {{ call.tiled_value_heads | default(false) }},
                {{ call.qk_norm_add }}, {{ call.qk_norm_epsilon }}, {{ call.round_normalized_qk }})
{% endif %}
{% if cache_pairs %}
            head_delta = value_heads - base_cached_head
{% if proven_pairs %}
            beta = tl.sum(tl.where(tl.arange(0, 2) == head_delta, pair_beta, 0.), 0)
            decay = tl.sum(tl.where(tl.arange(0, 2) == head_delta, pair_decay, 0.), 0)
{% else %}
            if (head_delta >= 0) & (head_delta < 2):
                beta = tl.sum(tl.where(tl.arange(0, 2) == head_delta, pair_beta, 0.), 0)
                decay = tl.sum(tl.where(tl.arange(0, 2) == head_delta, pair_decay, 0.), 0)
            else:
{% endif %}
{% endif %}
{% if not proven_pairs %}
{{ '    ' if cache_pairs else '' }}            beta_projection = _flagmega_dense_rows(
{{ '    ' if cache_pairs else '' }}                {{ call.projection_input }}, {{ call.b_weight }}, value_heads, {% if call.uniform_projection_rows | default(false) %}projection_active{% else %}recurrent_mask{% endif %},
{{ '    ' if cache_pairs else '' }}                {{ call.projection_dim }}, {{ call.projection_tile }},
{{ '    ' if cache_pairs else '' }}                False, "{{ call.b_weight_encoding | default('') }}",
{{ '    ' if cache_pairs else '' }}            )
{{ '    ' if cache_pairs else '' }}            a_projection = _flagmega_dense_rows(
{{ '    ' if cache_pairs else '' }}                {{ call.projection_input }}, {{ call.a_weight }}, value_heads, {% if call.uniform_projection_rows | default(false) %}projection_active{% else %}recurrent_mask{% endif %},
{{ '    ' if cache_pairs else '' }}                {{ call.projection_dim }}, {{ call.projection_tile }},
{{ '    ' if cache_pairs else '' }}                False, "{{ call.a_weight_encoding | default('') }}",
{{ '    ' if cache_pairs else '' }}            )
{{ '    ' if cache_pairs else '' }}            beta, decay = _flagmega_gdn_head_gates(
{{ '    ' if cache_pairs else '' }}                beta_projection, a_projection, value_heads, {% if call.uniform_projection_rows | default(false) %}projection_active{% else %}recurrent_mask{% endif %},
{{ '    ' if cache_pairs else '' }}                {{ call.a_log }}, {{ call.dt_bias }}, {{ call.round_beta }},
{{ '    ' if cache_pairs else '' }}            )
{% endif %}
            cached_heads = tl.where({% if call.uniform_projection_rows | default(false) %}projection_active{% else %}recurrent_mask{% endif %}, value_heads, -1)
        _flagmega_gdn_recurrent_local_core_tile(
            {{ call.qkv }}, beta, decay, {{ call.state }},
            {{ call.core_scratch }}, local_values, global_values,
            recurrent_mask, {{ call.value_heads }}, {{ call.key_heads }},
            {{ call.key_dim }}, {{ call.value_dim }},
            {{ call.repeats }}, {{ call.head_block }},
            {{ call.qk_norm_add }}, {{ call.qk_norm_epsilon }},
            {{ call.round_normalized_qk }}, {{ call.round_core }},
