    pair_heads = base_cached_head + tl.arange(0, 2)
    pair_active = (pair_heads < {{ call.value_heads }}) & (({{ call.active_values }}) > 0) & ({{ call.writer_active }})
    pair_b, pair_a = _flagmega_gdn_iq4_head_pairs({{ call.projection_input }}, {{ call.b_weight }}, {{ call.a_weight }},
