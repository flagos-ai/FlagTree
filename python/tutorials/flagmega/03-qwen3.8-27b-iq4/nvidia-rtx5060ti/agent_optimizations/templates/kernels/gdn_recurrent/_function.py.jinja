    cached_query = tle.gpu.set_layout(tl.zeros(({{ call.key_dim }},), tl.{{ 'bfloat16' if call.round_normalized_qk else 'float32' }}), head_layout)
{% endif %}
{% else %}
    # Unproved maps retain the complete lane-wise key. An inactive lane must
