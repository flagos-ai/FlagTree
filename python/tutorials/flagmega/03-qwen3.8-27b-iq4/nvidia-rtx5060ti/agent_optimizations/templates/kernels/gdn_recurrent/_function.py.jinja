    cached_heads = tl.full(({{ call.value_tile }},), -1, tl.int64)
    beta = tl.zeros(({{ call.value_tile }},), tl.float32)
    decay = tl.zeros(({{ call.value_tile }},), tl.float32)
{% endif %}
    for recurrent_start in tl.range(
        0, {{ call.local_capacity }}, {{ call.value_tile }}
    ):
