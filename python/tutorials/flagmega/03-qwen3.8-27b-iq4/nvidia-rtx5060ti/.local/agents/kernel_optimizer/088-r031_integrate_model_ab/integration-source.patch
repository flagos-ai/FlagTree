+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: MIT
+"""H004 standalone policy. No model request or default selection is enabled."""
+from copy import deepcopy
+from math import prod
+
+from triton.flagmega.errors import IRSchemaError
+from triton.flagmega.ir.execution_mesh import ExecutionMesh
+from .r004_gdn_phase_bindings import reference_phase_plan, _same_contract, reference_writer_census
+
+MODULE = 'r017_T_full_p5_split4lut'
+IMPLEMENTATION = 'tir.gdn_recurrent.r017_split4lut'
+PLAN_BODY_SHA256 = '22e4b0546539150a21f61215ee5a01df8e1df5f63f6110d2d0d9182da9a93148'
+POOL_BYTES = 56832
+
+
+def column_phase_plan():
+    plan = reference_phase_plan()
+    plan.update(schema="r017.gdn.split-ordered/v1", module=MODULE, implementation=IMPLEMENTATION,
+                plan_body_sha256=PLAN_BODY_SHA256, norm_primitive="r004.norm128.comparator-faithful/v6")
+    plan['roots'] = plan['roots'][:12]
+    plan['root_dynamic_indices'] = list(range(6))
+    plan['roots'][11].update(shape=[POOL_BYTES], nbytes=POOL_BYTES)
+    # Five typed global fields; reused only after complete Y publication.
+    views = []
+    for name, offset, shape, writer, reader in (
+        ('qn', 0, [16,128], 'prep', 'core'), ('kn', 8192, [16,128], 'prep', 'core'),
+        ('beta', 16384, [48], 'prep', 'core'), ('decay_log', 16640, [48], 'prep', 'core'),
+        ('core', 16896, [48,128], 'core', 'y'),
+    ):
+        views.append(dict(name=name, dtype='float32', shape=shape, byte_offset=offset,
+                          nbytes=prod(shape)*4, writer=writer, last_reader=reader))
+    root = lambda i: dict(kind='argument', source=i)
+    scalar = lambda i: dict(kind='scalar_argument', source=i, add=0)
+    view = lambda off: dict(kind='pointer', source=11, dtype='float32', byte_offset=off)
+    table = (
+        ('prep', [48,1,1], 4, [root(0),root(2),root(6),root(7),root(8),root(9),
+                              view(0),view(8192),view(16384),view(16640)], [0,1]),
+        ('core', [48,1,8], 4, [view(0),view(8192),root(0),view(16384),view(16640),
+                              root(3),scalar(4),view(16896)], [2,5,6]),
+        ('y', [48,1,1], 4, [view(16896),root(1),root(10),root(5)], [1,3]),
+    )
+    entries = []
+    for phase, grid, warps, bindings, dynamic in table:
+        shape, axes = ((grid, ['head','batch','column_tile']) if phase=='core' else
+                       (grid, ['batch','vector_tile','row']) if phase=='gather' else
+                       ([grid[0]], ['head' if phase in ('prep','y') else 'element_tile']))
+        entries.append(dict(phase=phase, symbol='r017_T_'+phase+'_split4lut', grid=grid, num_warps=warps,
+                            maxnreg=80, enable_static_shared=phase=='prep',
+                            requires_grid_wide_sync=False, program_kind='ordinary', tasks_per_owner=1,
+                            depends_on=[entries[-1]['symbol']] if entries else [],
+                            argument_bindings=bindings, dynamic_argument_indices=dynamic,
+                            condition=None,
+                            execution_mesh=ExecutionMesh.fixed(shape,axes=axes,mapping='x-fast').to_data()))
+    partial=dict(name='partials',dtype='float32',shape=[2,48,40],byte_offset=41472,
+                 nbytes=15360,writer='partials',last_reader='prep')
+    views.append(partial)
+    first=dict(phase='partials',symbol='r017_T_partials_split4lut',grid=[48,2,10],num_warps=4,
+               maxnreg=80,enable_static_shared=True,requires_grid_wide_sync=False,
+               program_kind='ordinary',tasks_per_owner=1,depends_on=[],condition=None,
+               argument_bindings=[root(2),root(6),root(7),view(41472)],dynamic_argument_indices=[0],
+               execution_mesh=ExecutionMesh.fixed([48,2,10],axes=['head','bank','k_tile'],mapping='x-fast').to_data())
+    entries[0]['argument_bindings'].append(view(41472))
+    entries[0]['depends_on']=[first['symbol']]
+    entries.insert(0,first)
+    plan.update(pool=dict(root=11,nbytes=POOL_BYTES,scope='chip',pool_scope_stride_bytes=0,views=views),
+                entries=entries,
+                variants={'T_COMPLETE': dict(entry_indices=[0,1,2,3],input_boundary='ready_inputs',
+                                            output_boundary='r004_T_y_v6.complete')},
+                scenario_weights={name:dict(positions=steps,layers=48,executed_launches=48*4*steps)
+                    for name,steps in [('synthetic32',32),('chinese64',64)]})
+    import hashlib,json
+    plan['plan_body_sha256']=hashlib.sha256(json.dumps(
+        {k:v for k,v in plan.items() if k!='plan_body_sha256'},
+        sort_keys=True,separators=(',',':')).encode()).hexdigest()
+    return plan
+
+
+def validate_plan(plan):
+    expected = column_phase_plan()
+    if not _same_contract(plan, expected):
+        raise IRSchemaError('H004 phase plan differs from its complete standalone recipe.')
+    return deepcopy(expected)
+
+
+def column_writer_proof(phase):
+    sizes = {**reference_writer_census(),'projection_partials':3840}
+    writes = {'partials':['projection_partials'], 'prep':['qn','kn','beta','decay_log'], 'core':['state','core'], 'y':['y']}
+    if phase not in writes:
+        raise IRSchemaError('Unknown H004 phase writer.')
+    return dict(schema=column_phase_plan()['schema'],phase=phase,
+                scalar_writes={k:sizes[k] for k in writes[phase]},exact_once=True,
+                owner_mapping='x-fast',internal_grid_barriers=0,
+                norm_owner='4*lane+j; four readonly warp replicas' if phase in ('prep','y') else None,
+                norm_store_election='warp==0' if phase in ('prep','y') else None)
+
+
+def column_tensor_effects(phase):
+    plan = column_phase_plan()
+    entry = next(e for e in plan['entries'] if e['phase']==phase)
+    views = {v['byte_offset']:v for v in plan['pool']['views']}
+    accesses = []
+    for b in entry['argument_bindings']:
+        if b['kind']=='scalar_argument':
+            continue
+        if b['source']==3:
+            accesses.append(dict(source=3,mode='read_write' if phase=='core' else 'read',scope='chip',
+                                 shape=[48,128,128],nbytes=3145728,layer_source=4,
+                                 layer_stride_bytes=3145728,layer_bounds=[0,48]))
+        elif b['kind']=='pointer':
+            v = views[b['byte_offset']]
+            accesses.append(dict(source=11,mode='write' if v['writer']==phase else 'read',scope='chip',view=v))
+        else:
+            r = plan['roots'][b['source']]
+            accesses.append(dict(source=b['source'],mode='write' if b['source']==5 else 'read',
+                                 scope='chip',shape=r['shape'],nbytes=r['nbytes']))
+    return dict(phase=phase,accesses=accesses,depends_on=entry['depends_on'],condition=entry['condition'],
+                completion='all_ctas_on_same_stream',completion_cta_count=prod(entry['grid']),
+                state_effect='initial_clear' if phase=='clear' else 'fused_commit' if phase=='core' else None,
+                publishes_region_ready=phase=='y')
--- a/python/triton/flagmega/rules/ntt/r031_model_policy.py
+++ b/python/triton/flagmega/rules/ntt/r031_model_policy.py
@@ -0,0 +1,207 @@
+# Copyright 2026 FlagOS Contributors
+# SPDX-License-Identifier: MIT
+"""Explicit corrected T-v6 post-packing H004 model policy; native model packaging is a separate gate.
+
+The coarse effect uses one device-global value domain. Its three native
+program meshes, typed scratch fields and completion edges come exclusively
+from the qualified column plan. This policy does not turn the coarse call
+into a single 384-CTA kernel or reuse the standalone constructor ABI.
+"""
+from collections.abc import Mapping
+from copy import copy
+from dataclasses import replace
+
+from triton.flagmega.errors import IRVerificationError
+from triton.flagmega.ir.distributed_inference import broadcast_ir_type
+from triton.flagmega.ir.execution_mesh import ExecutionMesh
+from triton.flagmega.passes.auto_distributed.candidates import (
+    DistributedCandidate, DistributedCandidateProviderBase,
+    DistributedCandidateProviderRegistry,
+)
+from .r017_split4lut_bindings import (
+    MODULE, IMPLEMENTATION, PLAN_BODY_SHA256, column_phase_plan,
+)
+from .r004_gdn_phase_bindings import (
+    _same_contract, standalone_request, validate_coarse_node, validate_phase_plan,
+)
+
+REQUEST_KEY = "r004_model_policy"
+SUBJECT_SHA256 = "b7ee29ef5c4f5bc308e2f36ee73fd7c466da90598307769c4421bbcf70b17d58"
+PLAN_BODY_SHA256 = column_phase_plan()["plan_body_sha256"]
+OP = "nn.gdn_recurrent_core"
+
+
+def model_request(module):
+    request = module.metadata.get(REQUEST_KEY)
+    if request is None:
+        return None
+    expected = dict(schema="flagmega.r031-model-policy/v1", candidate=MODULE,
+                    plan_body_sha256=PLAN_BODY_SHA256,
+                    numerical_subject_sha256=SUBJECT_SHA256)
+    if not isinstance(request, Mapping) or not _same_contract(request, expected):
+        raise IRVerificationError("Invalid H004 model policy identity.", stage=module.stage)
+    if standalone_request(module) is not None:
+        raise IRVerificationError("Model and standalone GDN requests are mutually exclusive.")
+    return request
+
+
+def prepare_model_column_distribution(module):
+    """Explicit opt-in at complete packing; verify again on every fresh resume."""
+    if module.stage not in ("unused_functions_removed", "distribution_constants_frozen"):
+        raise IRVerificationError("H004 model integration must resume before distribution.",
+                                  stage=module.stage)
+    if standalone_request(module) is not None:
+        raise IRVerificationError("A standalone GDN module cannot become a model candidate.")
+    request = dict(schema="flagmega.r031-model-policy/v1", candidate=MODULE,
+                   plan_body_sha256=PLAN_BODY_SHA256,
+                   numerical_subject_sha256=SUBJECT_SHA256)
+    if model_request(module) is None:
+        module = replace(module, metadata={**module.metadata, REQUEST_KEY: request})
+    return configure_model_phases(module)
+
+
+def configure_model_phases(module):
+    """Keep the original inputs, tuple, effects and all neighboring nodes."""
+    if model_request(module) is None:
+        return module
+    if module.stage not in ("unused_functions_removed", "distribution_constants_frozen",
+                            "distribution_candidates"):
+        raise IRVerificationError("H004 phase ownership is before AutoDistributedPass.",
+                                  stage=module.stage)
+    if any(s.point_id.startswith(("distribution.", "tir.")) for s in module.selections):
+        raise IRVerificationError("H004 model policy cannot reuse downstream selections.")
+    if (module.metadata.get("num_hidden_layers") != 64
+            or tuple(module.metadata.get("imported_layer_indices", ())) != tuple(range(64))):
+        raise IRVerificationError("H004 model policy requires all 64 text layers.")
+    from triton.flagmega.passes.functions.graph import static_node_invocation_counts
+    counts = static_node_invocation_counts(module)
+    coarse = [n for n in module.nodes if n.op == OP and n.id in counts]
+    if sum(counts[n.id] for n in coarse) != 48:
+        raise IRVerificationError("H004 model policy requires exactly 48 recurrent invocations.")
+    plan = column_phase_plan()
+    # Dynamic describes the coarse value domain, not a launch grid. Native
+    # PREP/CORE/Y retain their own fixed meshes from phase_plan.
+    mesh = ExecutionMesh.dynamic().to_data()
+    changed = {}
+    for node in coarse:
+        validate_coarse_node(module, node)
+        if node.attrs.get("phase_plan") is not None:
+            if not _same_contract(validate_phase_plan(node.attrs["phase_plan"]), plan):
+                raise IRVerificationError("Mixed H004 model phase plans.", node_id=node.id)
+        changed[node.id] = replace(node, attrs={**node.attrs, "phase_plan": plan},
+                                  metadata={**node.metadata, "execution_mesh": mesh,
+                                            "kernel_program_kind": "ordinary"})
+    return replace(module, nodes=tuple(changed.get(n.id, n) for n in module.nodes))
+
+
+class ColumnEffectProvider(DistributedCandidateProviderBase):
+    """One coarse effect; full tensors reach the phase-owned scalar writers."""
+    op_names = frozenset({OP})
+    allows_partial_inputs = False
+    is_exhaustive = True
+
+    def _enumerate_candidates(self, context):
+        node = context.source_call
+        if model_request(context.module) is None:
+            raise IRVerificationError("Column GDN provider requires its model policy.")
+        validate_coarse_node(context.module, node)
+        validate_phase_plan(node.attrs.get("phase_plan"))
+        if context.placement.physical_level_size("b") != 1:
+            raise IRVerificationError("GDN coarse effect must use the device-global value domain.",
+                                      node_id=node.id)
+        return (DistributedCandidate(
+            "r004-column-complete-effect",
+            broadcast_ir_type(node.type, context.placement),
