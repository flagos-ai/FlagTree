# Prebuilt SDNN objects and archives (installed from xpu-sdnn-objects tarball)
*.o
# tle.raw e2e payload checked in next to the test (FlagGems #6767 object= path)
!/test/tle_raw/reflection_pad1d/
!/test/tle_raw/reflection_pad1d/reflection_pad1d.o
libTritonSharedForXPU.a
/libTritonXPUAnalysisSDNN.a
/lib/Analysis/SDNN/libTritonXPUAnalysisSDNN.a
/lib/Analysis/NewAnalysis/SDNN/libTritonXPUAnalysisSDNN.a

# Prebuilt device objects installed under device/xpu3/ (device/ files are tracked)
/device/xpu3/

# Install marker written by install_sdnn_objects
/version.txt

# Download cache from BOS (xpu-sdnn-objects_*.tar.gz)
xpu-sdnn-objects

# Compiled Python implementation (installed from xpu-python-impl-so tarball).
# These are build artifacts: the `.py` they replace are absent from the tree on
# purpose, so this download is the only source for them.
*.abi3.so
xpu-python-impl-so
