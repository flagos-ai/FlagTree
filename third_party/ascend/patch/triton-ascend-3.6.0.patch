+        self.message = f"\n" \
+            f"{self.format_line_delim('[ERROR][Triton][BEG]')}" \
+            f"[{self.stage_name}] encounters error:\n" \
+            f"{self.filter_message(message)}" \
+            f"{self.format_line_delim('[ERROR][Triton][END]')}"
+
+    def __str__(self):
+        return self.message
+
+    def filter_message(self, message):
