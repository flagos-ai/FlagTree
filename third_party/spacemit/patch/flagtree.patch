index 000000000..1cbc3c18f
--- /dev/null
+++ b/python/setup_tools/utils/spacemit.py
@@ -0,0 +1,170 @@
+"""Spacemit backend module for FlagTree.
+
+Provides build hooks for:
+- get_backend_cmake_args: inject LLVM_DIR/MLIR_DIR/LLD_DIR into cmake
+- post_install: create build-tree symlinks for .inc file resolution
+- get_package_data: list source files (driver.c, include/) for package_data
+- overlay_runtime_so: re-scan backend dir at build_py time (after build_ext)
+  to pick up build artifacts (bin/spine-triton-opt, lib/*.so) that didn't
+  exist when get_package_data ran at setup() time.
+- install_extension: copy spine-triton-opt from cmake build dir to backend/bin/
+"""
+
+import os
+
+
+def _get_backend_root() -> str:
+    """Return the backend's third_party submodule path."""
+    from pathlib import Path
+    return str(Path(__file__).resolve().parents[3] / "third_party" / "spacemit")
+
+
+def _collect_spacemit_package_data(backend):
+    """Collect non-Python files the backend needs at runtime.
+
+    The package dir (python/triton/backends/spacemit) is a symlink to
+    third_party/spacemit/backend. include_package_data=True doesn't follow
+    symlinks consistently across setuptools versions / fresh CI checkouts,
+    so driver.c, spine-triton-opt, .so libs etc. went missing from the CI
+    wheel even though the local wheel had them. Scan the backend dir and
+    list every non-.py file explicitly in package_data.
+
+    Called twice: once at setup() time (only source files exist) and once
+    at build_py time via overlay_runtime_so (after install_extension has
+    copied spine-triton-opt into backend/bin/).
+    """
+    from pathlib import Path
+    backend_dir = Path(backend.backend_dir)
+    files = []
+    if not backend_dir.is_dir():
+        return files
+    for p in backend_dir.rglob("*"):
+        if not p.is_file():
+            continue
+        if p.suffix in (".py", ".pyc", ".pyo"):
+            continue
+        files.append(str(p.relative_to(backend_dir)))
+    return files
+
+
+def get_package_data(backends):
+    package_data = {}
+    for backend in backends:
+        if backend.name == "spacemit":
+            files = _collect_spacemit_package_data(backend)
+            if files:
+                package_data["triton.backends.spacemit"] = files
+            break
+    return package_data
+
+
+def overlay_runtime_so(cache, build_py_command=None, backends=None):
+    """Re-scan backend dir at build_py time and refresh package_data.
+
+    setup() -> get_package_data() runs BEFORE build_ext, so it can't see
+    bin/spine-triton-opt (created during build_ext by install_extension).
+    CMakeBuildPy.run() calls this hook AFTER build_ext, so we re-scan and
+    update distribution.package_data with the now-present build artifacts.
+    Mirrors the xpu backend's overlay_runtime_so pattern.
+    """
+    if build_py_command is None or backends is None:
+        return
+    build_py_command.distribution.package_data = build_py_command.distribution.package_data or {}
+    for backend in backends:
+        if backend.name == "spacemit":
+            files = _collect_spacemit_package_data(backend)
+            if files:
+                build_py_command.distribution.package_data["triton.backends.spacemit"] = files
+            build_py_command.package_data = build_py_command.distribution.package_data
+            build_py_command.__dict__.pop("data_files", None)
+            break
+
+
+def get_backend_cmake_args(*args, **kargs):
+    """Inject LLVM/MLIR/LLD cmake args, and create build-tree symlinks."""
+    cmake_args = []
+
+    llvm_syspath = os.environ.get("LLVM_SYSPATH")
+    if llvm_syspath:
+        cmake_args += [
+            f"-DLLVM_DIR={llvm_syspath}/lib/cmake/llvm",
+            f"-DMLIR_DIR={llvm_syspath}/lib/cmake/mlir",
+            f"-DLLD_DIR={llvm_syspath}/lib/cmake/lld",
+            f"-DLLVM_LIBRARY_DIR={llvm_syspath}/lib",
+        ]
+
+    # Force-disable Proton for spacemit (CpuProfiler.cpp missing)
+    cmake_args.append("-DTRITON_BUILD_PROTON=OFF")
+
+    # Create build-tree symlink spine_triton -> spacemit for .inc file resolution.
+    # The .inc files are generated under build/third_party/spacemit/include/,
+    # but the include path uses build/third_party/spine_triton/include/.
+    build_ext = kargs.get("build_ext", None)
+    if build_ext and hasattr(build_ext, "build_temp") and build_ext.build_temp:
+        build_third_party = os.path.join(build_ext.build_temp, "third_party")
+        if os.path.isdir(build_third_party):
+            spine_triton_link = os.path.join(build_third_party, "spine_triton")
+            if not os.path.exists(spine_triton_link):
+                try:
+                    os.symlink("spacemit", spine_triton_link)
+                    print(f"[spacemit] Created build-tree symlink: {spine_triton_link} -> spacemit")
+                except (OSError, PermissionError) as e:
+                    print(f"[spacemit] Warning: could not create build-tree symlink: {e}")
+
+    return cmake_args
+
+
+def precompile_hook(*args, **kargs):
+    """Pre-build setup hook (called by download_flagtree_third_party)."""
+    return None
+
+
+def post_install():
+    """Post-install: create build-tree symlink for .inc files."""
+    build_ext = None
+    try:
+        # Try to find the cmake build directory
+        from pathlib import Path
+        backend_root = _get_backend_root()
+        build_dirs = list(Path(backend_root, "triton", "build").glob("cmake.*"))
+        for build_dir in build_dirs:
+            build_third_party = build_dir / "third_party"
+            if build_third_party.is_dir():
+                spine_triton_link = build_third_party / "spine_triton"
+                if not spine_triton_link.exists():
+                    spine_triton_link.symlink_to("spacemit")
+                    print(f"[spacemit] Created build-tree symlink: {spine_triton_link} -> spacemit")
+    except Exception:
+        pass
+
+
+def install_extension(*args, **kargs):
+    """Copy spine-triton-opt from build directory to backend/bin/."""
+    import shutil
+    import sys
+    from pathlib import Path
+
+    _python_dir = Path(__file__).resolve().parents[2]
+    if str(_python_dir) not in sys.path:
+        sys.path.insert(0, str(_python_dir))
+    from build_helpers import get_cmake_dir
+
+    # spine-triton-opt is built by cmake at:
+    # build/cmake.*/third_party/spacemit/tools/spine-triton-opt/spine-triton-opt
+    # (build_ext.build_temp is distutils' build/temp.*, NOT the cmake dir).
+    build_temp = Path(get_cmake_dir())
+    spine_triton_opt_src = build_temp / "third_party" / "spacemit" / "tools" / "spine-triton-opt" / "spine-triton-opt"
+
+    if not spine_triton_opt_src.exists():
+        print(f"[spacemit] Warning: spine-triton-opt not found at {spine_triton_opt_src}")
+        return
+
+    # Copy to backend/bin/ (which gets packaged into the wheel)
+    backend_root = Path(_get_backend_root())
+    backend_bin = backend_root / "backend" / "bin"
+    backend_bin.mkdir(parents=True, exist_ok=True)
+
+    spine_triton_opt_dst = backend_bin / "spine-triton-opt"
+    shutil.copy(spine_triton_opt_src, spine_triton_opt_dst)
+    spine_triton_opt_dst.chmod(0o755)
+    print(f"[spacemit] Copied spine-triton-opt to {spine_triton_opt_dst}")
