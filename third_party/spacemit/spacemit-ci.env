# Prebuilt packages for spacemit-ci (host: x86_64, target: riscv64).
# All packages are downloaded from the zuoweixia497/spacemit-ci-assets
# GitHub release (public, no auth needed for download). MD5 keys drive the
# actions/cache@v4 keys, so a bump here automatically invalidates the cache.
#
# Update flow: bump URL+MD5 here, commit, push. The workflow downloads the
# new package on the next run (cache miss).
#
# NOTE: no quotes around values — GITHUB_ENV takes values literally and
# quotes would be passed through to curl/tar verbatim.

# FlagTree x86-64 LLVM (f6ded0be == LLVM22). Used to build the FlagTree
# Python extension on the host.
LLVM_URL=https://github.com/zuoweixia497/spacemit-ci-assets/releases/download/v0.1/llvm-f6ded0be-x86-release.tar.gz
LLVM_MD5=2e841e4abe1a11b6226eeb76d70c5407

# spine-mlir x86_64 install (libSpeIR*.so, spine-opt, llc, ...). Host toolchain
# used during FlagTree build to lower/cross-compile kernels.
SPINE_MLIR_URL=https://github.com/zuoweixia497/spacemit-ci-assets/releases/download/v0.1/spine-mlir.x86_64.0.8.0.tar.gz
SPINE_MLIR_MD5=a96385476643d641b15f46137cf73674

# spine-runtime riscv64 install (libspert.so + spert headers). The runtime
# that ships inside the wheel and runs on K3.
SPINE_RUNTIME_URL=https://github.com/zuoweixia497/spacemit-ci-assets/releases/download/v0.1/spine-runtime-riscv64-0.6.0.tar.gz
SPINE_RUNTIME_MD5=45293beec7ebae4f799982c17040c649

# RISC-V toolchain (v1.1.2) for cross-compiling kernels to riscv64.
RISCV_TOOLCHAIN_URL=https://github.com/spacemit-com/toolchain/releases/download/v1.1.2/spacemit-toolchain-linux-glibc-x86_64-v1.1.2.tar.xz
RISCV_TOOLCHAIN_MD5=fbfa20f14500bfe77bad1f548a8ba525
