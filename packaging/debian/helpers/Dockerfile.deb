# Dockerfile to build the FlagTree wheel, then assemble a Debian package.
#
# Two-stage:
#   1. wheel-builder: heavy stage with CMake/Ninja/LLVM that compiles the
#      flagtree wheel from source. Produces dist/flagtree-*.whl.
#   2. deb-assembler: light stage that runs dpkg-buildpackage to wrap the
#      pre-built wheel into a .deb. The deb stage does NOT recompile.
#
# Build:
#   docker build -f packaging/debian/helpers/Dockerfile.deb \
#     --build-arg FLAGTREE_BACKEND=nvidia \
#     --target deb-output \
#     -t flagtree-deb-nvidia .
#   docker create --name x flagtree-deb-nvidia
#   docker cp x:/output ./output && docker rm x

ARG FLAGTREE_BACKEND=nvidia

# ---------- Stage 1: build the wheel ----------
FROM ubuntu:22.04 AS wheel-builder

ARG FLAGTREE_BACKEND
ENV DEBIAN_FRONTEND=noninteractive
ENV FLAGTREE_BACKEND=${FLAGTREE_BACKEND}

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        build-essential cmake ninja-build git \
        zlib1g zlib1g-dev libxml2 libxml2-dev \
        wget curl ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel build

WORKDIR /src
COPY . /src

RUN pip3 install --no-cache-dir -r python/requirements.txt

# Build wheel with MAX_JOBS capped to reduce peak RAM. The full nvidia build
# takes ~36 min wall on a 4-core builder.
WORKDIR /src/python
RUN MAX_JOBS=4 python3 -m pip wheel . --no-build-isolation --no-deps -w /wheels -v 2>&1 | tail -200 \
    && ls -lh /wheels/

# ---------- Stage 2: assemble the .deb ----------
FROM ubuntu:22.04 AS deb-assembler

ARG FLAGTREE_BACKEND
ENV DEBIAN_FRONTEND=noninteractive
ENV FLAGTREE_BACKEND=${FLAGTREE_BACKEND}

RUN apt-get update && apt-get install -y --no-install-recommends \
        debhelper dh-python python3-all python3-pip python3-setuptools \
        python3-wheel devscripts fakeroot lintian \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY packaging/debian /build/debian
COPY --from=wheel-builder /wheels /build/dist

# debian/source/format = "3.0 (native)" so dpkg-buildpackage doesn't need
# a separate orig.tar.gz. We point WHEEL_DIR at the staged wheels.
ENV WHEEL_DIR=/build/dist

RUN dpkg-buildpackage -us -uc -b -d 2>&1 | tail -100

# ---------- Stage 3: just the .deb output ----------
FROM scratch AS deb-output
COPY --from=deb-assembler /python3-flagtree-*.deb /output/
COPY --from=deb-assembler /flagtree_*.changes /output/
