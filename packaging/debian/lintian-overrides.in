# Installed as debian/python3-flagtree-<backend>.lintian-overrides by
# build-helpers/render-packaging.sh. The content is backend-independent; only
# the file name has to carry the package name for dh_lintian to pick it up.
#
# libtriton/libproton keep their symbol tables on purpose: Triton's JIT does
# runtime symbol lookups in them. Only the DWARF sections are removed
# (strip --strip-debug in debian/rules); lintian counts a present .symtab as
# "unstripped". Globbed because a backend ships whichever of the two its
# wheel was built with.
unstripped-binary-or-object usr/lib/python3/dist-packages/triton/_C/libtriton*.so
unstripped-binary-or-object usr/lib/python3/dist-packages/triton/_C/libproton*.so
