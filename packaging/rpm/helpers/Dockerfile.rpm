# RPM build: obtain the FlagTree wheel, then assemble the rpm on the same
# RPM-family base image. The wheel's Python ABI tag must match the Python
# interpreter used by rpmbuild/pip in the assembler stage.
#
# Two stages produce /wheels/flagtree-*.whl; which one runs is decided by
# FLAGTREE_WHEEL_STAGE, from the backend's "rpm_wheel" column in
# packaging/backends.conf. BuildKit only builds the stage the assembler
# actually copies from, so an index build never pays for the compile.
#   1a. wheel-builder: heavy stage with CMake/Ninja/LLVM that compiles the
#       wheel from source.
#   1b. wheel-index:   light stage that downloads the wheel the backend's own
#       delivery workflow published, for backends built on vendor hardware
#       this packaging has no access to.
#   2.  rpm-assembler: rpmbuild wraps the wheel into an rpm. It does NOT
#       recompile.
#
# Build (through the helper, which fills the build args from backends.conf):
#   bash packaging/rpm/helpers/build-flagtree-rpm.sh nvidia
#
# COPY-narrowing in wheel-builder mirrors Dockerfile.deb — packaging-only
# edits do NOT invalidate the wheel cache.

ARG RPM_BASE_IMAGE=fedora:43
# Backend to package: selects the package name, the spec's ExclusiveArch and,
# through FLAGTREE_WHEEL_STAGE, where the wheel comes from.
# build-flagtree-rpm.sh fills all of these from packaging/backends.conf.
ARG FLAGTREE_BACKEND=nvidia
ARG FLAGTREE_WHEEL_STAGE=wheel-builder
ARG FLAGTREE_WHEEL_SOURCE=source
ARG FLAGTREE_ARCH=x86_64
# Index to download a published wheel from, and an optional exact local
# version to pin (e.g. ascend3.5); see packaging/build-helpers/fetch-wheel.sh.
ARG FLAGTREE_PYPI_INDEX=
ARG FLAGTREE_WHEEL_LOCAL=

# ---------- Stage 1: build the wheel ----------
FROM ${RPM_BASE_IMAGE} AS wheel-builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PIP_ROOT_USER_ACTION=ignore

RUN dnf install -y --setopt=install_weak_deps=False \
        python3 python3-pip python3-devel python3-setuptools python3-wheel \
        gcc gcc-c++ make cmake ninja-build git \
        clang \
        zlib-devel libxml2-devel \
        wget curl ca-certificates \
    && (dnf install -y --setopt=install_weak_deps=False json-devel \
        || dnf install -y --setopt=install_weak_deps=False nlohmann-json-devel) \
    && dnf clean all

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel build

WORKDIR /src
# Dependency layer first so source edits don't invalidate it.
COPY python/requirements.txt /src/python/requirements.txt
RUN python3 -m pip install --no-cache-dir -r python/requirements.txt

# Narrow COPY: only the paths the wheel build needs, so packaging-only
# edits (specs, debian/, helpers) do NOT invalidate the ~50 min wheel
# layer. setup.py / pyproject.toml / MANIFEST.in live at the repo root
# since the post-#607 restructure.
COPY python /src/python
COPY third_party /src/third_party
COPY include /src/include
COPY lib /src/lib
COPY cmake /src/cmake
COPY bin /src/bin
COPY test /src/test
COPY unittest /src/unittest
COPY CMakeLists.txt pyproject.toml setup.py MANIFEST.in LICENSE README.md /src/

# Keep the tileir backend (GCC >= 13 + cuda-tile
# submodule) out of the distro build.
# The trailing rm keeps only /wheels in this layer: the CMake build
# tree and the LLVM tarball cache (~/.triton) would otherwise add
# several GB and push CI runners into ENOSPC.
# The wheel version: setup.py falls back to a stale hardcoded version when
# FLAGTREE_WHEEL_VERSION is unset, so the build script passes the spec's
# Version here. Declared right before the wheel RUN so that only this layer
# is invalidated when the version bumps.
ARG FLAGTREE_WHEEL_VERSION=
RUN unset FLAGTREE_BACKEND && \
    FLAGTREE_WHEEL_VERSION="${FLAGTREE_WHEEL_VERSION}" \
    JSON_SYSPATH=/usr \
    MAX_JOBS=4 python3 -m pip wheel . --no-build-isolation --no-deps -w /wheels -v && \
    ls -lh /wheels/ && \
    test -n "$(ls /wheels/flagtree-*.whl 2>/dev/null)" && \
    rm -rf /src/build /root/.triton

# ---------- Stage 1b: download a published wheel ----------
# For backends whose wheel is built by their own delivery workflow on vendor
# hardware. Nothing here needs a vendor SDK; the wheel is taken as published
# and its sha256 is checked against the index. fetch-wheel.sh accepts only a
# wheel matching this image's python3 and architecture, which is what makes a
# backend's row valid for this base image at all.
FROM ${RPM_BASE_IMAGE} AS wheel-index
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG FLAGTREE_BACKEND
ARG FLAGTREE_PYPI_INDEX
ARG FLAGTREE_WHEEL_LOCAL

RUN dnf install -y --setopt=install_weak_deps=False \
        python3 curl ca-certificates \
    && dnf clean all

COPY packaging/build-helpers/fetch-wheel.sh /ctx/fetch-wheel.sh

# Declared last so a version bump invalidates only the download. A wheel
# re-published under an unchanged name is not noticed by the layer cache;
# the sha256 the index served is echoed into the build log either way.
ARG FLAGTREE_WHEEL_VERSION=
RUN FLAGTREE_PYPI_INDEX="${FLAGTREE_PYPI_INDEX}" \
    FLAGTREE_WHEEL_LOCAL="${FLAGTREE_WHEEL_LOCAL}" \
    bash /ctx/fetch-wheel.sh \
        "${FLAGTREE_BACKEND}" "${FLAGTREE_WHEEL_VERSION}" /wheels

# ---------- The wheel the assembler uses ----------
# Aliasing the selected stage keeps the choice in one build arg: a FROM reads
# the global ARG in every builder, where a COPY --from does not, and only the
# stage named here gets built.
FROM ${FLAGTREE_WHEEL_STAGE} AS wheel-src

# ---------- Stage 2: assemble the .rpm ----------
FROM ${RPM_BASE_IMAGE} AS rpm-assembler
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PIP_ROOT_USER_ACTION=ignore

RUN dnf install -y --setopt=install_weak_deps=False \
        rpm-build rpmdevtools \
        python3 python3-pip python3-devel python3-setuptools python3-wheel \
    && dnf clean all

RUN rpmdev-setuptree

# openEuler images define %dist as empty (official .oe* tags are
# injected by EulerMaker); reconstruct it so local/CI builds get
# distro-tagged Release fields like official packages.
RUN if [ -z "$(rpm --eval '%{?dist}')" ]; then \
        . /etc/os-release && \
        case "${ID}" in \
            openEuler) echo "%dist .oe$(echo "${VERSION_ID}" | tr -d '.')" >> /root/.rpmmacros ;; \
        esac; \
    fi

COPY packaging/rpm/specs/flagtree.spec /root/rpmbuild/SPECS/
COPY LICENSE /root/rpmbuild/SOURCES/LICENSE
COPY --from=wheel-src /wheels /wheels

# Declared here, after the layers that do not depend on them, so building
# another backend reuses the toolchain layers.
ARG FLAGTREE_BACKEND
ARG FLAGTREE_WHEEL_SOURCE
ARG FLAGTREE_ARCH

# The spec's ExclusiveArch is the backend's architecture, so rpmbuild stops
# here rather than producing a mislabeled rpm on the wrong host.
#
# QA_RPATHS, for a published wheel only: rpm runs check-rpaths over the
# buildroot of every non-noarch package, and a vendor-built wheel carries
# absolute RUNPATHs this packaging cannot fix without patching the vendor's
# binaries -- the vendor's own install prefix (/usr/local/Ascend/..., where the
# runtime the backend loads actually lives) and, in the published ascend wheel,
# a directory from the machine that built it. Both are properties of the wheel.
# 0x0002 is check-rpaths' "invalid RPATH" class, the only one they fall in;
# downgrading it to a warning keeps the paths in the build log instead of
# ending the build, and every other class stays an error. A wheel this
# packaging compiles itself gets the unmodified check.
RUN if [ "${FLAGTREE_WHEEL_SOURCE}" = index ]; then \
        export QA_RPATHS=0x0002; \
    fi && \
    rpmbuild -ba /root/rpmbuild/SPECS/flagtree.spec \
        --define "flagtree_backend ${FLAGTREE_BACKEND}" \
        --define "flagtree_arch ${FLAGTREE_ARCH}" \
        --define "wheel_dir /wheels" && \
    ls -lh "/root/rpmbuild/RPMS/${FLAGTREE_ARCH}/"

# Smoke test: install the freshly built rpm and import the package.
# Catches the "installs fine, fails at import" class (missing libs,
# bad rpath, glibc mismatch) that rpmbuild alone cannot see.
# triton's backend discovery imports the compiler module of every installed
# backend, so a backend whose module reaches for its vendor SDK there cannot be
# imported on a host without that SDK; its row sets smoke=install and only the
# install is asserted (see packaging/backends.conf).
ARG FLAGTREE_SMOKE=import
RUN dnf install -y "/root/rpmbuild/RPMS/${FLAGTREE_ARCH}"/python3-flagtree-*.rpm && \
    if [ "${FLAGTREE_SMOKE}" = install ]; then \
        python3 -c "import importlib.util as u; print('triton installed at', u.find_spec('triton').submodule_search_locations[0])" && \
        echo "smoke=install: importing triton needs prerequisites the ${FLAGTREE_BACKEND} backend brings in"; \
    else \
        python3 -c "import triton; print(getattr(triton, '__version__', 'import ok'))"; \
    fi

# ---------- Stage 3: extract just the rpms ----------
FROM scratch AS rpm-output
COPY --from=rpm-assembler /root/rpmbuild/RPMS/*/python3-flagtree-*.rpm /output/
COPY --from=rpm-assembler /root/rpmbuild/SRPMS/python3-flagtree-*.src.rpm /output/
